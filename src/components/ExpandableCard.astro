---
export interface ExpandableCardItem {
  title: string;
  group?: string;
  shortText?: string;
  expandedText?: string;
  href?: string;
  image?: string;
  imageAlt?: string;
  disabled?: boolean;
  status?: string;
  ctaLabel?: string;
}

interface Props {
  item: ExpandableCardItem;
  index: number;
}

const { item, index } = Astro.props;
const headingId = `expandable-card-${item.title.toLowerCase().replaceAll(/[^a-zåäö0-9]+/g, "-")}`;
const isInteractive = Boolean(item.href) && !item.disabled;
const Tag = isInteractive ? "a" : "div";
---

<Tag
  class:list={["expandable-card", item.disabled && "expandable-card--disabled"]}
  data-expandable-card
  data-index={index}
  href={isInteractive ? item.href : undefined}
  aria-labelledby={headingId}
>
  {item.image && (
    <img src={item.image} alt={item.imageAlt ?? ""} width="800" height="600" loading="lazy" decoding="async" />
  )}
  <span class="expandable-card__shade" aria-hidden="true"></span>
  <span class="expandable-card__content">
    {item.group && <span class="expandable-card__group">{item.group}</span>}
    <span class="expandable-card__heading">
      <h4 id={headingId}>{item.title}</h4>
      {item.disabled && item.status && <span class="expandable-card__status">{item.status}</span>}
    </span>
    {item.expandedText && (
      <span class="expandable-card__details">
        <span>{item.expandedText}</span>
        {isInteractive && (
          <span class="expandable-card__cta">{item.ctaLabel ?? "Läs mer"} <span aria-hidden="true">→</span></span>
        )}
      </span>
    )}
    {item.shortText && <span class="expandable-card__summary">{item.shortText}</span>}
  </span>
</Tag>

<style>
  .expandable-card {
    position: relative;
    min-width: 0;
    min-height: 390px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--avab-radius-sm);
    background: var(--avab-dark);
    color: var(--avab-white);
    box-shadow: var(--avab-shadow-sm);
    isolation: isolate;
    text-decoration: none;
  }

  .expandable-card img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 450ms ease;
  }

  .expandable-card__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, rgba(24, 30, 25, 0.96) 0%, rgba(24, 30, 25, 0.58) 58%, rgba(24, 30, 25, 0.18) 100%);
    transition: background-color 400ms ease;
  }

  .expandable-card__content {
    width: 100%;
    padding: clamp(22px, 3vw, 30px);
  }

  .expandable-card__group {
    display: block;
    margin-bottom: 10px;
    color: #e4edcf;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .expandable-card__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .expandable-card__heading h4 {
    margin: 0;
    color: var(--avab-white);
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    line-height: 1.2;
  }

  .expandable-card__status {
    flex-shrink: 0;
    padding: 5px 11px;
    border: 1px solid rgba(255, 255, 255, 0.32);
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.92);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .expandable-card__details,
  .expandable-card__summary {
    display: block;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.55;
  }

  .expandable-card__details { margin-top: 16px; }
  .expandable-card__summary { display: none; margin-top: 12px; }

  .expandable-card__cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    margin-top: 16px;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.22);
    color: var(--avab-green);
    font-weight: 800;
  }

  .expandable-card__cta span { color: var(--avab-green); }

  .expandable-card:hover { color: var(--avab-white); text-decoration: none !important; }
  .expandable-card:focus-visible { outline: 3px solid var(--avab-green); outline-offset: 4px; }

  .expandable-card--disabled { cursor: default; }
  .expandable-card--disabled .expandable-card__group { color: rgba(228, 237, 207, 0.6); }

  @media (hover: hover) and (pointer: fine) and (min-width: 901px) {
    .expandable-card__details {
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      visibility: hidden;
      transform: translateY(12px);
      transition: max-height 420ms ease, opacity 320ms ease, transform 320ms ease, visibility 0s linear 420ms;
    }

    .expandable-card__cta {
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 300ms ease, transform 300ms ease;
    }

    .expandable-card[data-expanded="true"] .expandable-card__details,
    .expandable-card:focus-visible .expandable-card__details {
      max-height: 190px;
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      transition-delay: 0s, 150ms, 150ms, 0s;
    }

    .expandable-card[data-expanded="true"] .expandable-card__cta,
    .expandable-card:focus-visible .expandable-card__cta {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 230ms;
    }

    .expandable-card[data-expanded="true"] img,
    .expandable-card:focus-visible img { transform: scale(1.018); }
  }

  @media (max-width: 900px), (hover: none), (pointer: coarse) {
    .expandable-card { min-height: 360px; }
    .expandable-card__details { margin-top: 12px; }
  }

  @media (max-width: 600px) {
    .expandable-card { min-height: 330px; }
    .expandable-card__content { padding: 22px; }
    .expandable-card__heading h4 { font-size: 1.35rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .expandable-card img,
    .expandable-card__shade,
    .expandable-card__details,
    .expandable-card__cta {
      transition-duration: 0.01ms;
      transition-delay: 0ms;
    }
  }
</style>
