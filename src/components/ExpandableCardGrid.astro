---
import ExpandableCard, { type ExpandableCardItem } from "./ExpandableCard.astro";

export type { ExpandableCardItem };

export interface ExpandableCardGroup {
  title?: string;
  items: ExpandableCardItem[];
  /**
   * Max antal kort per rad på desktop. Standard: alla kort i gruppen på en rad
   * (bevarar /tjanster/-beteendet, där hela gruppen delar en gemensam hover-rad).
   * När fler kort finns än desktopColumns delas gruppen upp i flera rader, och
   * varje rad får sin egen oberoende hover-/--active-template-state, så att
   * hover i en rad aldrig påverkar en annan rad.
   */
  desktopColumns?: number;
}

interface Props {
  groups: ExpandableCardGroup[];
}

const { groups } = Astro.props;
const slug = (value: string) => value.toLowerCase().replaceAll(/[^a-zåäö0-9]+/g, "-");

function chunk<T>(items: T[], size: number): T[][] {
  const rows: T[][] = [];
  for (let i = 0; i < items.length; i += size) rows.push(items.slice(i, i + size));
  return rows;
}
---

<div class="expandable-card-grid" data-expandable-card-grid>
  {groups.map((group) => {
    const perRow = group.desktopColumns ?? group.items.length;
    const rows = chunk(group.items, perRow);
    const headingId = group.title ? `expandable-card-group-${slug(group.title)}` : undefined;
    return (
      <section class="expandable-card-group" aria-labelledby={headingId}>
        {group.title && <h3 id={headingId}>{group.title}</h3>}
        {rows.map((rowItems) => (
          <div class="expandable-card-row" data-card-row style={`--row-count: ${perRow};`}>
            {rowItems.map((item, index) => <ExpandableCard item={item} index={index} />)}
          </div>
        ))}
      </section>
    );
  })}
</div>

<script>
  const fineHover = window.matchMedia("(hover: hover) and (pointer: fine) and (min-width: 901px)");

  document.querySelectorAll<HTMLElement>("[data-card-row]").forEach((row) => {
    const cards = Array.from(row.querySelectorAll<HTMLElement>("[data-expandable-card]"));
    let hoverTimer: ReturnType<typeof setTimeout> | undefined;

    const reset = () => {
      if (hoverTimer) window.clearTimeout(hoverTimer);
      hoverTimer = undefined;
      row.removeAttribute("data-active");
      row.style.removeProperty("--active-template");
      cards.forEach((card) => card.removeAttribute("data-expanded"));
    };

    const activate = (card: HTMLElement, delayed = false) => {
      if (!fineHover.matches) return;
      if (hoverTimer) window.clearTimeout(hoverTimer);

      const apply = () => {
        const indexAttr = card.dataset.index;
        if (!indexAttr) return;
        const activeIndex = Number(indexAttr);
        row.dataset.active = indexAttr;
        row.style.setProperty(
          "--active-template",
          cards.map((_, i) => (i === activeIndex ? "minmax(0, 2fr)" : "minmax(0, 1fr)")).join(" "),
        );
        cards.forEach((item) => {
          if (item === card) item.dataset.expanded = "true";
          else item.removeAttribute("data-expanded");
        });
      };

      if (delayed) hoverTimer = window.setTimeout(apply, 175);
      else apply();
    };

    cards.forEach((card) => {
      card.addEventListener("pointerenter", () => activate(card, true));
      card.addEventListener("focusin", () => activate(card));
    });

    row.addEventListener("pointerleave", reset);
    row.addEventListener("focusout", (event) => {
      if (!row.contains(event.relatedTarget as Node | null)) reset();
    });
    fineHover.addEventListener("change", reset);
  });
</script>

<style>
  .expandable-card-grid { display: grid; gap: clamp(36px, 5vw, 58px); }
  .expandable-card-group h3 { margin-bottom: 18px; font-size: clamp(1.15rem, 2vw, 1.35rem); }
  .expandable-card-row {
    display: grid;
    grid-template-columns: var(--active-template, repeat(var(--row-count, 3), minmax(0, 1fr)));
    gap: 18px;
  }

  @media (min-width: 901px) {
    .expandable-card-row + .expandable-card-row { margin-top: 18px; }
  }

  @media (hover: hover) and (pointer: fine) and (min-width: 901px) {
    .expandable-card-row { transition: grid-template-columns 430ms cubic-bezier(0.22, 1, 0.36, 1); }
  }

  @media (max-width: 900px) {
    /* Flera desktop-rader inom samma grupp ska flyta ihop till en enda
       kontinuerlig 2-kolumnsgrid på tablet, i stället för att staplas som
       separata block med extra mellanrum. */
    .expandable-card-group {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }
    .expandable-card-group h3 {
      grid-column: 1 / -1;
    }
    .expandable-card-row {
      display: contents;
    }
  }

  @media (max-width: 600px) {
    .expandable-card-grid { gap: 36px; }
    .expandable-card-group h3 { margin-bottom: 14px; }
    .expandable-card-group { grid-template-columns: 1fr; gap: 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .expandable-card-row { transition-duration: 0.01ms; }
  }
</style>
