---
import ExpandableCardGrid, { type ExpandableCardGroup } from "./ExpandableCardGrid.astro";
import type { ServiceOverviewGroup } from "../data/services";

interface Props {
  groups: ServiceOverviewGroup[];
}

const { groups } = Astro.props;

const cardGroups: ExpandableCardGroup[] = groups.map((group) => ({
  title: group.title,
  items: group.services.map((service) => ({
    title: service.title,
    group: service.group,
    shortText: service.shortText,
    expandedText: service.expandedText,
    href: service.href,
    image: service.image,
    imageAlt: service.imageAlt,
  })),
}));
---

<ExpandableCardGrid groups={cardGroups} />
