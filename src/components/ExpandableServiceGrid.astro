---
import ExpandableServiceCard from "./ExpandableServiceCard.astro";
import type { ServiceOverviewGroup } from "../data/services";

interface Props {
  groups: ServiceOverviewGroup[];
}

const { groups } = Astro.props;
---

<div class="expandable-service-grid" data-expandable-service-grid>
  {groups.map((group) => (
    <section class="expandable-service-group" aria-labelledby={`service-group-${group.title.toLowerCase().replaceAll(/[^a-zåäö0-9]+/g, "-")}`}>
      <h3 id={`service-group-${group.title.toLowerCase().replaceAll(/[^a-zåäö0-9]+/g, "-")}`}>{group.title}</h3>
      <div class="expandable-service-row" data-service-row>
        {group.services.map((service, index) => <ExpandableServiceCard service={service} index={index} />)}
      </div>
    </section>
  ))}
</div>

<script>
  const fineHover = window.matchMedia("(hover: hover) and (pointer: fine) and (min-width: 901px)");

  document.querySelectorAll<HTMLElement>("[data-service-row]").forEach((row) => {
    const cards = Array.from(row.querySelectorAll<HTMLElement>("[data-service-card]"));
    let hoverTimer: ReturnType<typeof setTimeout> | undefined;

    const reset = () => {
      if (hoverTimer) window.clearTimeout(hoverTimer);
      hoverTimer = undefined;
      row.removeAttribute("data-active");
      cards.forEach((card) => card.removeAttribute("data-expanded"));
    };

    const activate = (card: HTMLElement, delayed = false) => {
      if (!fineHover.matches) return;
      if (hoverTimer) window.clearTimeout(hoverTimer);

      const apply = () => {
        const index = card.dataset.index;
        if (!index) return;
        row.dataset.active = index;
        cards.forEach((item) => {
          if (item === card) item.dataset.expanded = "true";
          else item.removeAttribute("data-expanded");
        });
      };

      if (delayed) hoverTimer = window.setTimeout(apply, 175);
      else apply();
    };

    cards.forEach((card) => {
      card.addEventListener("pointerenter", () => activate(card, true));
      card.addEventListener("focusin", () => activate(card));
    });

    row.addEventListener("pointerleave", reset);
    row.addEventListener("focusout", (event) => {
      if (!row.contains(event.relatedTarget as Node | null)) reset();
    });
    fineHover.addEventListener("change", reset);
  });
</script>

<style>
  .expandable-service-grid { display: grid; gap: clamp(36px, 5vw, 58px); }
  .expandable-service-group h3 { margin-bottom: 18px; font-size: clamp(1.15rem, 2vw, 1.35rem); }
  .expandable-service-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  @media (hover: hover) and (pointer: fine) and (min-width: 901px) {
    .expandable-service-row { transition: grid-template-columns 430ms cubic-bezier(0.22, 1, 0.36, 1); }
    .expandable-service-row[data-active="0"] { grid-template-columns: 2fr 1fr 1fr; }
    .expandable-service-row[data-active="1"] { grid-template-columns: 1fr 2fr 1fr; }
    .expandable-service-row[data-active="2"] { grid-template-columns: 1fr 1fr 2fr; }
  }

  @media (max-width: 900px) {
    .expandable-service-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 600px) {
    .expandable-service-grid { gap: 36px; }
    .expandable-service-group h3 { margin-bottom: 14px; }
    .expandable-service-row { grid-template-columns: 1fr; gap: 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .expandable-service-row { transition-duration: 0.01ms; }
  }
</style>
