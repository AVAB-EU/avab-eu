---
const measurementId = "G-78VHW26XJ3";
---

<div
  class="cookie-consent"
  data-cookie-consent
  data-measurement-id={measurementId}
  hidden
>
  <div class="cookie-consent__inner" role="dialog" aria-modal="false" aria-labelledby="cookie-consent-title">
    <div class="cookie-consent__copy">
      <strong id="cookie-consent-title">Cookies för statistik</strong>
      <p>
        AVAB använder Google Analytics för att förstå hur webbplatsen används.
        Statistik aktiveras bara om du godkänner det.
        <a href="/integritetspolicy/#cookies">Läs mer om cookies</a>.
      </p>
    </div>

    <div class="cookie-consent__actions">
      <button class="cookie-consent__button cookie-consent__button--secondary" type="button" data-cookie-deny>
        Endast nödvändiga
      </button>
      <button class="cookie-consent__button cookie-consent__button--primary" type="button" data-cookie-accept>
        Tillåt statistik
      </button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ measurementId }}>
  (() => {
    const CONSENT_KEY = "avab-cookie-consent-v1";
    const banner = document.querySelector("[data-cookie-consent]");
    const acceptButton = document.querySelector("[data-cookie-accept]");
    const denyButton = document.querySelector("[data-cookie-deny]");
    const settingsButtons = document.querySelectorAll("[data-cookie-settings]");
    let analyticsLoaded = false;

    if (!banner || !acceptButton || !denyButton) return;

    const setGaDisabled = (disabled) => {
      window[`ga-disable-${measurementId}`] = disabled;
    };

    const loadAnalytics = () => {
      if (analyticsLoaded) {
        setGaDisabled(false);
        return;
      }

      analyticsLoaded = true;
      setGaDisabled(false);

      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () {
        window.dataLayer.push(arguments);
      };

      window.gtag("js", new Date());
      window.gtag("config", measurementId, {
        anonymize_ip: true
      });

      const script = document.createElement("script");
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`;
      script.dataset.avabAnalytics = "true";
      document.head.appendChild(script);
    };

    const readConsent = () => {
      try {
        return localStorage.getItem(CONSENT_KEY);
      } catch {
        return null;
      }
    };

    const saveConsent = (value) => {
      try {
        localStorage.setItem(CONSENT_KEY, value);
      } catch {
        // If storage is unavailable, the choice applies for this page view only.
      }
    };

    const showBanner = () => {
      banner.hidden = false;
    };

    const hideBanner = () => {
      banner.hidden = true;
    };

    const applyConsent = (value) => {
      if (value === "analytics") {
        loadAnalytics();
        hideBanner();
        return;
      }

      if (value === "necessary") {
        setGaDisabled(true);
        hideBanner();
        return;
      }

      setGaDisabled(true);
      showBanner();
    };

    acceptButton.addEventListener("click", () => {
      saveConsent("analytics");
      applyConsent("analytics");
    });

    denyButton.addEventListener("click", () => {
      saveConsent("necessary");
      applyConsent("necessary");
    });

    settingsButtons.forEach((button) => {
      button.addEventListener("click", () => {
        showBanner();
        acceptButton.focus();
      });
    });

    applyConsent(readConsent());
  })();
</script>

<style>
  .cookie-consent[hidden] {
    display: none;
  }

  .cookie-consent {
    position: fixed;
    right: 24px;
    bottom: 24px;
    left: 24px;
    z-index: 1000;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .cookie-consent__inner {
    width: min(100%, 980px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding: 22px 24px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 18px;
    background: var(--avab-dark, #282e29);
    color: #fff;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.28);
    pointer-events: auto;
  }

  .cookie-consent__copy {
    min-width: 0;
  }

  .cookie-consent__copy strong {
    display: block;
    margin-bottom: 6px;
    font-size: 1rem;
    font-weight: 800;
  }

  .cookie-consent__copy p {
    margin: 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .cookie-consent__copy a {
    color: #fff;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cookie-consent__actions {
    display: flex;
    flex: 0 0 auto;
    gap: 10px;
  }

  .cookie-consent__button {
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 750;
    cursor: pointer;
  }

  .cookie-consent__button--primary {
    border: 1px solid var(--avab-green, #8fc025);
    background: var(--avab-green, #8fc025);
    color: var(--avab-dark, #282e29);
  }

  .cookie-consent__button--secondary {
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: transparent;
    color: #fff;
  }

  .cookie-consent__button:hover {
    transform: translateY(-1px);
  }

  .cookie-consent__button:focus-visible,
  .cookie-consent__copy a:focus-visible {
    outline: 3px solid var(--avab-green, #8fc025);
    outline-offset: 3px;
  }

  @media (max-width: 720px) {
    .cookie-consent {
      right: 12px;
      bottom: 12px;
      left: 12px;
    }

    .cookie-consent__inner {
      align-items: stretch;
      flex-direction: column;
      gap: 18px;
      padding: 20px;
    }

    .cookie-consent__actions {
      display: grid;
      grid-template-columns: 1fr;
    }

    .cookie-consent__button {
      width: 100%;
    }
  }
</style>
