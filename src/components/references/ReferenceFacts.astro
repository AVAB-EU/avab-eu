---
import type { CollectionEntry } from "astro:content";

type Facts = CollectionEntry<"references">["data"]["facts"];
interface Props { facts: Facts }
const { facts } = Astro.props;
---

<section class="reference-facts" aria-label="Referensen i ett nötskal">
  <div class="avab-container reference-facts-grid" style={`--reference-fact-count: ${facts.length};`}>
    {facts.map((fact) => (
      <div class="reference-fact">
        <span>{fact.label}</span>
        <strong>{fact.value}</strong>
      </div>
    ))}
  </div>
</section>
