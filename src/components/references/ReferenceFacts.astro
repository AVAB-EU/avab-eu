---
import type { CollectionEntry } from "astro:content";

type Facts = CollectionEntry<"references">["data"]["facts"];
interface Props { facts: Facts; maxItems?: number }
const { facts, maxItems } = Astro.props;
const visibleFacts = maxItems ? facts.slice(0, maxItems) : facts;
---

<section class="reference-facts" aria-label="Referensen i ett nötskal">
  <div class="avab-container reference-facts-grid">
    {visibleFacts.map((fact) => (
      <div class="reference-fact">
        <span>{fact.label}</span>
        <strong>{fact.value}</strong>
      </div>
    ))}
  </div>
</section>
