---
import type { CollectionEntry } from "astro:content";

type Gallery = NonNullable<CollectionEntry<"references">["data"]["gallery"]>;
interface Props {
  gallery: Gallery;
  eyebrow?: string;
}
const { gallery, eyebrow = gallery.eyebrow } = Astro.props;
const imageCount = gallery.images.length;
const galleryClass = imageCount === 1
  ? "gallery-grid gallery-grid--single"
  : `gallery-grid gallery-grid--count-${Math.min(imageCount, 8)}`;
---

<section
  class="reference-section"
  id="bilder"
  aria-labelledby="bilder-title"
  data-reference-anchor-section
>
  <div class="avab-container">
    <div class="reference-section-heading">
      <span class="reference-kicker reference-section-eyebrow">{eyebrow}</span>
      <h2 id="bilder-title">{gallery.title}</h2>
      {gallery.lead && <p>{gallery.lead}</p>}
    </div>
    <div class={galleryClass}>
      {gallery.images.map((image) => (
        <figure class="gallery-card">
          <div class="gallery-image">
            <img
              src={image.src}
              alt={image.alt}
              width={image.width}
              height={image.height}
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption>{image.caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
