---
import type { CollectionEntry } from "astro:content";

type Results = NonNullable<CollectionEntry<"references">["data"]["results"]>;
interface Props {
  results: Results;
  eyebrow?: string;
}
const { results, eyebrow = results.eyebrow } = Astro.props;
---

<section
  class="reference-section reference-section--soft"
  id="resultat"
  aria-labelledby="resultat-title"
  data-reference-anchor-section
>
  <div class="avab-container">
    <div class="reference-section-heading">
      <span class="reference-kicker reference-section-eyebrow">{eyebrow}</span>
      <h2 id="resultat-title">{results.title}</h2>
      {results.lead && <p>{results.lead}</p>}
    </div>
    <div class="reference-summary-grid">
      {results.items.map((result) => (
        <article class="reference-summary">
          {result.label && <span class="reference-summary-number">{result.label}</span>}
          <h3>{result.title}</h3>
          <p>{result.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
