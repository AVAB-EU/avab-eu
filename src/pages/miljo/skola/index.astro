  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "AV-teknik för skola och utbildning",
    "provider": {
      "@type": "LocalBusiness",
      "name": "AVAB",
      "url": "https://www.avab.eu/",
      "telephone": "+46548202080",
      "email": "info@avab.eu",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Skraggevägen 4",
        "postalCode": "663 41",
        "addressLocality": "Hammarö",
        "addressRegion": "Värmland",
        "addressCountry": "SE"
      }
    },
    "areaServed": "Sverige",
    "serviceType": [
      "AV-teknik för skola",
      "Undervisningsteknik för klassrum",
      "Ljud och bild för aula och hörsal",
      "Rastsignalsystem och utrop",
      "Hörslinga och tillgängligt ljud",
      "Informationsskärmar för skola",
      "Styrsystem och integration",
      "Projektering, installation och dokumentation"
    ],
    "description": "AVAB projekterar, installerar och driftsätter kompletta AV-lösningar för skolor med undervisningsteknik, aula, rastsignal, hörslinga, informationsskärmar, styrning och dokumentation."
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Vilken AV-teknik behöver en skola?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Behovet varierar mellan klassrum, hörsalar, aula, matsal, korridorer och skolgård. Vanliga delar är bildvisning, högtalare, mikrofoner, informationsskärmar, rastsignal, hörslinga, enkel styrning och dokumenterad drift."
        }
      },
      {
        "@type": "Question",
        "name": "Kan befintliga högtalare och kablar återanvändas?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ofta kan delar av en äldre installation återanvändas. Innan beslut kontrolleras skick, täckning, impedans, kabeldragning, säkerhet, kompatibilitet och om anläggningen klarar skolans nya funktioner."
        }
      },
      {
        "@type": "Question",
        "name": "Kan skolgården delas in i olika ljudzoner?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja. Rastsignal och utrop kan delas mellan exempelvis lågstadium, mellanstadium, skolgård, sporthall och andra byggnader. Varje zon kan få egna scheman och behörigheter."
        }
      },
      {
        "@type": "Question",
        "name": "Är ett rastsignalsystem samma sak som ett brand- eller utrymningslarm?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Nej. Rastsignal och vanliga utrop är informationsfunktioner. Ett certifierat talat utrymningslarm är ett separat säkerhetssystem som projekteras och dokumenteras efter de krav som gäller för byggnaden."
        }
      },
      {
        "@type": "Question",
        "name": "Hur planeras hörslinga och tillgängligt ljud i en skola?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Tillgängligheten behöver planeras per rum och användningssätt. Aula, matsal, bibliotek, reception och undervisningsrum kan kräva olika lösningar, mätning och dokumentation."
        }
      },
      {
        "@type": "Question",
        "name": "Hur gör man klassrumstekniken enkel för lärarna?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Genom att standardisera anslutningar, knappar, bild- och ljudfunktioner mellan rummen. Då möter läraren samma arbetssätt oavsett klassrum och supporten blir enklare."
        }
      },
      {
        "@type": "Question",
        "name": "När bör AV-tekniken tas in i ett skolprojekt?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "AV-tekniken bör tas in innan tak, väggar, scen, möblering, el, nätverk, kabelvägar och teknikrum är låsta. Då kan systemen samordnas med bygg, el, IT, akustik och säkerhet."
        }
      }
    ]
  }
  </script>

