  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://www.avab.eu/miljo/skola/#webpage",
    "url": "https://www.avab.eu/miljo/skola/",
    "name": "Skola & utbildning | Ljud, bild, rastsignal och aula | AVAB",
    "description": "AV-teknik för skolor med undervisningsrum, aula, ljud, bild, rastsignal, hörslinga, informationsskärmar, styrning och dokumentation.",
    "inLanguage": "sv-SE",
    "isPartOf": { "@type": "WebSite", "name": "AVAB", "url": "https://www.avab.eu/" },
