  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "AV-teknik för vård, sjukhus och omsorg",
    "provider": {
      "@type": "LocalBusiness",
      "name": "AVAB",
      "url": "https://www.avab.eu/",
      "telephone": "+46548202080",
      "email": "info@avab.eu",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Skraggevägen 4",
        "postalCode": "663 41",
        "addressLocality": "Hammarö",
        "addressRegion": "Värmland",
        "addressCountry": "SE"
      }
    },
    "areaServed": "Sverige",
    "serviceType": [
      "Zonutrop för sjukhus och vård",
      "Ljudsystem för vårdmiljö",
      "Hörslinga och Auracast",
      "Kameraövervakning för vårdfastigheter",
      "Styrsystem och integration",
      "STI-inmätning",
      "Projektering och dokumentation"
    ],
    "description": "AVAB projekterar, installerar och driftsätter sammanhängande AV-lösningar för vård, sjukhus och omsorg med ljud, zonutrop, styrning, tillgänglighet, kamera och dokumentation."
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Hur fungerar zonutrop i en vårdfastighet?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ett zonindelat system gör det möjligt att rikta information till en avdelning, ett våningsplan eller hela fastigheten. Prioriterade meddelanden kan ges företräde när systemet projekteras för det."
        }
      },
      {
        "@type": "Question",
        "name": "Kan AV-systemet samverka med larm och andra fastighetssystem?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja, när systemen har rätt gränssnitt kan ljud, styrning och larmfunktioner samordnas. Gränsdragning, ansvar och funktion dokumenteras i projekteringen."
        }
      },
      {
        "@type": "Question",
        "name": "Får man använda kameraövervakning i vårdmiljö?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Kameraövervakning i vårdmiljö kräver en noggrann bedömning av syfte, integritet, rättslig grund, åtkomst och lagring. Tekniken ska utformas efter verksamhetens beslut och gällande krav."
        }
      },
      {
        "@type": "Question",
        "name": "Behövs hörslinga eller Auracast i vårdmiljöer?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Tillgänglighetsbehovet beror på lokal och användning. Hörslinga kan vara rätt i receptioner och mötesrum, medan Auracast kan vara ett komplement där kompatibel utrustning används."
        }
      },
      {
        "@type": "Question",
        "name": "Vad betyder STI för utropssystem?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "STI är ett mått på taluppfattbarhet. Projektering och inmätning hjälper till att säkerställa att viktiga meddelanden går att förstå i den aktuella akustiska miljön."
        }
      },
      {
        "@type": "Question",
        "name": "Kan elektriker installera efter AVAB:s underlag?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja. AVAB kan ta fram underlag och ansvara för driftsättning, medan elektriker utför delar av installationen. AVAB kan även leverera en komplett installation."
        }
      },
      {
        "@type": "Question",
        "name": "När bör AV-tekniken tas in i ett vårdprojekt?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "AV-tekniken bör tas in innan kabelvägar, rackplats, tak, väggar och funktionskrav är låsta. Det minskar risken för sena kompletteringar och otydlig gränsdragning."
        }
      }
    ]
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
