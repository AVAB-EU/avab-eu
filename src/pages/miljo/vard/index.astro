---

import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import "../../../styles/avab.css";

const heroImage = '/images/miljo-vard-hero.jpg';
const stats = [
  { value: '98%', label: 'upplevd trygghet i arbetsmiljön' },
  { value: '24/7', label: 'stöd för personal och ledning' },
  { value: '3x', label: 'snabbare uppföljning av riskområden' },
];
const values = [
  {
    title: 'Förebyggande arbetsmiljö',
    text: 'Vi hjälper dig att identifiera och minska risker innan de blir kostsamma eller skapar personalförluster.',
  },
  {
    title: 'Kvalitetsdriven vård',
    text: 'En tydlig process, lättillgängliga rutiner och engagerad support ger bättre arbetsförhållanden varje dag.',
  },
  {
    title: 'Datadriven förbättring',
    text: 'Genom att följa trend och mätvärden kan du agera snabbt och prioritera rätt åtgärder.',
  },
];
---

<section class="hero hero--sporthall" style={`background: linear-gradient(135deg, rgba(40,46,42,.84), rgba(40,46,42,.5)), url('${heroImage}') center/cover no-repeat;`}>
  <div class="avab-container hero-inner">
    <div class="hero-content animate-in">
      <span class="eyebrow eyebrow-dark">Miljö &amp; vård</span>
      <h1>Skapa säkra, hållbara och effektiva arbetsplatser.</h1>
      <p class="lead">
        AVAB hjälper verksamheter inom miljö och vård att skapa bättre arbetsförhållanden genom smarta rutiner,
        lösningar för uppföljning och stöd i det dagliga arbetet.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#kontakt">Boka demo</a>
        <a class="button button-secondary" href="#las-mer">Läs mer</a>
      </div>
      <div class="hero-pills" aria-label="Snabblänkar">
        <a href="#riskanalys">Riskanalys</a>
        <a href="#uppfoljning">Uppföljning</a>
        <a href="#support">Support</a>
      </div>
    </div>
  </div>
</section>

<nav class="breadcrumbs" aria-label="Du är här">
  <div class="avab-container">
    <ol>
      <li><a href="/">Startsida</a></li>
      <li><a href="/miljo">Miljö</a></li>
      <li><span aria-current="page">Vård</span></li>
    </ol>
  </div>
</nav>

<section class="section">
  <div class="avab-container two-col two-col--center">
    <div>
      <span class="eyebrow eyebrow-dark">Varför AVAB</span>
      <h2>En lösning som förenklar vardagen för både personal och ledning.</h2>
      <p class="lead-dark">
        För verksamheter som behöver hålla hög kvalitet samtidigt som man arbetar förebyggande och följer lagkrav
        krävs ett system som är enkelt att använda och enkelt att följa upp.
      </p>
    </div>
    <div class="card card--light" style="padding: 32px; border-radius: 24px;">
      <p class="text-strong-dark">Det här får du:</p>
      <ul class="bullet-list">
        <li>Mer strukturerade rutiner och tydliga ansvar</li>
        <li>Snabbare identifiering av risker och brister</li>
        <li>Ökad förutsägbarhet i uppföljning och förbättringsarbete</li>
      </ul>
    </div>
  </div>
</section>

<section class="section section--light" id="las-mer">
  <div class="avab-container">
    <div class="section-heading">
      <span class="eyebrow eyebrow-dark">Tjänster</span>
      <h2>Bygg en tryggare och mer hållbar arbetsplats.</h2>
    </div>
    <div class="grid-3">
      {values.map((item) => (
        <article class="card" style="padding: 28px; border-radius: 24px; height: 100%;">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="avab-container">
    <div class="proof-strip">
      {stats.map((stat) => (
        <div class="proof-item">
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section section--light" id="riskanalys">
  <div class="avab-container two-col two-col--center">
    <div>
      <span class="eyebrow eyebrow-dark">Arbetsmiljö i fokus</span>
      <h2>Risker blir lättare att hantera när rätt information finns på rätt plats.</h2>
      <p>
        Genom att arbeta med tydliga processer och kontinuerlig uppföljning kan en verksamhet förebygga olyckor,
        förbättra sjukfrånvaro och stärka arbetsglädjen.
      </p>
    </div>
    <div class="image-wrapper image-wrapper--fill-lg" style="border-radius: 24px; overflow: hidden; background: linear-gradient(135deg, #dcebb0, #f8f9f2);"></div>
  </div>
</section>

<section class="section">
  <div class="avab-container">
    <div class="section-heading">
      <span class="eyebrow eyebrow-dark">Process</span>
      <h2>Så arbetar vi tillsammans.</h2>
    </div>
    <div class="grid-3">
      <article class="flow-card">
        <strong>1. Kartläggning</strong>
        <span>Vi identifierar nuläge, risker och behov tillsammans med dig.</span>
      </article>
      <article class="flow-card">
        <strong>2. Implementering</strong>
        <span>Vi sätter ihop tydliga rutiner och konkreta arbetsflöden för verksamheten.</span>
      </article>
      <article class="flow-card">
        <strong>3. Uppföljning</strong>
        <span>Du får ett enkelt system för att följa utvecklingen och förbättra löpande.</span>
      </article>
    </div>
  </div>
</section>

<section class="section section--light" id="uppfoljning">
  <div class="avab-container two-col">
    <div>
      <span class="eyebrow eyebrow-dark">Uppföljning</span>
      <h2>Få bättre överblick och snabbare beslut.</h2>
      <p>
        Med ett strukturerat arbetssätt blir det enklare att följa arbetsmiljöfrågor, rätta till brister och visa på
        förbättringar som faktiskt ger effekt.
      </p>
      <ul class="bullet-list">
        <li>Enklare rapportering och bokföring</li>
        <li>Förbättrad kommunikation mellan avdelningar</li>
        <li>Mer saklig och kontinuerlig förbättring</li>
      </ul>
    </div>
    <div class="card card--light" style="padding: 32px; border-radius: 24px;">
      <h3>Resultat du kan känna</h3>
      <div class="stat-row">
        <div>
          <strong>24%</strong>
          <span>kortare handläggningstid</span>
        </div>
        <div>
          <strong>41%</strong>
          <span>bättre rutinkännedom</span>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section" id="support">
  <div class="avab-container">
    <div class="dark-card" style="padding: 40px; border-radius: 24px; background: linear-gradient(135deg, #282E29, #3A433D);">
      <span class="eyebrow eyebrow-dark" style="color: #fff;">Support</span>
      <h2>Vi finns med från start till fortsatt utveckling.</h2>
      <p>
        Oavsett om du behöver stöd i en första analys, ett införande eller en fortsatt förbättringsprocess hjälper våra
        rådgivare dig genom hela resan.
      </p>
      <div class="cta-actions">
        <a class="button button-light" href="#kontakt">Kontakta oss</a>
      </div>
    </div>
  </div>
</section>

<section class="section" id="kontakt">
  <div class="avab-container two-col">
    <div>
      <span class="eyebrow eyebrow-dark">Kontakta oss</span>
      <h2>Vill du veta mer om lösningen?</h2>
      <p>Ta kontakt så berättar vi hur vi kan anpassa arbetssättet efter din verksamhets behov.</p>
    </div>
    <div class="card" style="padding: 32px; border-radius: 24px;">
      <p class="text-strong-dark">Ring oss</p>
      <p><a class="text-link" href="tel:+46000000000">+46 00 000 00 00</a></p>
      <p class="text-strong-dark">E-post</p>
      <p><a class="text-link" href="mailto:info@avab.se">info@avab.se</a></p>
    </div>
  </div>
</section>
