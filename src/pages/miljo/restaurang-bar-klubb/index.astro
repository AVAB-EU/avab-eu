  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "AV-teknik för restaurang, bar och klubb",
    "provider": {
      "@type": "LocalBusiness",
      "name": "AVAB",
      "url": "https://www.avab.eu/",
      "telephone": "+46548202080",
      "email": "info@avab.eu",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Skraggevägen 4",
        "postalCode": "663 41",
        "addressLocality": "Hammarö",
        "addressRegion": "Värmland",
        "addressCountry": "SE"
      }
    },
    "areaServed": "Sverige",
    "serviceType": [
      "Ljudsystem för restaurang och bar",
      "Zonstyrd bakgrundsmusik",
      "DJ- och eventljud",
      "Ljudsystem för nattklubb",
      "Dynamisk belysning och ljusscenarier",
      "Bildskärmar och projektorer",
      "Styrsystem för restaurang",
      "Kameraövervakning för krogmiljö",
      "Projektering, installation och service"
    ],
    "description": "AVAB projekterar, installerar och driftsätter kompletta AV-lösningar för restauranger, barer och klubbar med zonstyrt ljud, DJ- och eventteknik, ljus, bild, styrning och säkerhet."
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Vilken AV-teknik behöver en restaurang eller bar?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "En restaurang eller bar behöver ofta zonstyrt bakgrundsljud, enkel personalstyrning, anslutningar för musik och mikrofoner samt vid behov DJ-ljud, ljusscenarier, skärmar, projektorer och kameraövervakning."
        }
      },
      {
        "@type": "Question",
        "name": "Kan samma system fungera för lunch, middag och nattklubb?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja. Med separata zoner och förprogrammerade scenarier kan ljudnivå, musikkälla, subbas, belysning och bild anpassas från lugn dagdrift till middag, fest eller klubbkväll."
        }
      },
      {
        "@type": "Question",
        "name": "Hur delas ljudet mellan matsal, bar och uteservering?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Lokalen delas in i ljudzoner. Varje zon kan få egen volym, musikkälla, tidsschema och begränsningar så att rätt nivå används i matsal, bar, entré, toaletter, scen och uteservering."
        }
      },
      {
        "@type": "Question",
        "name": "Kan personalen styra systemet utan tekniska kunskaper?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja. Styrningen kan samlas i en tydlig panel eller app med färdiga lägen för exempelvis öppning, lunch, middag, DJ, event och stängning. Avancerade inställningar skyddas från vardagsanvändaren."
        }
      },
      {
        "@type": "Question",
        "name": "Kan ett fast ljudsystem kompletteras för DJ och liveevent?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja. Den fasta installationen kan förberedas med rätt inkopplingspunkter, signalnivåer, processning och högtalarkapacitet för DJ, mikrofoner, extern mixer och mindre liveframträdanden."
        }
      },
      {
        "@type": "Question",
        "name": "Går det att återanvända befintliga högtalare eller förstärkare?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ofta kan delar av den befintliga anläggningen återanvändas. Först kontrolleras skick, kapacitet, placering, impedans, nätverk, styrgränssnitt och om utrustningen klarar den nya verksamhetens krav."
        }
      },
      {
        "@type": "Question",
        "name": "När bör AV-tekniken tas in i ett restaurangprojekt?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "AV-tekniken bör tas in innan tak, inredning, bar, scen, kabelvägar, el, nätverk och rackplats är låsta. Då kan högtalare, ljus och styrning integreras diskret och sena kompletteringar undvikas."
        }
      }
    ]
  }
  </script>

