    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://www.avab.eu/miljo/restaurang-bar-klubb/#webpage",
    "url": "https://www.avab.eu/miljo/restaurang-bar-klubb/",
    "name": "Restaurang, bar & klubb | Ljud, ljus och styrning | AVAB",
    "description": "AV-teknik för restaurang, bar och klubb med zonstyrt ljud, DJ- och eventteknik, dynamiskt ljus, bild, styrsystem och kameraövervakning.",
    "inLanguage": "sv-SE",
