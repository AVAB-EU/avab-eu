---
import ContentSection from "../../components/ContentSection.astro";
import LandingLinkCard from "../../components/LandingLinkCard.astro";
import PageCTA from "../../components/PageCTA.astro";
import ReferenceCard from "../../components/ReferenceCard.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { environments, references, technologies } from "../../data/referenser";
import "../../styles/avab.css";

const featuredEnvironments = [
  { href: "/miljo/sporthall-arena/", title: "Sporthall & arena", eyebrow: "Sport", text: "Tydligt tal, matchljud och flexibel styrning för träning, tävling och publik.", image: "/assets/inomhusarena-plan-laktare-bred.webp", imageAlt: "Inomhusarena med spelplan och läktare", featured: true },
  { href: "/miljo/simhall/", title: "Simhall & badhus", eyebrow: "Bad", text: "Fukttålig teknik, zonindelat ljud och enkel kontroll i krävande badanläggningar.", image: "/assets/tavlingsbassang-startpallar-langvy.webp", imageAlt: "Tävlingsbassäng med startpallar och läktare", featured: true },
  { href: "/miljo/skola/", title: "Skola", eyebrow: "Utbildning", text: "Lösningar som hjälper undervisning, samlingar, information och tillgänglighet att fungera tillsammans.", image: "/assets/modern-trafasad-innergard.webp", imageAlt: "Modern skolbyggnad med träfasad och innergård" },
  { href: "/miljo/kontor-konferens/", title: "Kontor & konferens", eyebrow: "Möten", text: "Mötesteknik som startar snabbt och gör det enkelt för alla att höras och synas.", image: "/assets/konferensrum-stor-skarm-bord.webp", imageAlt: "Konferensrum med långbord och stor bildskärm" },
  { href: "/miljo/hotell/", title: "Hotell", eyebrow: "Gästupplevelse", text: "Samordnat ljud och mötesteknik från lobby och restaurang till konferens och spa.", image: "/assets/fjallanlaggning-vinterkvall.webp", imageAlt: "Hotellanläggning i fjällmiljö en vinterkväll" },
  { href: "/miljo/industri/", title: "Industri", eyebrow: "Verksamhet", text: "Robust kommunikation och konferensteknik anpassad för både produktion och kontor.", image: "/assets/lesjofors-ab.webp", imageAlt: "Konferensrum i industriverksamhet med stor display" },
];

const shownRoutes = new Set(featuredEnvironments.map((item) => item.href));
const remainingEnvironments = environments.filter((environment) => environment.href && !shownRoutes.has(environment.href));
const featuredReferences = references.filter((reference) => reference.featured).slice(0, 3);

const needs = [
  { title: "Talet måste nå fram", text: "Rätt högtalare, placering och inmätning ger hörbarhet även i stora, hårda eller bullriga rum." },
  { title: "Tekniken ska vara enkel", text: "Samlad styrning gör vardagen tryggare för personalen och minskar risken för handhavandefel." },
  { title: "Alla ska kunna delta", text: "Hörslinga, tydlig information och genomtänkta användarflöden bygger in tillgänglighet från början." },
  { title: "Olika zoner har olika behov", text: "Rätt ljud och information på rätt plats – utan att hela verksamheten måste använda samma läge." },
  { title: "Miljön ställer tekniska krav", text: "Fukt, buller, akustik, avstånd och drift påverkar val av utrustning och installation." },
  { title: "Lösningen ska hålla över tid", text: "Projektering, dokumentation och servicebarhet gör anläggningen enklare att äga och utveckla." },
];

const pageTitle = "AV-lösningar för alla miljöer | AVAB";
const pageDescription = "Utforska AVAB:s lösningar för sporthallar, simhallar, skolor, kontor, hotell, industri och andra verksamhetsmiljöer.";
const canonical = "https://avab.eu/miljo/";
const heroImage = "https://avab.eu/assets/inomhusarena-match-publik.webp";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Start", item: "https://avab.eu/" },
    { "@type": "ListItem", position: 2, name: "Miljöer", item: canonical },
  ],
};
---

<!DOCTYPE html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#282E29" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={heroImage} />
    <meta property="og:image:alt" content="Fullsatt inomhusarena under match" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:site_name" content="AVAB" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="preload" as="image" href="/assets/inomhusarena-match-publik.webp" fetchpriority="high" />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </head>
  <body>
    <SiteHeader />
    <main id="main">
      <header class="hero">
        <img class="hero-image" src="/assets/inomhusarena-match-publik.webp" alt="" width="1536" height="1024" fetchpriority="high" />
        <div class="avab-container hero-content">
          <div class="eyebrow">Rätt teknik för rätt verksamhet</div>
          <h1>Varje miljö har sitt eget ljud</h1>
          <p>Från ekande idrottshallar och fuktiga badhus till fokuserade mötesrum. AVAB formar ljud, bild, ljus och styrning efter människorna, rummet och vardagen.</p>
          <div class="actions">
            <a class="button button-primary" href="#alla-miljoer">Hitta din miljö</a>
            <a class="button button-secondary" href="/kontakt/">Prata med AVAB</a>
          </div>
        </div>
      </header>

      <ContentSection labelledby="intro-title">
        <div class="landing-heading">
          <p class="eyebrow">Helheten först</p>
          <h2 id="intro-title">Teknik som fungerar där den ska användas</h2>
          <p>En bra AV-lösning börjar inte med en produktlista. Den börjar med rummet, verksamheten och de människor som ska använda tekniken – varje dag, ofta i många år.</p>
        </div>
        <div class="landing-card-grid" id="alla-miljoer">
          {featuredEnvironments.map((environment) => <LandingLinkCard {...environment} />)}
        </div>
      </ContentSection>

      <ContentSection surface="green" class="needs-section" labelledby="needs-title">
        <div class="landing-heading">
          <p class="eyebrow">Behov vi löser</p>
          <h2 id="needs-title">När rummet gör tekniken svår</h2>
          <p>Miljöerna skiljer sig åt, men målet är detsamma: tydlig kommunikation, enkel användning och en lösning som håller i verklig drift.</p>
        </div>
        <div class="need-grid">
          {needs.map((need) => <article class="need-card"><h3>{need.title}</h3><p>{need.text}</p></article>)}
        </div>
      </ContentSection>

      <ContentSection surface="soft" labelledby="directory-title">
        <div class="landing-heading">
          <p class="eyebrow">Fler verksamhetsmiljöer</p>
          <h2 id="directory-title">Hitta lösningen för din lokal</h2>
          <p>Gå vidare till den miljö som ligger närmast din verksamhet. Där finns mer om typiska krav, lösningar och nästa steg.</p>
        </div>
        <ul class="environment-directory">
          {remainingEnvironments.map((environment) => <li><a href={environment.href}>{environment.label}</a></li>)}
        </ul>
      </ContentSection>

      <ContentSection labelledby="references-title">
        <div class="landing-heading">
          <p class="eyebrow">Från behov till fungerande vardag</p>
          <h2 id="references-title">Lösningar i verkliga miljöer</h2>
          <p>Se hur AVAB har kombinerat teknik, projektering och installation i verksamheter med helt olika förutsättningar.</p>
        </div>
        <div class="ref-grid">
          {featuredReferences.map((reference) => <ReferenceCard reference={reference} environments={environments} technologies={technologies} />)}
        </div>
        <div class="section-actions"><a class="button button-secondary" href="/referenser/">Se alla referenser</a></div>
      </ContentSection>

      <PageCTA
        flush
        eyebrow="Vi hjälper dig välja rätt"
        title="Vilken miljö ska tekniken fungera i?"
        text="Berätta om lokalen, verksamheten och vad som behöver fungera bättre. Vi hjälper dig att hitta rätt väg vidare."
        primaryLabel="Kontakta AVAB"
        primaryHref="/kontakt/"
        secondaryLabel="Se våra referenser"
        secondaryHref="/referenser/"
        points={["Projektering utifrån verkliga behov", "Installation och driftsättning", "En kontakt genom hela projektet"]}
      />
    </main>
    <SiteFooter />
  </body>
</html>
