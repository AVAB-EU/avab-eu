---
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import "../../../styles/avab.css";


const envCards = [
  {
    title: 'Utomhusaktiviteter för alla nivåer',
    description:
      'Från bollspel och rörelseaktiviteter till säkra träningsstationer – vi skapar en miljö som gör det enkelt att komma igång och hålla igång.',
  },
  {
    title: 'Anpassad efter din verksamhet',
    description:
      'Vi jobbar med både skolor, företag och kommuner och anpassar yta, utrustning och upplägg efter målgrupp, budget och behov av trygghet.',
  },
  {
    title: 'Tydliga arbetsflöden och hög tillgänglighet',
    description:
      'Klart ansvar, enkel logistik och träningsytor som är byggda för både korta aktiviteter och längre samlingspass.',
  },
];
const flowCards = [
  {
    title: '1. Kartlägg behov',
    text: 'Vi går igenom vilka aktiviteter, målgrupper och krav som finns på ytan och genomförandet.',
  },
  {
    title: '2. Planera lösningen',
    text: 'Tillsammans sätter vi ihop ett upplägg som fungerar i praktiken och möter era krav på säkerhet och användning.',
  },
  {
    title: '3. Genomför och kvalitetssäkra',
    text: 'Utrustningen och miljön förbereds, testas och säkras för daglig användning.',
  },
  {
    title: '4. Håll igång och utveckla',
    text: 'Efter leverans stödjer vi med uppföljning, justeringar och ytterligare utveckling av aktivitetsytan.',
  },
];
---

<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Utomhusidrott – AVAB</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --avab-green: #8fc025;
        --avab-green-hover: #9ed229;
        --avab-green-soft: rgba(143, 192, 37, 0.12);
        --avab-dark: #282e29;
        --avab-dark-muted: #3a433d;
        --avab-grey: #e9eae9;
        --avab-light: #f4f5f4;
        --avab-white: #ffffff;
        --avab-border: rgba(40, 46, 42, 0.1);
        --avab-shadow-sm: 0 4px 12px rgba(40, 46, 42, 0.05);
        --avab-shadow-lg: 0 24px 48px rgba(40, 46, 42, 0.12);
        --avab-radius: 24px;
        --avab-radius-sm: 16px;
        --avab-max: 1280px;
        --transition-smooth: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        --avab-nav-height: 72px;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        color: var(--avab-dark);
        background: var(--avab-white);
        line-height: 1.65;
      }
      a { color: inherit; text-decoration: none; }
      img { max-width: 100%; display: block; }
      .avab-container {
        width: min(calc(100% - 48px), var(--avab-max));
        margin: 0 auto;
      }
      .section {
        padding: 80px 0;
        border-bottom: 1px solid var(--avab-border);
      }
      .section--light { background: var(--avab-light); }
      .section-heading {
        display: grid;
        gap: 32px;
        align-items: end;
        margin-bottom: 42px;
        max-width: 980px;
      }
      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 16px;
        color: var(--avab-green);
        font-size: 0.9rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
      .eyebrow::before {
        content: '';
        width: 24px;
        height: 2px;
        border-radius: 999px;
        background: currentColor;
      }
      h1, h2, h3 { line-height: 1.15; margin: 0 0 16px; }
      h1 { font-size: clamp(2.5rem, 6vw, 4.8rem); }
      h2 { font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 800; }
      h3 { font-size: 1.4rem; font-weight: 800; }
      p {
        margin: 0 0 18px;
        color: var(--avab-dark-muted);
        font-size: 1.1rem;
      }
      .lead {
        max-width: 68ch;
        font-size: 1.2rem;
      }
      .site-nav {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--avab-border);
      }
      .site-nav .avab-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        min-height: var(--avab-nav-height);
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-weight: 800;
        font-size: 1.2rem;
      }
      .brand-dot {
        width: 14px;
        height: 14px;
        border-radius: 4px;
        background: var(--avab-green);
        box-shadow: 0 0 0 4px var(--avab-green-soft);
      }
      .nav-links {
        display: flex;
        align-items: center;
        gap: 20px;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .nav-link {
        font-weight: 700;
        color: var(--avab-dark-muted);
      }
      .nav-link:hover { color: var(--avab-green); }
      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0 22px;
        border-radius: 999px;
        font-weight: 800;
        transition: var(--transition-smooth);
      }
      .button-primary {
        background: var(--avab-green);
        color: var(--avab-dark);
        box-shadow: 0 8px 18px rgba(143, 192, 37, 0.4);
      }
      .button-primary:hover { background: var(--avab-green-hover); }
      .button-secondary {
        border: 1px solid var(--avab-border);
        background: var(--avab-white);
      }
      .button-secondary:hover {
        border-color: var(--avab-green);
        color: var(--avab-green);
      }
      .breadcrumbs {
        border-bottom: 1px solid var(--avab-border);
      }
      .breadcrumbs ol {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 0;
        padding: 14px 0;
        list-style: none;
        color: var(--avab-dark-muted);
        font-size: 0.9rem;
      }
      .breadcrumbs li:not(:last-child)::after { content: '/'; margin-left: 8px; }
      .breadcrumbs a:hover { color: var(--avab-green); }
      .hero {
        position: relative;
        min-height: 600px;
        display: flex;
        align-items: center;
        background:
          linear-gradient(135deg, rgba(20, 24, 21, 0.82), rgba(20, 24, 21, 0.52)),
          url('https://images.unsplash.com/photo-1517649763962-0c623066013b?auto=format&fit=crop&w=1500&q=80') center/cover;
        color: #fff;
      }
      .hero .avab-container {
        width: min(calc(100% - 48px), var(--avab-max));
        margin: 0 auto;
        padding: 96px 0;
      }
      .hero-content {
        max-width: 780px;
      }
      .hero h1,
      .hero p,
      .hero .eyebrow { color: #fff; }
      .hero-actions {
        display: flex;
        gap: 16px;
        margin-top: 30px;
        flex-wrap: wrap;
      }
      .two-col {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 56px;
        align-items: center;
      }
      .image-wrapper {
        overflow: hidden;
        border-radius: var(--avab-radius);
        box-shadow: var(--avab-shadow-lg);
      }
      .image-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .bullet-list {
        margin: 0;
        padding: 0;
        list-style: none;
      }
      .bullet-list li {
        position: relative;
        margin-bottom: 14px;
        padding-left: 26px;
        color: var(--avab-dark-muted);
      }
      .bullet-list li::before {
        content: '→';
        position: absolute;
        left: 0;
        top: 0;
        color: var(--avab-green);
        font-weight: 800;
      }
      .env-grid,
      .flow-grid-horizontal,
      .proof-strip {
        display: grid;
        gap: 24px;
      }
      .env-grid { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
      .env-card,
      .flow-card,
      .proof-item,
      .ref-card {
        border: 1px solid var(--avab-border);
        border-radius: var(--avab-radius-sm);
        background: var(--avab-white);
        box-shadow: var(--avab-shadow-sm);
      }
      .env-card { padding: 28px; }
      .env-card h3 { margin-bottom: 12px; }
      .flow-grid-horizontal { grid-template-columns: repeat(4, 1fr); }
      .flow-card { padding: 24px; }
      .flow-card strong {
        display: block;
        min-height: 3rem;
        margin-bottom: 12px;
        color: var(--avab-green);
        font-size: 1.05rem;
      }
      .proof-strip {
        grid-template-columns: repeat(4, 1fr);
        margin-top: 24px;
      }
      .proof-item {
        padding: 20px;
        text-align: center;
      }
      .proof-item strong {
        display: block;
        color: var(--avab-green);
        font-size: 1.9rem;
      }
      .proof-item span {
        color: var(--avab-dark-muted);
        font-weight: 700;
      }
      .dark-card {
        background: linear-gradient(135deg, var(--avab-dark) 0%, #2a332c 60%, var(--avab-green) 100%);
        color: var(--avab-white);
        border-radius: var(--avab-radius);
        padding: 48px;
      }
      .dark-card h2,
      .dark-card p,
      .dark-card li,
      .dark-card h3 { color: var(--avab-white); }
      .cta-actions {
        display: flex;
        gap: 16px;
        margin-top: 24px;
        flex-wrap: wrap;
      }
      .button-light {
        background: var(--avab-white);
        color: var(--avab-dark);
      }
      .button-light:hover { background: var(--avab-light); }
      .faq-list details {
        border: 1px solid var(--avab-border);
        border-radius: var(--avab-radius-sm);
        background: var(--avab-white);
        box-shadow: var(--avab-shadow-sm);
        padding: 0 20px;
        margin-bottom: 14px;
      }
      .faq-list summary {
        list-style: none;
        cursor: pointer;
        padding: 18px 0;
        font-weight: 800;
      }
      .faq-list summary::-webkit-details-marker { display: none; }
      .faq-list p { padding: 0 0 18px; }
      @media (max-width: 900px) {
        .two-col,
        .flow-grid-horizontal,
        .proof-strip { grid-template-columns: 1fr 1fr; }
      }
      @media (max-width: 760px) {
        .two-col,
        .flow-grid-horizontal,
        .proof-strip,
        .env-grid { grid-template-columns: 1fr; }
        .hero { min-height: 480px; }
      }
    </style>
  </head>
  <body>
    <header class="site-nav">
      <div class="avab-container">
        <a class="brand" href="#">
          <span class="brand-dot" aria-hidden="true"></span>
          <span>AVAB</span>
        </a>
        <nav aria-label="Huvudnavigation">
          <ul class="nav-links">
            <li><a class="nav-link" href="#">Miljö</a></li>
            <li><a class="nav-link" href="#">Tjänster</a></li>
            <li><a class="nav-link" href="#">Kundcase</a></li>
            <li><a class="nav-link" href="#">Kontakt</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <nav class="breadcrumbs" aria-label="Brödsmulor">
      <div class="avab-container">
        <ol>
          <li><a href="#">Hem</a></li>
          <li><a href="#">Miljö</a></li>
          <li><span aria-current="page">Utomhusidrott</span></li>
        </ol>
      </div>
    </nav>

    <section class="hero">
      <div class="avab-container">
        <div class="hero-content">
          <div class="eyebrow">Utomhusidrott</div>
          <h1>Skapa en trygg, aktiv och hållbar idrottsytan utomhus.</h1>
          <p class="lead">
            Vi hjälper dig att utforma miljöer där rörelse, samspel och säker användning går hand i hand – från idé till färdig anläggning.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#kontakt">Boka en konsultation</a>
            <a class="button button-secondary" href="#lösningar">Se lösningar</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="avab-container two-col">
        <div>
          <div class="eyebrow">Varför AVAB</div>
          <h2>En utomhusmiljö byggd för rörelse och tillgänglighet.</h2>
          <p>
            Oavsett om du behöver en träningsyta för skolor, folkhälsa eller kommersiell verksamhet bygger vi miljöer som uppmuntrar aktivitet samtidigt som de är säkra, tydliga och långsiktigt hållbara.
          </p>
          <ul class="bullet-list">
            <li>Flexibla lösningar för aktiviteter och grupper av olika storlekter.</li>
            <li>Hög fokus på säkerhet, kostnadseffektivitet och enkel användning.</li>
            <li>Uppföljning och support efter leverans för att hålla lösningen relevant.</li>
          </ul>
        </div>
        <div class="image-wrapper">
          <img
            src="https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?auto=format&fit=crop&w=1200&q=80"
            alt="Idrott och rörelse utomhus"
          />
        </div>
      </div>
    </section>

    <section class="section section--light" id="lösningar">
      <div class="avab-container">
        <div class="section-heading">
          <div>
            <div class="eyebrow">Lösningar</div>
            <h2>Bygg en miljö som väcker aktivitet.</h2>
          </div>
          <p class="lead">
            Våra lösningar är skapade för att göra utemiljön enkel att använda, tydlig att navigera i och engagerande för varje deltagare.
          </p>
        </div>

        <div class="env-grid">
          {envCards.map((card) => (
            <article class="env-card">
              <h3>{card.title}</h3>
              <p>{card.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="avab-container">
        <div class="section-heading">
          <div>
            <div class="eyebrow">Process</div>
            <h2>Så går vi från behov till färdig miljö.</h2>
          </div>
        </div>

        <div class="flow-grid-horizontal">
          {flowCards.map((card) => (
            <article class="flow-card">
              <strong>{card.title}</strong>
              <span>{card.text}</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--light">
      <div class="avab-container">
        <div class="proof-strip">
          <div class="proof-item">
            <strong>100%</strong>
            <span>Anpassning efter målgrupp</span>
          </div>
          <div class="proof-item">
            <strong>24/7</strong>
            <span>Aktiv användning i praktiken</span>
          </div>
          <div class="proof-item">
            <strong>4 steg</strong>
            <span>Från behov till leverans</span>
          </div>
          <div class="proof-item">
            <strong>1 team</strong>
            <span>Helhetsansvar och support</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="avab-container">
        <div class="dark-card">
          <div class="eyebrow">Säkrare och smartare</div>
          <h2>Vill du skapa en idrotts- och aktivitetsyta som faktiskt används?</h2>
          <p>
            Vi hjälper er med koncept, planering, utrustning och anpassning så att din utomhusmiljö blir enkel att driva och tydlig att använda från dag ett.
          </p>
          <div class="cta-actions">
            <a class="button button-light" href="#kontakt">Kontakta oss</a>
            <a class="button button-secondary" href="#">Läs mer</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--light" id="kontakt">
      <div class="avab-container">
        <div class="section-heading">
          <div>
            <div class="eyebrow">Vanliga frågor</div>
            <h2>Snabba svar om utomhusidrottslösningar.</h2>
          </div>
        </div>

        <div class="faq-list">
          <details open>
            <summary>Hur anpassar ni lösningen efter vår verksamhet?</summary>
            <p>
              Vi kartlägger målgrupp, aktivitetsmönster, tillgänglighet och ett realistiskt användningsbehov innan vi rekommenderar utformning, utrustning och layout.
            </p>
          </details>
          <details>
            <summary>Kan lösningen vara flexibel över tid?</summary>
            <p>
              Ja. Vi arbetar gärna med modulära lösningar som kan utvecklas, kompletteras eller flyttas beroende på hur verksamheten förändras.
            </p>
          </details>
          <details>
            <summary>Vilka typer av miljöer passar er lösning?</summary>
            <p>
              Skolor, idrottsanläggningar, kommersiella fastigheter och offentliga miljöer är vanliga användare, men lösningen kan även anpassas till andra behov.
            </p>
          </details>
        </div>
      </div>
    </section>
  </body>
</html>
