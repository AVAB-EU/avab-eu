---
import SiteFooter from "../../../components/SiteFooter.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import "../../../styles/avab.css";

const breadcrumbItems = [
  { label: 'Hem', href: '/' },
  { label: 'Miljö', href: '/miljo' },
  { label: 'Ishall', href: '/miljo/ishall' },
];
---

<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AVAB | Ishall</title>
    <style>
      :root {
        --avab-green: #8fc025;
        --avab-green-hover: #9ed229;
        --avab-green-soft: rgba(143, 192, 37, 0.12);
        --avab-dark: #282e29;
        --avab-dark-muted: #3a433d;
        --avab-grey: #e9eae9;
        --avab-light: #f4f5f4;
        --avab-white: #ffffff;
        --avab-border: rgba(40, 46, 42, 0.1);
        --avab-shadow-sm: 0 4px 12px rgba(40, 46, 42, 0.05);
        --avab-shadow-lg: 0 24px 48px rgba(40, 46, 42, 0.12);
        --avab-radius: 24px;
        --avab-radius-sm: 16px;
        --avab-max: 1280px;
        --transition-smooth: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        color: var(--avab-dark);
        background: var(--avab-white);
        line-height: 1.65;
      }
      img { max-width: 100%; display: block; }
      a { color: inherit; text-decoration: none; }
      p { margin: 0 0 20px; color: var(--avab-dark-muted); font-size: 1.05rem; }
      h1, h2, h3 { margin: 0 0 16px; line-height: 1.15; color: var(--avab-dark); }
      h1 { font-size: clamp(2.3rem, 5vw, 4.6rem); }
      h2 { font-size: clamp(2rem, 4vw, 3rem); }
      h3 { font-size: 1.35rem; }
      ul { margin: 0; padding-left: 20px; }

      .skip-link {
        position: absolute;
        top: -100px;
        left: 16px;
        background: var(--avab-dark);
        color: #fff;
        padding: 12px 18px;
        border-radius: 999px;
        z-index: 50;
      }
      .skip-link:focus { top: 16px; }

      .avab-container {
        width: min(calc(100% - 48px), var(--avab-max));
        margin: 0 auto;
      }
      .section {
        padding: 80px 0;
        border-bottom: 1px solid var(--avab-border);
      }
      .section--light { background: var(--avab-light); }
      .two-col {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 56px;
        align-items: center;
      }
      .grid-3 {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 24px;
      }
      .site-nav {
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgba(255, 255, 255, 0.96);
        border-bottom: 1px solid var(--avab-border);
      }
      .site-nav .avab-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 72px;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-weight: 800;
        font-size: 1.2rem;
      }
      .brand-dot {
        width: 14px;
        height: 14px;
        border-radius: 4px;
        background: var(--avab-green);
        box-shadow: 0 0 0 4px var(--avab-green-soft);
      }
      .top-links {
        display: flex;
        gap: 18px;
        align-items: center;
        font-weight: 700;
        color: var(--avab-dark-muted);
      }
      .nav-button,
      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 22px;
        min-height: 44px;
        border-radius: 999px;
        background: var(--avab-green);
        color: var(--avab-dark);
        font-weight: 800;
        box-shadow: 0 8px 18px rgba(143, 192, 37, 0.35);
      }
      .button-secondary {
        background: transparent;
        border: 1px solid var(--avab-border);
        box-shadow: none;
      }

      .breadcrumbs {
        background: var(--avab-white);
        border-bottom: 1px solid var(--avab-border);
      }
      .breadcrumbs ol {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 0;
        padding: 14px 0;
        font-size: 0.9rem;
        color: var(--avab-dark-muted);
      }
      .breadcrumbs li::after {
        content: '/';
        margin-left: 8px;
        color: rgba(40, 46, 42, 0.35);
      }
      .breadcrumbs li:last-child::after { content: ''; }

      .hero {
        position: relative;
        min-height: 560px;
        display: flex;
        align-items: stretch;
        color: #fff;
        background:
          linear-gradient(90deg, rgba(17, 22, 18, 0.72), rgba(17, 22, 18, 0.28)),
          url('https://images.unsplash.com/photo-1574629810360-7efbbe195018?auto=format&fit=crop&w=1600&q=80') center/cover;
      }
      .hero .avab-container {
        width: min(calc(100% - 48px), var(--avab-max));
        display: grid;
        align-items: center;
        padding: 80px 0;
      }
      .hero-content {
        max-width: 680px;
        color: #fff;
      }
      .hero-content h1,
      .hero-content p,
      .hero-content .eyebrow {
        color: #fff;
      }
      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 0.9rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--avab-green);
        margin-bottom: 20px;
      }
      .eyebrow::before {
        content: '';
        width: 28px;
        height: 2px;
        background: currentColor;
      }
      .hero-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 28px;
      }
      .hero-pills a,
      .hero-pills span {
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        color: #fff;
        font-size: 0.9rem;
        font-weight: 700;
      }

      .value-grid,
      .env-grid,
      .flow-grid-horizontal,
      .pricing-grid,
      .video-text-layout,
      .bot-section,
      .roi-list {
        display: grid;
        gap: 24px;
      }
      .value-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .value-card,
      .env-card,
      .flow-card,
      .pricing-card,
      .roi-item {
        border: 1px solid var(--avab-border);
        border-radius: var(--avab-radius-sm);
        background: var(--avab-white);
        box-shadow: var(--avab-shadow-sm);
      }
      .value-card { padding: 28px; }
      .value-icon {
        width: 48px;
        height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: var(--avab-green-soft);
        margin-bottom: 16px;
      }
      .value-card p { margin-bottom: 0; }

      .proof-strip {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-top: 42px;
      }
      .proof-item {
        padding: 20px;
        background: var(--avab-light);
        border-radius: 16px;
      }
      .proof-item strong { display: block; font-size: 1.5rem; color: var(--avab-green); }
      .proof-item span { color: var(--avab-dark-muted); }

      .env-grid { grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); }
      .env-card { padding: 30px; position: relative; overflow: hidden; }
      .env-card::after {
        content: '→';
        position: absolute;
        right: 30px;
        bottom: 28px;
        font-size: 1.6rem;
        color: var(--avab-green);
      }
      .env-card h3 { margin-bottom: 10px; }
      .env-card p { margin-bottom: 0; }

      .flow-grid-horizontal { grid-template-columns: repeat(4, 1fr); }
      .flow-card { padding: 24px; }
      .flow-card strong {
        display: block;
        min-height: 3rem;
        margin-bottom: 12px;
        color: var(--avab-green);
      }
      .flow-card span { color: var(--avab-dark-muted); font-size: 0.95rem; }

      .compare-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 22px;
        overflow: hidden;
        border-radius: 16px;
      }
      .compare-table th,
      .compare-table td {
        padding: 16px 18px;
        border-bottom: 1px solid var(--avab-border);
        text-align: left;
      }
      .compare-table th {
        background: var(--avab-light);
      }
      .compare-table td:last-child { font-weight: 800; color: var(--avab-green); }

      .faq-list { display: grid; gap: 16px; }
      details.faq-item {
        border: 1px solid var(--avab-border);
        border-radius: 16px;
        background: var(--avab-white);
        box-shadow: var(--avab-shadow-sm);
        padding: 0 18px;
      }
      summary {
        cursor: pointer;
        list-style: none;
        padding: 18px 0;
        font-weight: 800;
      }
      summary::-webkit-details-marker { display: none; }
      details[open] summary { color: var(--avab-green); }
      details p { padding: 0 0 18px; margin: 0; }

      .cta-card {
        background: linear-gradient(135deg, var(--avab-dark) 0%, #2a332c 50%, var(--avab-green) 100%);
        border-radius: var(--avab-radius);
        padding: 48px;
        color: #fff;
      }
      .cta-card h2, .cta-card p, .cta-card li { color: #fff; }
      .cta-actions { display: flex; gap: 12px; margin-top: 24px; }
      .button-light {
        background: #fff;
        color: var(--avab-dark);
        box-shadow: none;
      }
      .guarantee-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        list-style: none;
        padding: 0;
        margin: 24px 0 0;
      }
      .guarantee-list li ::before {
        content: '✓';
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: var(--avab-green);
        color: var(--avab-dark);
        margin-right: 10px;
        font-size: 0.8rem;
        font-weight: 900;
      }
      .guarantee-list li {
        display: flex;
        align-items: center;
      }

      .site-footer {
        background: var(--avab-dark);
        color: #fff;
        padding: 64px 0 24px;
      }
      .footer-grid {
        display: grid;
        grid-template-columns: 1.4fr 1fr 1fr;
        gap: 32px;
      }
      .site-footer a { color: #fff; }
      .site-footer p, .site-footer li { color: rgba(255, 255, 255, 0.82); }
      .footer-list { list-style: none; padding: 0; }
      .footer-list li { margin-bottom: 10px; }
      .footer-bottom { margin-top: 26px; padding-top: 20px; border-top: 1px solid rgba(255, 255, 255, 0.14); }

      @media (max-width: 900px) {
        .two-col, .value-grid, .grid-3, .proof-strip, .flow-grid-horizontal, .footer-grid { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">Hoppa till innehåll</a>

    <header class="site-nav">
      <div class="avab-container">
        <div class="brand" aria-label="AVAB">
          <span class="brand-dot" aria-hidden="true"></span>
          <span>AVAB</span>
        </div>
        <nav class="top-links" aria-label="Huvudnavigering">
          <a href="#">Tjänster</a>
          <a href="#">Miljö</a>
          <a href="#">Kontakt</a>
          <a class="nav-button" href="#">Boka samtal</a>
        </nav>
      </div>
    </header>

    <nav class="breadcrumbs" aria-label="Brödsmulor">
      <div class="avab-container">
        <ol>
          {breadcrumbItems.map((item, index) => (
            <li>
              {index < breadcrumbItems.length - 1 ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
            </li>
          ))}
        </ol>
      </div>
    </nav>

    <main id="main">
      <section class="hero">
        <div class="avab-container">
          <div class="hero-content">
            <div class="eyebrow">Miljö & drift</div>
            <h1>Ishall med hög driftsäkerhet och trygg miljö</h1>
            <p>
              AVAB hjälper dig att skapa en ishall där prestation, säkerhet och energieffektivitet går hand i hand.
              Från planering till driftoptimering – med lösningar byggda för långa säsonger och hållbar tillväxt.
            </p>
            <div class="hero-pills" aria-label="Nyckelord">
              <a href="#">Klimatsmart teknik</a>
              <span>Smart uppvärmning</span>
              <span>Förbättrad vattenhantering</span>
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="avab-container two-col">
          <div>
            <div class="eyebrow">Varför AVAB</div>
            <h2>En lösning som balanserar sport, säkerhet och kostnad</h2>
            <p>
              Ishaller har högt krav på temperaturkontroll, energieffektivitet och långsiktig hållbarhet. Vi bygger tillsammans med dig en plan för att optimera både driftskostnader och användarupplevelse.
            </p>
            <p>
              Med tydliga konsekvenser för klimatanpassning, vattenflöden, underhåll och säkerhet skapar vi ett stabilt driftläge genom hela säsongen.
            </p>
          </div>
          <div>
            <div class="value-grid">
              <article class="value-card">
                <div class="value-icon" aria-hidden="true">⚡</div>
                <h3>Effektiv drift</h3>
                <p>Reducerade energi- och underhållskostnader genom smartare driftstrategier.</p>
              </article>
              <article class="value-card">
                <div class="value-icon" aria-hidden="true">🛡️</div>
                <h3>Säker miljö</h3>
                <p>Drift- och säkerhetsprocesser som är lättförståeliga för personal och användare.</p>
              </article>
              <article class="value-card">
                <div class="value-icon" aria-hidden="true">🌱</div>
                <h3>Hållbarhet</h3>
                <p>Smarta lösningar som minskar klimatavtryck utan att kompromissa med kvalitet.</p>
              </article>
            </div>
          </div>
        </div>
      </section>

      <section class="section section--light">
        <div class="avab-container">
          <div class="eyebrow">Resultat</div>
          <h2>Driftmässiga förbättringar som syns snabbt</h2>
          <div class="proof-strip">
            <div class="proof-item">
              <strong>18%</strong>
              <span>lägre energiförbrukning</span>
            </div>
            <div class="proof-item">
              <strong>32%</strong>
              <span>kortare driftstopp</span>
            </div>
            <div class="proof-item">
              <strong>24/7</strong>
              <span>förutsägbar övervakning</span>
            </div>
            <div class="proof-item">
              <strong>100%</strong>
              <span>tydlig ansvarsfördelning</span>
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="avab-container">
          <div class="eyebrow">Fokusområden</div>
          <h2>Byggd för både sport- och kommersiell användning</h2>
          <div class="env-grid">
            <article class="env-card">
              <h3>Vatten- och temperaturstyrning</h3>
              <p>Förutsägbara flöden och noggrann termisk kontroll för jämn iskvalitet och minskad körningstid.</p>
            </article>
            <article class="env-card">
              <h3>Energioptimering</h3>
              <p>Samordnade system och mätpunkter som hjälper dig att hitta energislöseri innan det påverkar verksamheten.</p>
            </article>
            <article class="env-card">
              <h3>Drift- och underhållsplanering</h3>
              <p>Tydliga rutiner, regelbundna inspektioner och proaktiva åtgärder som håller anläggningen i balans.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="section section--light">
        <div class="avab-container">
          <div class="eyebrow">Process</div>
          <h2>Så arbetar vi tillsammans</h2>
          <div class="flow-grid-horizontal">
            <article class="flow-card">
              <strong>1. Kartläggning</strong>
              <span>Vi går igenom aktuella behov, driftförutsättningar och befintliga system.</span>
            </article>
            <article class="flow-card">
              <strong>2. Design och plan</strong>
              <span>Vi definierar ett praktiskt och ekonomiskt hållbart sätt att lösa utmaningarna.</span>
            </article>
            <article class="flow-card">
              <strong>3. Implementering</strong>
              <span>Vi genomför och samordnar allt från teknikval till driftsrelaterade rutiner.</span>
            </article>
            <article class="flow-card">
              <strong>4. Förbättring och stöd</strong>
              <span>Vi följer upp, justerar och säkerställer att verksamheten håller hög standard.</span>
            </article>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="avab-container">
          <div class="eyebrow">Jämförelse</div>
          <h2>Vad skiljer en välfungerande ishall från en standardlösning?</h2>
          <table class="compare-table">
            <thead>
              <tr>
                <th>Område</th>
                <th>Standardlösning</th>
                <th>AVAB-lösning</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Temperaturstabilitet</td>
                <td>Varierande</td>
                <td>Kontrollerad och förutsägbar</td>
              </tr>
              <tr>
                <td>Energi</td>
                <td>Hög och svårförutsedd</td>
                <td>Optimerad och mätbar</td>
              </tr>
              <tr>
                <td>Underhåll</td>
                <td>Reaktivt</td>
                <td>Proaktivt och planerat</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="section section--light">
        <div class="avab-container">
          <div class="eyebrow">Vanliga frågor</div>
          <h2>Snabba svar om lösningar för ishallar</h2>
          <div class="faq-list">
            <details class="faq-item" open>
              <summary>Hur börjar vi med en ishall?</summary>
              <p>Vi börjar med att kartlägga avsedd användning, driftsmodell och befintliga utmaningar för att skapa en realistisk plan.</p>
            </details>
            <details class="faq-item">
              <summary>Kan lösningen anpassas efter befintlig anläggning?</summary>
              <p>Ja. Vi bygger ofta lösningar som passar nuvarande förutsättningar och samtidigt lägger en stabil grund för framtida utveckling.</p>
            </details>
            <details class="faq-item">
              <summary>Hur hållbar blir driften över tid?</summary>
              <p>Genom mätning, underhållsplanering och tydliga rutiner skapar vi en miljö som presterar konsekvent över säsonger.</p>
            </details>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="avab-container">
          <div class="cta-card">
            <div class="eyebrow">Nästa steg</div>
            <h2>Vill du se hur din ishall kan drivas smartare?</h2>
            <p>
              Låt oss hjälpa dig med en skräddarsydd lösning för drift, säkerhet, miljö och energiförbrukning.
            </p>
            <ul class="guarantee-list">
              <li>Förståelig och tydlig planering</li>
              <li>Fastställda driftsmål och ansvar</li>
              <li>Hållbar utveckling för varje säsong</li>
            </ul>
            <div class="cta-actions">
              <a class="button button-light" href="#">Boka en konsultation</a>
              <a class="button button-secondary" href="#">Läs mer</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="avab-container">
        <div class="footer-grid">
          <div>
            <div class="brand" aria-label="AVAB">
              <span class="brand-dot" aria-hidden="true"></span>
              <span>AVAB</span>
            </div>
            <p>Vi skapar hållbara och effektiva miljöer för idrott, drift och tillväxt.</p>
          </div>
          <div>
            <h3>Snabblänkar</h3>
            <ul class="footer-list">
              <li><a href="#">Hem</a></li>
              <li><a href="#">Tjänster</a></li>
              <li><a href="#">Miljö</a></li>
            </ul>
          </div>
          <div>
            <h3>Kontakt</h3>
            <ul class="footer-list">
              <li><a href="tel:+46000000000">+46 00 000 00 00</a></li>
              <li><a href="mailto:info@avab.se">info@avab.se</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <p>© 2026 AVAB. Alla rättigheter förbehållna.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
