  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://www.avab.eu/miljo/ishall/#webpage",
    "url": "https://www.avab.eu/miljo/ishall/",
    "name": "Ishall | Ljud, AV-teknik & matchupplevelse | AVAB",
    "description": "Ljud och AV-teknik för ishallar med fukttåliga högtalare, STI, EASE, matchintro, styrning, hörslinga och talat utrymningslarm.",
    "inLanguage": "sv-SE",
    "isPartOf": { "@type": "WebSite", "name": "AVAB", "url": "https://www.avab.eu/" },
    "datePublished": "2025-01-01",
    "dateModified": "2026-07-31",
    "speakable": {
      "@type": "SpeakableSpecification",
