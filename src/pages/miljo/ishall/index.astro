  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Ljud och AV-teknik för ishallar",
    "provider": {
      "@type": "LocalBusiness",
      "name": "AVAB",
      "url": "https://www.avab.eu/",
      "telephone": "+46548202080",
      "email": "info@avab.eu",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Skraggevägen 4",
        "postalCode": "663 41",
        "addressLocality": "Hammarö",
        "addressRegion": "Värmland",
        "addressCountry": "SE"
      }
    },
    "areaServed": "Sverige",
    "serviceType": [
      "Ljudsystem för ishall",
      "Passiva och IP-klassade högtalare",
      "EASE-simulering och STI-inmätning",
      "Matchintro och DMX-styrning",
      "Hörslinga och Auracast",
      "Talat utrymningslarm",
      "Styrsystem för sekretariat",
      "Projektering och dokumentation"
    ],
    "description": "AVAB projekterar, installerar och driftsätter kompletta AV-lösningar för ishallar med fukttåligt ljud, taluppfattbarhet, matchintro, styrning, tillgänglighet, utrymningslarm och dokumentation."
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Varför är taluppfattbarheten svår i en ishall?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Is, betong, plexiglas och plåttak reflekterar ljud och skapar lång efterklang. Därför behöver högtalarnas riktning, placering och nivå projekteras för taluppfattbarhet i stället för enbart hög ljudnivå."
        }
      },
      {
        "@type": "Question",
        "name": "Vilka högtalare passar i en kall och fuktig ishall?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "I själva hallen används normalt passiva högtalare med kapsling och material som är lämpade för miljön. Förstärkare och annan känslig elektronik placeras i ett tempererat teknikrum."
        }
      },
      {
        "@type": "Question",
        "name": "Vad betyder STI i en ishall?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "STI är ett mått på hur begripligt tal återges i lokalen. Projektering, simulering och inmätning används för att kontrollera att speaker och viktiga meddelanden går att förstå."
        }
      },
      {
        "@type": "Question",
        "name": "Kan matchintro, musik, ljus och måltuta styras tillsammans?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja. Med ett integrerat styrsystem kan förprogrammerade lägen starta musik, ljus, bild och andra effekter från sekretariatet med ett enkelt knapptryck."
        }
      },
      {
        "@type": "Question",
        "name": "Behöver en ishall hörslinga eller Auracast?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Tillgängligheten behöver bedömas för läktare, reception, konferensrum och andra publika ytor. Hörslinga kan vara rätt i vissa zoner och Auracast kan vara ett komplement där kompatibel utrustning används."
        }
      },
      {
        "@type": "Question",
        "name": "Kan elektriker installera efter AVAB:s underlag?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja. AVAB kan projektera, ta fram kabel- och installationsunderlag samt ansvara för driftsättning och inmätning. AVAB kan också leverera en komplett installation."
        }
      },
      {
        "@type": "Question",
        "name": "När bör AV-tekniken tas in i ett ishallsprojekt?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "AV-tekniken bör tas in innan kabelvägar, infästningar, rackplats, takarbeten och funktionskrav är låsta. Det minskar risken för sena kompletteringar och kostsamma ombyggnader."
        }
      }
    ]
  }
  </script>

