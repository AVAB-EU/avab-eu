    href="https://images.unsplash.com/photo-1580748141549-71748dbe0bdc?auto=format&fit=crop&q=80&w=1800">

  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Delad designsystem-CSS -->
  <!-- Sidspecifika komponenter -->
  <style>
    /* ---- Problem-/sammanfattningslista (kortrutor) ---- */
    .summary-list { display: grid; gap: 16px; list-style: none; margin: 0; }
    .summary-list li {
      padding: 22px 20px;
      border-radius: var(--avab-radius-sm);
      background: var(--avab-white);
      box-shadow: var(--avab-shadow-sm);
      font-size: 1rem;
      color: var(--avab-dark-muted);
      border: 1px solid var(--avab-border);
      line-height: 1.55;
    }
    .summary-list strong { display: block; margin-bottom: 8px; color: var(--avab-dark); font-size: 1.12rem; line-height: 1.2; }

    /* ---- Lösningskort med hover/fokus-expandering ---- */
    #losningar .solutions-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }


    /* ---- Synergi: flödeskort (grön etikett, ej numrerad) ---- */
    .flow-grid .flow-card strong { display: block; color: var(--avab-green); font-size: 1.05rem; line-height: 1.4; margin-bottom: 10px; }
    .flow-grid .flow-card span { display: block; color: var(--avab-dark-muted); font-size: 0.95rem; line-height: 1.5; }

    /* ---- FAQ-lista (enkolumn, dragspel via gemensam CSS) ---- */

    @media (max-width: 768px) {
      /* På mobil: visa lösningskortens innehåll direkt (inget hover) */
      .solution-expand-inner { opacity: 1; }
    }
    /* Mobilanpassning (beslut per sida, dokumenterat):
       - #utmaning (inledande problemnarrativ, sekundar fordjupning pa mobil)
       Huvudbudskap, losningssektion, referenser/bevisning, FAQ och CTA visas alltid. */
    @media (max-width: 768px) {
      #utmaning { display: none; }
    }



    /* ---- FAQ + CTA i samma sektion, enligt mastern pa sporthallssidan ---- */
    .faq-cta { padding-top: 48px; padding-bottom: 96px; }
    .faq-cta .compact-faq { margin-bottom: 64px; }
    .faq-heading { max-width: 760px; margin: 0 0 30px; text-align: left; }
    .faq-heading .eyebrow { margin-left: 0; margin-right: 0; }
    .faq-heading h2 { margin-bottom: 12px; max-width: 680px; }
    .compact-faq { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 28px; row-gap: 0; max-width: 1060px; margin: 0; }
    .compact-faq details.faq-item { padding: 20px 0; }
    .compact-faq summary { font-size: 1.05rem; }
    .compact-faq details.faq-item:nth-child(1),
    .compact-faq details.faq-item:nth-child(2) { border-top: 1px solid var(--avab-border); }
    @media (max-width: 768px) {
      .compact-faq { grid-template-columns: 1fr; }
      .compact-faq details.faq-item:nth-child(2) { border-top: none; }
    }

    /* ---- Losningskort (sidlokal, sjalvstandig stil) --------------------------
       Globala avab.css har tva motstridiga .solution-card::before-regler
       (4px topplist med opacity 0 + 8px sidolist utan opacity-aterstallning).
       Resultatet blir en osynlig accent som vid hover dyker upp som en liten
       gron fyrkant. Har definieras accent och hover explicit i stallet. */
    #losningar .solution-card {
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      padding: 34px 34px 34px 42px;
      border: 1px solid var(--avab-border);
      border-radius: var(--avab-radius);
      background: var(--avab-white);
      box-shadow: var(--avab-shadow-sm);
      transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }
    #losningar .solution-card::before {
      content: "";
      position: absolute;
      inset: 0 auto 0 0;
      width: 6px;
      height: auto;
      border-radius: 0;
      background: var(--avab-green);
      opacity: 1;
    }
    #losningar .solution-card:hover,
    #losningar .solution-card:focus-within {
      transform: translateY(-6px);
      border-color: rgba(143, 192, 37, 0.55);
      box-shadow: var(--avab-shadow-lg);
      background: var(--avab-white);
    }
    #losningar .solution-card:hover::before,
    #losningar .solution-card:focus-within::before { opacity: 1; }

    #losningar .solution-card h3 {
      margin-bottom: 12px;
      color: var(--avab-dark);
      font-size: 1.35rem;
      font-weight: 800;
      line-height: 1.25;
    }
    #losningar .solution-card .intro-text {
      margin-bottom: 22px;
      color: var(--avab-dark-muted);
      font-size: 1.02rem;
      line-height: 1.6;
    }

    /* Specifikationslista: etiketterna ar text, inte lankar */
    #losningar .spec-list {
      margin: 0 0 24px;
      padding: 18px 0 0;
      border-top: 1px solid var(--avab-border);
      list-style: none;
      display: grid;
      gap: 10px;
    }
    #losningar .spec-list li {
      position: relative;
      padding-left: 26px;
      color: var(--avab-dark-muted);
      font-size: 0.96rem;
      line-height: 1.5;
    }
    #losningar .spec-list li::before {
      content: "";
      position: absolute;
      top: 0.55em;
      left: 0;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--avab-green);
    }
    #losningar .spec-list strong { color: var(--avab-dark); font-weight: 800; }

    /* En tydlig tjanstelank per kort, i stallet for spridda etikettlankar */
    #losningar .solution-card .solution-link {
      align-self: flex-start;
      margin-top: auto;
      padding-bottom: 2px;
      border-bottom: 2px solid var(--avab-green);
      color: var(--avab-dark);
      font-weight: 800;
      font-size: 0.98rem;
      text-decoration: none;
    }
    #losningar .solution-card .solution-link::after { content: " →"; color: var(--avab-green); }
    #losningar .solution-card .solution-link:hover { color: var(--avab-green); border-bottom-color: var(--avab-dark); }

    @media (max-width: 768px) {
      #losningar .solutions-grid { grid-template-columns: 1fr; gap: 16px; }
      #losningar .solution-card { padding: 26px 26px 26px 32px; }
    }
  </style>
</head>
<body>
  <SiteHeader />

  <nav class="breadcrumbs" aria-label="Brödsmulor">
    <div class="avab-container">
      <ol>
        <li><a href="https://www.avab.eu/">Start</a></li>
        <li><a href="https://www.avab.eu/#miljoer">Miljöer</a></li>
        <li><span aria-current="page">Ishall</span></li>
      </ol>
    </div>
  </nav>

  <section class="hero" style="--hero-image:url('https://images.unsplash.com/photo-1580748141549-71748dbe0bdc?auto=format&fit=crop&q=80&w=1800');">
    <div class="avab-container">
      <div class="hero-inner animate-in">
        <div class="eyebrow">Ishall</div>

        <h1>Ljudsystem som övervinner ekot och kylan</h1>

        <p class="lead">
          Vi projekterar robust teknik för ishallar. Från fuktskyddad hårdvara och tempererade teknikrum till extrem direktivitet som garanterar en oslagbar stämning på läktaren.
        </p>

        <div class="hero-bottom">
          <div class="hero-actions">
            <a class="button button-primary" href="/kontakt/">Boka kostnadsfri rådgivning</a>
            <a class="button button-secondary" href="#losningar">Se lösningarna</a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="fact-band" aria-label="Snabbfakta ishall">
    <div class="fact-grid">
      <div class="fact"><span>Miljö</span><strong>Ishall</strong></div>
      <div class="fact"><span>Ljud</span><strong>Tal, matchintro och måltuta</strong></div>
      <div class="fact"><span>Material</span><strong>Passivt och IP-klassat</strong></div>
      <div class="fact"><span>Akustik</span><strong>EASE-simulering och STI</strong></div>
      <div class="fact"><span>Trygghet</span><strong>Talat utrymningslarm</strong></div>
      <div class="fact"><span>Leverans</span><strong>Projektering till drift</strong></div>
    </div>
  </section>
    <main id="main">
    <section class="section" id="utmaning">
      <div class="avab-container two-col">
        <div class="animate-in">
          <div class="eyebrow">Verkligheten</div>
          <h2>Ett akustiskt inferno</h2>
          <p class="lead-dark">En ishall är en av de svåraste miljöerna att bygga ljud för. Stora ytor av is, betong, plåttak och plexiglas fungerar som speglar för ljudet, vilket skapar en massiv efterklang. Orden flyter ihop och informationen försvinner.</p>
          <p class="lead-dark">Ovanpå detta tillkommer fukten och kylan som obönhörligt bryter ner felvald elektronik. Lösningen är inte högre volym, utan smartare kabeldragning, passiva system och kirurgisk precision i ljudets riktning.</p>
        </div>

        <aside class="animate-in">
          <ul class="summary-list">
            <li>
              <strong>Kondens förstör aktiv elektronik</strong>
              Ett vanligt misstag är att använda aktiva högtalare i hallen. Kondensdroppar från taket kortsluter dem snabbt. Vi bygger alltid med passiva system och gömmer elektroniken i varma teknikrum.
            </li>
            <li>
              <strong>Att höra är inte att förstå</strong>
              Ett system med hög volym är värdelöst om orden grötas ihop av ekon från isen. Vi projekterar efter mätbar taluppfattbarhet (STI).
            </li>
            <li>
              <strong>Matchintro under press</strong>
              För en komplett upplevelse krävs att musik, måltuta, belysning och effekter synkar – och att sekretariatet enkelt kan styra det.
            </li>
          </ul>
        </aside>
      </div>
    </section>

    <section class="section section--light" id="losningar">
      <div class="avab-container">
        <div class="section-heading animate-in">
          <div>
            <div class="eyebrow">Våra lösningar</div>
            <h2>Det digitala ekosystemet</h2>
            <p class="lead-dark">Här är de fyra pelarna som gör er ishall redo för allt från konståkning till elitderby.</p>
          </div>
        </div>

        <div class="solutions-grid">
          <article class="solution-card">
            <h3>Fukttåliga system</h3>
            <p class="intro-text">Genom att använda passiva, IP-klassade högtalare ute i hallen och placera förstärkarna i ett plusgradigt teknikrum eliminerar vi risken för fuktskador.</p>
            <ul class="spec-list">
              <li><strong>Ljud:</strong> Passiva och IP-klassade högtalare</li>
              <li><strong>Infrastruktur:</strong> Rätt dimensionerade kablar</li>
              <li><strong>Driftsäkerhet:</strong> Förstärkare i tempererade rum</li>
            </ul>
            <a class="solution-link" href="/tjanster/ljudsystem/">Läs mer om ljudsystem</a>
          </article>

          <article class="solution-card">
            <h3>Garanterad taluppfattbarhet</h3>
            <p class="intro-text">Vi designar system med extrem direktivitet. Ljudet "skjuts" exakt på publiken istället för att studsa okontrollerat mot isen och plexiglaset.</p>
            <ul class="spec-list">
              <li><strong>Mätning:</strong> STIPA-analys</li>
              <li><strong>EASE:</strong> Akustisk 3D-simulering av arenan</li>
              <li><strong>Tillgänglighet:</strong> Slingor för publik med nedsatt hörsel</li>
            </ul>
            <a class="solution-link" href="/tjanster/taluppfattbarhet/">Läs mer om taluppfattbarhet</a>
          </article>

          <article class="solution-card">
            <h3>Matchintro &amp; upplevelse</h3>
            <p class="intro-text">Bygg upp stämningen i hallen. Vi integrerar dånande mållåtar, nedsläckt ljus, moving heads och måltutor i ett enda smidigt gränssnitt.</p>
            <ul class="spec-list">
              <li><strong>Effekter:</strong> DMX-styrd belysning och rök</li>
              <li><strong>Kraft:</strong> Subwoofers för tryck i musiken</li>
              <li><strong>Bild:</strong> Synkning med jumbotron / LED</li>
            </ul>
            <a class="solution-link" href="/tjanster/styrsystem-integration/">Läs mer om styrsystem och integration</a>
          </article>

          <article class="solution-card">
            <h3>Trygghet &amp; utrymningslarm</h3>
            <p class="intro-text">Ett ishockeyderby har enorma ljudvolymer. Vid fara måste talade instruktioner kunna bryta igenom publikens jubel utan fördröjning.</p>
            <ul class="spec-list">
              <li><strong>TUL:</strong> Talat utrymningslarm i EN 54-standard</li>
              <li><strong>Prioritet:</strong> Larmet stänger automatiskt av musiken</li>
              <li><strong>Säkerhet:</strong> Kameror för crowd-control</li>
            </ul>
            <a class="solution-link" href="/tjanster/talat-utrymningslarm/">Läs mer om talat utrymningslarm</a>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="referenser">
      <div class="avab-container">
        <div class="section-heading animate-in">
          <div>
            <div class="eyebrow">Referenser</div>
            <h2>Teknik som tål minusgrader</h2>
            <p class="lead-dark">AVAB arbetar med ishallar, arenor, sporthallar och andra publika miljöer där ljud, styrning och säkerhet måste fungera i tuffa förhållanden. Närliggande sidor: <a class="text-link" href="/miljo/sporthall-arena/">sporthall &amp; arena</a>, <a class="text-link" href="/miljo/simhall/">simhall</a> och <a class="text-link" href="/tjanster/taluppfattbarhet/">taluppfattbarhet</a>.</p>
          </div>
        </div>
        <div class="ref-grid">
          <article class="ref-card animate-in">
            <img src="/assets/Hammaro ishall 1200x900.webp" alt="Hammarö ishall ljudsystem och akustik" width="1200" height="900" loading="lazy" decoding="async">
            <div class="ref-content">
              <h3>Hammarö ishall, Värmland</h3>
              <p>Vi projekterade och installerade ett komplett ljudsystem i Hammarös hjärta. Genom att använda rätt riktade passiva högtalare kunde vi maximera taluppfattbarheten (STI) trots hallens utmanande, hårda ytor.</p>
            </div>
          </article>
          <article class="ref-card animate-in">
            <img src="/assets/Kils ishall 1200x900.webp" alt="Modern ishall under hockeymatch med ljud och ljuseffekter" width="1200" height="900" loading="lazy" decoding="async">
            <div class="ref-content">
              <h3>Fler projekt</h3>
              <p>Här presenterar vi nästa ishallsprojekt – exempelvis Crestron-styrda matchintron, dånande måltutor eller zonerat ljud mellan VIP-loger och huvudläktare. <a class="text-link" href="/kontakt/">Vill ni bli vår nästa referens?</a></p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="section section--light faq-cta" id="faq">
      <div class="avab-container">
        <div class="faq-heading">
          <div class="eyebrow">Kunskap</div>
          <h2>Vanliga frågor om ishallar</h2>
        </div>

        <div class="compact-faq">
          <details class="faq-item" open>
            <summary>Varför ekar det så mycket i en ishall?</summary>
            <p>En ishall består nästan uteslutande av hårda, reflekterande ytor: betong, plexiglas, plåttak och is. När vanligt ljud träffar dessa ytor studsar det okontrollerat. Vi löser detta med akustiska 3D-simuleringar (EASE) och högtalare som riktar ljudet exakt mot publiken istället för mot isen.</p>
          </details>
          <details class="faq-item">
            <summary>Varför går högtalare ofta sönder i ishallar?</summary>
            <p>Ett vanligt och dyrt misstag är att installera aktiva högtalare (med inbyggd förstärkare och elektronik) ute i hallen. Kondens i taket bildar droppar som ramlar rakt ner i elektroniken och kortsluter den. Lösningen är att använda passiva, IP-klassade högtalare och dra rätt dimensionerade kablar till ett teknikrum som håller plusgrader, där förstärkarna står säkert.</p>
          </details>
          <details class="faq-item">
            <summary>Kan vi få ett riktigt matchintro med ljus och måltuta?</summary>
            <p>Absolut. Vi integrerar DMX-styrning för belysning, moving heads och måltutor. Allt styrs enkelt från sekretariatet via en touchpanel, där 'Matchintro' startar allt med ett enda knapptryck.</p>
          </details>
