  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "AV-teknik för industri och logistik",
    "provider": {
      "@type": "LocalBusiness",
      "name": "AVAB",
      "url": "https://www.avab.eu/",
      "telephone": "+46548202080",
      "email": "info@avab.eu",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Skraggevägen 4",
        "postalCode": "663 41",
        "addressLocality": "Hammarö",
        "addressRegion": "Värmland",
        "addressCountry": "SE"
      }
    },
    "areaServed": "Sverige",
    "serviceType": [
      "AV-teknik för industri och logistik",
      "Zonstyrda utrop och ljudsystem",
      "Kameraövervakning och incidentsökning",
      "ANPR och integration vid grindar",
      "Talat utrymningslarm",
      "Mötesrum och informationsskärmar",
      "Styrsystem och integration",
      "Projektering, installation och dokumentation"
    ],
    "description": "AVAB projekterar, installerar och driftsätter robusta AV-lösningar för industri och logistik med zonstyrda utrop, ljud, kameraövervakning, ANPR, mötesteknik, informationsskärmar, styrning och dokumentation."
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Vilken AV-teknik behöver en industri- eller logistikanläggning?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Behovet styrs av verksamheten, men vanliga delar är zonstyrda utrop, högtalare för bullriga miljöer, kameraövervakning, grind- och ANPR-integration, informationsskärmar, mötesteknik, styrning samt tydlig dokumentation."
        }
      },
      {
        "@type": "Question",
        "name": "Hur får man tydliga utrop i en bullrig produktionshall?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Systemet behöver dimensioneras efter bullernivå, lokalens akustik, maskiner, arbetszoner och meddelandets betydelse. Rätt högtalartyp, placering, riktning, signalbehandling och inmätning är viktigare än att bara öka effekten."
        }
      },
      {
        "@type": "Question",
        "name": "Kan signaler och utrop delas mellan olika hallar och skift?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja. Produktion, lager, lastzon, kontor och utomhusytor kan få egna zoner, scheman, meddelanden och behörigheter. Systemet kan även ge manuella live-utrop där verksamheten behöver det."
        }
      },
      {
        "@type": "Question",
        "name": "Är vanliga driftutrop samma sak som talat utrymningslarm?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Nej. Driftutrop, skiftsignaler och informationsmeddelanden är verksamhetsfunktioner. Ett certifierat talat utrymningslarm är ett separat säkerhetssystem som projekteras, övervakas och dokumenteras efter de krav som gäller för anläggningen."
        }
      },
      {
        "@type": "Question",
        "name": "Kan kamera och ANPR integreras med grindar och bommar?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja, tekniskt kan nummerplåtsigenkänning och kamerahändelser kopplas till passage, grindar och logistikflöden. Lösningen behöver projekteras tillsammans med behörigheter, säkerhetslogik, nätverk och verksamhetens integritetsrutiner."
        }
      },
      {
        "@type": "Question",
        "name": "Tål utrustningen damm, fukt, temperaturväxlingar och vibrationer?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Utrustningen väljs efter den verkliga miljön. IP-klass, temperaturintervall, korrosionsrisk, vibrationer, rengöring, montage och kabelskydd behöver bedömas var för sig eftersom en IP-klass inte beskriver alla belastningar."
        }
      },
      {
        "@type": "Question",
        "name": "När bör AV-tekniken tas in i industriprojektet?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ta in AV innan kabelvägar, nätverk, teknikrum, grindar, takmontage, elmatning och säkerhetsgränssnitt är låsta. Tidig samordning minskar ombyggnad och gör systemet enklare att installera, testa och förvalta."
        }
      }
    ]
  }
  </script>

