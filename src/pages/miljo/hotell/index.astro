  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "AV-teknik för hotell och konferensanläggningar",
    "provider": {
      "@type": "LocalBusiness",
      "name": "AVAB",
      "url": "https://www.avab.eu/",
      "telephone": "+46548202080",
      "email": "info@avab.eu",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Skraggevägen 4",
        "postalCode": "663 41",
        "addressLocality": "Hammarö",
        "addressRegion": "Värmland",
        "addressCountry": "SE"
      }
    },
    "areaServed": "Sverige",
    "serviceType": [
      "Ljudsystem för hotell",
      "Zonstyrd bakgrundsmusik",
      "Konferensteknik och hybridmöten",
      "Digital signage och vägvisning",
      "Styrsystem och scenarier",
      "Dante och nätverksljud",
      "Hörslinga och tillgängligt ljud",
      "Kameraövervakning för hotell",
      "Projektering och dokumentation"
    ],
    "description": "AVAB projekterar, installerar och driftsätter kompletta AV-lösningar för hotell, resort och konferensanläggningar med zonstyrt ljud, bild, konferensteknik, digital signage, styrsystem, tillgänglighet och säkerhet."
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Vilken AV-teknik behöver ett hotell?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ett hotell behöver ofta zonstyrt ljud för lobby, restaurang, bar, spa och gemensamma ytor, konferensteknik, digitala informationsskärmar, enkel central styrning samt tillgänglighets- och säkerhetslösningar."
        }
      },
      {
        "@type": "Question",
        "name": "Hur får man olika ljud i restaurang, bar och spa?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Hotellet delas in i separata ljudzoner. Varje zon får egen musik, volym och tidsschema så att restaurangen kan vara lugn samtidigt som baren eller eventytan har mer energi."
        }
      },
      {
        "@type": "Question",
        "name": "Kan personalen styra hela hotellets AV-system enkelt?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja. Ett gemensamt styrsystem kan samla ljud, bild, scenarier och zoner i en touchpanel eller app med tydliga driftlägen för exempelvis frukost, konferens, middag och event."
        }
      },
      {
        "@type": "Question",
        "name": "Hur bygger man konferensrum som gästerna kan använda själva?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Rummet behöver ett konsekvent användarflöde där skärm, kamera, mikrofoner och ljud startar med ett tryck eller när gästen ansluter sin dator. Tekniken anpassas efter rummets storlek och om det kan delas med vikvägg."
        }
      },
      {
        "@type": "Question",
        "name": "Går det att integrera hotellets befintliga teknik?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ofta går det att återanvända delar av den befintliga tekniken och knyta samman dem med nytt DSP-, nätverks- eller styrsystem. Först inventeras funktion, ålder, gränssnitt och framtida behov."
        }
      },
      {
        "@type": "Question",
        "name": "Behöver hotell och konferenslokaler hörslinga eller Auracast?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Tillgängligheten ska planeras utifrån lokalens användning och krav. Hörslinga kan behövas i konferensrum, reception eller eventytor, medan Auracast kan vara ett komplement där kompatibel utrustning används."
        }
      },
      {
        "@type": "Question",
        "name": "När bör AV-tekniken tas in i ett hotellprojekt?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "AV-tekniken bör tas in innan tak, inredning, kabelvägar, rackplatser, nätverk och konferensrummens möblering är låsta. Det ger diskretare montage och minskar sena kompletteringar."
        }
      }
    ]
  }
  </script>

