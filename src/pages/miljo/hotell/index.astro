  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://www.avab.eu/miljo/hotell/#webpage",
    "url": "https://www.avab.eu/miljo/hotell/",
    "name": "Hotell & konferens | Ljud, bild och styrning | AVAB",
    "description": "AV-teknik för hotell och resort med zonstyrt ljud, konferensteknik, digital signage, styrsystem, hörslinga, nätverksljud och kameraövervakning.",
    "inLanguage": "sv-SE",
    "isPartOf": { "@type": "WebSite", "name": "AVAB", "url": "https://www.avab.eu/" },
    "datePublished": "2025-01-01",
    "dateModified": "2026-08-03",
