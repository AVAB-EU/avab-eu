  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "AV-teknik för kontor och konferensrum",
    "provider": {
      "@type": "LocalBusiness",
      "name": "AVAB",
      "url": "https://www.avab.eu/",
      "telephone": "+46548202080",
      "email": "info@avab.eu",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Skraggevägen 4",
        "postalCode": "663 41",
        "addressLocality": "Hammarö",
        "addressRegion": "Värmland",
        "addressCountry": "SE"
      }
    },
    "areaServed": "Sverige",
    "serviceType": [
      "Konferensteknik",
      "Hybridmötesrum",
      "Takmikrofoner och DSP",
      "AI-kameror och videobars",
      "BYOM och trådlös presentation",
      "Skärmar och projektorer",
      "Styrsystem för mötesrum",
      "AV-over-IP och central övervakning",
      "Hörslinga och tillgängligt ljud",
      "Projektering och dokumentation"
    ],
    "description": "AVAB projekterar, installerar och driftsätter kompletta AV-lösningar för kontor, mötesrum och konferensmiljöer med hybridmöten, ljud, bild, BYOM, styrning, tillgänglighet och dokumentation."
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Vad behöver ett modernt konferensrum för AV-teknik?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ett modernt konferensrum behöver vanligtvis skärm, kamera, mikrofoner, högtalare, anslutning för användarens dator och ett enkelt sätt att starta mötet. Exakt lösning anpassas efter rummets storlek, akustik och arbetssätt."
        }
      },
      {
        "@type": "Question",
        "name": "Vad innebär BYOM?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "BYOM betyder Bring Your Own Meeting. Användaren ansluter sin egen dator och använder rummets professionella kamera, mikrofoner, högtalare och skärm i exempelvis Teams, Zoom eller Google Meet."
        }
      },
      {
        "@type": "Question",
        "name": "Behövs mikrofoner även i mindre mötesrum?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja, distansdeltagarna behöver en tydlig och jämn upptagning av alla som sitter i rummet. En videobar kan räcka i mindre rum, medan större rum ofta behöver separata bords- eller takmikrofoner och DSP med ekosläckning."
        }
      },
      {
        "@type": "Question",
        "name": "Kan alla mötesrum få samma användarflöde?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja. Genom att standardisera anslutning, styrning, bokningspaneler och mötesplattform kan små och stora rum få ett enhetligt arbetssätt som minskar supportbehovet."
        }
      },
      {
        "@type": "Question",
        "name": "Kan AV-systemen övervakas centralt?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja. Nätverksanslutna system kan ge status, felmeddelanden och användningsdata så att driftorganisationen kan upptäcka problem och planera service innan nästa möte påverkas."
        }
      },
      {
        "@type": "Question",
        "name": "Behöver konferensrum hörslinga eller Auracast?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Tillgängligheten ska bedömas utifrån lokalens användning och krav. Hörslinga kan vara rätt i vissa mötesrum och receptionsytor, medan Auracast kan vara ett komplement där kompatibel utrustning används."
        }
      },
      {
        "@type": "Question",
        "name": "När bör konferenstekniken tas in i byggprojektet?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "AV-tekniken bör tas in innan möblering, kabelvägar, eluttag, nätverk, tak, väggar och skärmplacering är låsta. Det minskar risken för synliga kablar, fel kameravinklar och sena kompletteringar."
        }
      }
    ]
  }
  </script>

