  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://www.avab.eu/miljo/kontor-konferens/#webpage",
    "url": "https://www.avab.eu/miljo/kontor-konferens/",
    "name": "Kontor & konferens | Mötesrum, ljud & styrning | AVAB",
    "description": "AV-teknik för kontor och konferensrum med hybridmöten, takmikrofoner, AI-kameror, BYOM, skärmar, styrsystem och central drift.",
    "inLanguage": "sv-SE",
    "isPartOf": { "@type": "WebSite", "name": "AVAB", "url": "https://www.avab.eu/" },
    "datePublished": "2025-01-01",
    "dateModified": "2026-07-31",
    "speakable": {
      "@type": "SpeakableSpecification",
