---
import { getCollection } from "astro:content";
import ReferencePage from "../../../layouts/ReferencePage.astro";

const reference = (await getCollection("references")).find(
  (entry) => entry.data.slug === "/referenser/ekhagsskolan-dals-langed/",
);

if (!reference) {
  throw new Error("Referensen Ekhagsskolan, Dals Långed saknas i content collection.");
}
---

<ReferencePage reference={reference} />
