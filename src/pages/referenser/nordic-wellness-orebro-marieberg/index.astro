---
import { getCollection } from "astro:content";
import ReferencePage from "../../../layouts/ReferencePage.astro";

const reference = (await getCollection("references")).find(
  (entry) => entry.data.slug === "/referenser/nordic-wellness-orebro-marieberg/",
);

if (!reference) {
  throw new Error("Referensen Nordic Wellness Marieberg saknas i content collection.");
}
---

<ReferencePage reference={reference} />
