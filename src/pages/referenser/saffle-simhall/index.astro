---
import { getCollection } from "astro:content";
import PageCTA from "../../../components/PageCTA.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import ReferenceFacts from "../../../components/references/ReferenceFacts.astro";
import ReferenceHero from "../../../components/references/ReferenceHero.astro";
import ReferenceScale from "../../../components/references/ReferenceScale.astro";
import ReferenceLegacyCta from "../../../components/references/ReferenceLegacyCta.astro";
import RelatedReferences from "../../../components/references/RelatedReferences.astro";
import ReferenceAnchorNav from "../../../components/references/ReferenceAnchorNav.astro";
import ReferenceFaq from "../../../components/references/ReferenceFaq.astro";
import ReferenceFeatureSplit from "../../../components/references/ReferenceFeatureSplit.astro";
import ReferenceMediaGrid from "../../../components/references/ReferenceMediaGrid.astro";
import { absoluteUrl, SITE_URL } from "../../../config/site";
import "../../../styles/avab.css";
import "../../../styles/reference-page.css";

const reference = (await getCollection("references")).find(
  (entry) => entry.data.slug === "/referenser/saffle-simhall/",
);

if (!reference) throw new Error("Referensen Säffle simhall saknas i content collection.");

const data = reference.data;
const images = {
  poolHero: "/assets/saffle-simhall-50m-bassang.webp",
  poolRight: "/assets/saffle-simhall-50m-bassang-hoger.webp",
  poolRight2: "/assets/saffle-simhall-50m-bassang-hoger-2.webp",
  poolAntennas: "/assets/saffle-simhall-50m-bassang-hoger-antenner.webp",
  poolLeft: "/assets/saffle-simhall-50m-bassang-vanster.webp",
  poolLeft2: "/assets/saffle-simhall-50m-bassang-vanster-2.webp",
  poolLeft3: "/assets/saffle-simhall-50m-bassang-vanster-3.webp",
  childrenPool: "/assets/saffle-simhall-barnpool.webp",
  childrenCave: "/assets/saffle-simhall-barnpool-grotta.webp",
  sauna: "/assets/saffle-simhall-bastu.webp",
  cafeEntrance: "/assets/saffle-simhall-cafe-entre.webp",
  cafeUpper: "/assets/saffle-simhall-cafe-vaning2.webp",
  connectionPanel: "/assets/saffle-simhall-inkopplings-panel.webp",
  multihallSpeaker: "/assets/saffle-simhall-multihall-hogtalare.webp",
  multihallProjector: "/assets/saffle-simhall-multihall-projektor.webp",
  relaxDmx: "/assets/saffle-simhall-relax-dmx.webp",
  relax: "/assets/saffle-simhall-relax.webp",
  rackDmx: "/assets/saffle-simhall-teknikrack-dmx.webp",
  rackMic: "/assets/saffle-simhall-teknikrack-mikrofon.webp",
  rack: "/assets/saffle-simhall-teknikrack.webp",
  touch1: "/assets/saffle-simhall-touchpanel-1.webp",
  touch2: "/assets/saffle-simhall-touchpanel-2.webp",
} as const;

const pageData = {
  ...data,
  heroImage: {
    src: images.poolHero,
    alt: "50-metersbassängen i Säffle simhall",
    width: 1600,
    height: 1067,
    objectPosition: "center",
  },
};

const canonicalUrl = absoluteUrl(data.slug);
const heroImageUrl = absoluteUrl(images.poolHero);
const publishedDate = data.publishedDate.toISOString().slice(0, 10);
const updatedDate = "2026-08-18";
const robots = data.draft || data.seo.noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large";
const seoTitle = data.seo.title;
const seoDescription = data.seo.description;
const ogTitle = "Säffle simhall – samlad styrning av ljud, ljus och tillgänglighet";

const faqItems = [
  { q: "Vad levererade AVAB till Säffle simhall?", a: "AVAB levererade, monterade och driftsatte Crestronstyrning, RGB-belysning och ljudsystem. Projektet omfattade också trådlösa mikrofonsystem och hörslingor i utvalda delar av anläggningen." },
  { q: "Vad styrs med Crestron i Säffle simhall?", a: "Crestron används som gemensamt gränssnitt för att hantera ljud, belysning och hörslingor." },
  { q: "Hur löstes mikrofontäckningen i 50-metersbassängen?", a: "Det trådlösa mikrofonsystemet kompletterades med två mikrofonantenner för att ge täckning i den 50 meter långa bassängmiljön." },
  { q: "Var installerades ljudsystem?", a: "Ljudsystem installerades i tävlingsbassängen, multipoolen, barnpoolen, relaxavdelningen och kiosk/café." },
  { q: "Var installerades hörslingor?", a: "Hörslingor installerades i konferensrum och på läktare." },
  { q: "Hur är belysningen i relaxavdelningen uppbyggd?", a: "Relaxavdelningen har RGB-belysning och DMX-styrda, vattenkylda armaturer." },
  { q: "När färdigställdes projektet?", a: "Projektet färdigställdes i december 2019. Assemblin El AB var beställare och Säfflebostäder AB var slutkund." },
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${canonicalUrl}#article`,
      headline: ogTitle,
      description: seoDescription,
      datePublished: publishedDate,
      dateModified: updatedDate,
      inLanguage: "sv-SE",
      image: [heroImageUrl],
      author: { "@type": "Organization", name: "AVAB", url: `${SITE_URL}/` },
      publisher: { "@type": "Organization", name: "AVAB", url: `${SITE_URL}/` },
      mainEntityOfPage: { "@id": `${canonicalUrl}#webpage` },
      contentLocation: { "@type": "Place", name: "Säffle simhall", address: { "@type": "PostalAddress", addressLocality: "Säffle", addressRegion: "Värmland", addressCountry: "SE" } },
      about: [
        { "@type": "Thing", name: "AV-teknik för simhall" },
        { "@type": "Thing", name: "Crestronstyrning" },
        { "@type": "Thing", name: "Ljudsystem" },
        { "@type": "Thing", name: "Hörslinga" },
        { "@type": "Thing", name: "RGB- och DMX-belysning" },
        ...data.archive.technologies.map((name) => ({ "@type": "Thing", name })),
      ],
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: seoTitle,
      description: seoDescription,
      inLanguage: "sv-SE",
      isPartOf: { "@type": "WebSite", name: "AVAB", url: `${SITE_URL}/` },
      breadcrumb: { "@id": `${canonicalUrl}#breadcrumb` },
      dateModified: updatedDate,
      hasPart: [
        { "@type": "WebPageElement", name: "Uppdraget", url: `${canonicalUrl}#uppdraget` },
        { "@type": "WebPageElement", name: "50-metersbassängen", url: `${canonicalUrl}#bassang-ljud` },
        { "@type": "WebPageElement", name: "Styrning och tillgänglighet", url: `${canonicalUrl}#styrning-tillganglighet` },
        { "@type": "WebPageElement", name: "Relax och ljus", url: `${canonicalUrl}#relax-ljus` },
        { "@type": "WebPageElement", name: "Helheten", url: `${canonicalUrl}#helheten` },
      ],
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Start", item: `${SITE_URL}/` },
        { "@type": "ListItem", position: 2, name: "Referenser", item: absoluteUrl("/referenser/") },
        { "@type": "ListItem", position: 3, name: "Säffle simhall", item: canonicalUrl },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      mainEntity: faqItems.map((item) => ({ "@type": "Question", name: item.q, acceptedAnswer: { "@type": "Answer", text: item.a } })),
    },
  ],
};

const cta = data.cta;
const renderPageCta = Boolean(cta?.enabled && cta.variant === "page" && cta.title && cta.primaryLabel && cta.primaryHref);
const renderLegacyCta = Boolean(cta?.enabled && cta.variant === "legacy");
const anchors = [
  { href: "#uppdraget", label: "Uppdraget", shortLabel: "Uppdrag" },
  { href: "#bassang-ljud", label: "50-metersbassängen", shortLabel: "Bassängen" },
  { href: "#styrning-tillganglighet", label: "Styrning & tillgänglighet", shortLabel: "Styrning" },
  { href: "#relax-ljus", label: "Relax & ljus", shortLabel: "Relax" },
  { href: "#helheten", label: "Helheten", shortLabel: "Helheten" },
];
---
<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta name="robots" content={robots} />
    <meta name="author" content="AVAB" />
    <meta name="theme-color" content="#282E29" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:site_name" content="AVAB" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={heroImageUrl} />
    <meta property="article:published_time" content={publishedDate} />
    <meta property="article:modified_time" content={updatedDate} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={heroImageUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="image" fetchpriority="high" href={images.poolHero} />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body class={`reference-page reference-page--${data.layout} reference-page--saffle`}>
    <SiteHeader />
    <nav class="reference-breadcrumbs" aria-label="Brödsmulor">
      <div class="avab-container"><ol><li><a href="/">Start</a></li><li><a href="/referenser/">Referenser</a></li><li><span aria-current="page">Säffle simhall</span></li></ol></div>
    </nav>
    <main id="main">
      <ReferenceHero data={pageData} variant="immersive" kicker="Referens · Säffle simhall" primaryLabel="Utforska projektet" primaryHref="#uppdraget" />
      <ReferenceFacts facts={data.facts} />
      {data.scale && <ReferenceScale scale={data.scale} />}

      <section class="saffle-case" aria-labelledby="case-study-title" data-reference-anchor-scope>
        <div class="case-intro-wrap"><div class="avab-container"><header class="case-intro">
          <span class="case-kicker">Projektet på djupet</span>
          <h2 id="case-study-title">En simhall där ljud, ljus och tillgänglighet samlas i samma styrning</h2>
          <p>Säffle simhall består av flera miljöer med olika behov: 50-metersbassäng, multipool, barnpool, relax, multihall och kiosk/café. AVAB:s uppdrag var att leverera, montera och driftsätta en lösning där centrala AV-funktioner kan hanteras på ett sammanhållet sätt.</p>
        </header></div></div>
        <ReferenceAnchorNav items={anchors} />

        <div class="case-content">
          <section class="case-section" id="uppdraget" data-case-section><div class="avab-container case-section__inner">
            <div class="case-copy"><span class="case-kicker">01 · Uppdraget</span><h2>Vad omfattade AVAB:s leverans till Säffle simhall?</h2>
              <p class="case-answer"><strong>AVAB levererade, monterade och driftsatte Crestronstyrning, RGB-belysning och ljudsystem, kompletterat med trådlösa mikrofoner och hörslingor.</strong></p>
              <p>Assemblin El AB var beställare och Säfflebostäder AB slutkund. Projektet färdigställdes i december 2019. Ljudsystemet skulle fungera i tävlingsbassäng, multipool, barnpool, relax och kiosk/café, samtidigt som ljud, belysning och hörslingor skulle kunna nås från en gemensam styrning.</p>
            </div>
            <ReferenceMediaGrid items={[
              { src: images.cafeEntrance, title: "Entré och café som en del av helheten", text: "Kiosk/café ingick i de ytor där AVAB installerade ljudsystem.", alt: "Entré och café i Säffle simhall", width: 900, height: 600 },
              { src: images.cafeUpper, title: "Ljud även på caféets övre plan", text: "Projektet omfattar flera publika ytor utanför själva bassängrummen.", alt: "Café på övre plan i Säffle simhall", width: 900, height: 600 },
            ]} columns={2} ratio="land" split={false} />
          </div></section>

          <section class="case-section" id="bassang-ljud" data-case-section><div class="avab-container case-section__inner">
            <div class="case-copy"><span class="case-kicker">02 · 50-metersbassängen</span><h2>Hur löstes ljud och trådlösa mikrofoner över den stora bassängytan?</h2>
              <p class="case-answer"><strong>50-metersbassängen fick ljudsystem och trådlösa mikrofoner. Två mikrofonantenner användes för att ge täckning i den långa bassängmiljön.</strong></p>
              <p>En 50-metersbassäng innebär långa avstånd och en verksamhet där information och aktiviteter behöver fungera från olika delar av rummet. Systemets delar behöver därför placeras för den faktiska ytan, inte bara för teknikrummet.</p>
            </div>
            <ReferenceFeatureSplit image={{ src: images.poolAntennas, alt: "Mikrofonantenner vid 50-metersbassängen i Säffle simhall", width: 900, height: 600 }} kicker="Trådlös täckning" title="Två antenner för mikrofonerna i 50-metersbassängen" text="Antennerna kompletterar det trådlösa mikrofonsystemet och ger täckning över den stora bassängmiljön." reverse />
            <ReferenceMediaGrid items={[
              { src: images.poolRight, title: "Bassängmiljön från höger sida", text: "Ljudsystemet ska nå en lång och öppen publik miljö.", alt: "50-metersbassängen i Säffle simhall sedd från höger sida", width: 900, height: 600 },
              { src: images.poolRight2, title: "Installation över hela bassänglängden", text: "Placering och täckning behöver fungera från kortsida till kortsida.", alt: "50-metersbassängen i Säffle simhall med vy längs bassängen", width: 900, height: 600 },
              { src: images.poolLeft, title: "Samma rum från motsatt sida", text: "De olika vyerna visar skalan i den färdiga 50-metersmiljön.", alt: "50-metersbassängen i Säffle simhall sedd från vänster sida", width: 900, height: 600 },
            ]} columns={3} ratio="land" split={false} />
            <ReferenceMediaGrid items={[
              { src: images.poolLeft2, title: "Ljud för aktivitet och information", text: "Systemet ska fungera i den dagliga driften oavsett var aktiviteten sker.", alt: "Översikt över 50-metersbassängen i Säffle simhall", width: 900, height: 600 },
              { src: images.poolLeft3, title: "En stor akustiskt krävande miljö", text: "Bassängrummets storlek och hårda ytor ställer höga krav på hur ljudet distribueras.", alt: "50-metersbassängen i Säffle simhall med läktare och bassängyta", width: 900, height: 600 },
            ]} columns={2} ratio="land" split={false} />
          </div></section>

          <section class="case-section" id="styrning-tillganglighet" data-case-section><div class="avab-container case-section__inner">
            <div class="case-copy"><span class="case-kicker">03 · Styrning & tillgänglighet</span><h2>Hur samlades ljud, ljus och hörslingor för personalen?</h2>
              <p class="case-answer"><strong>Crestronstyrningen samlar ljud, belysning och hörslingor i ett gemensamt gränssnitt. Hörslingor installerades i konferensrum och på läktare.</strong></p>
              <p>En stor anläggning blir snabbt svår att använda om varje delsystem har sin egen kontroll. Styrningen gör att personalen kan nå rätt funktion från ett sammanhållet gränssnitt, samtidigt som teknikrack och anslutningspunkter samlar infrastrukturen bakom användarvyn.</p>
            </div>
            <ReferenceFeatureSplit image={{ src: images.rack, alt: "Teknikrack för AV-systemet i Säffle simhall", width: 900, height: 1348 }} kicker="Tekniken bakom gränssnittet" title="Central teknik samlad i rack" text="Styrning, ljud och andra delsystem möts bakom kulisserna medan personalen arbetar i ett betydligt enklare gränssnitt." variant="portrait" />
            <ReferenceMediaGrid items={[
              { src: images.touch1, title: "Touchpanel för daglig styrning", text: "Crestronpanelen ger personalen åtkomst till de funktioner som behövs i anläggningen.", alt: "Crestron touchpanel i Säffle simhall", width: 900, height: 601 },
              { src: images.touch2, title: "Funktioner samlade i samma gränssnitt", text: "Olika delar av anläggningen kan nås utan separata användargränssnitt för varje tekniksystem.", alt: "Styrvy på Crestron touchpanel i Säffle simhall", width: 900, height: 601 },
              { src: images.connectionPanel, title: "Tydlig anslutningspunkt", text: "Inkopplingspanelen ger en praktisk väg in i systemet för den utrustning som används på plats.", alt: "Inkopplingspanel för AV-system i Säffle simhall", width: 900, height: 600 },
            ]} columns={3} ratio="land" split={false} />
            <ReferenceMediaGrid items={[
              { src: images.rackDmx, title: "DMX i teknikmiljön", text: "Ljusstyrningen är en del av den samlade tekniska infrastrukturen.", alt: "DMX-utrustning i teknikrack i Säffle simhall", width: 900, height: 601 },
              { src: images.rackMic, title: "Trådlösa mikrofonsystem i racket", text: "Mikrofoninfrastrukturen samlas centralt och kompletteras av antenner ute i bassängmiljön.", alt: "Mikrofonutrustning i teknikrack i Säffle simhall", width: 900, height: 601 },
            ]} columns={2} ratio="land" split={false} />
          </div></section>

          <section class="case-section" id="relax-ljus" data-case-section><div class="avab-container case-section__inner">
            <div class="case-copy"><span class="case-kicker">04 · Relax & ljus</span><h2>Hur kombinerades ljud och styrd färgbelysning i relaxavdelningen?</h2>
              <p class="case-answer"><strong>Relaxavdelningen ingår i ljudsystemet och kompletterades med RGB-belysning samt DMX-styrda, vattenkylda armaturer.</strong></p>
              <p>I relaxmiljön blir ljuset en tydlig del av upplevelsen. Den styrda RGB-belysningen kan förändra rummets karaktär medan DMX ger kontroll över de vattenkylda armaturerna. Barnpool och bastu visar samtidigt hur samma anläggning rymmer flera helt olika miljöer.</p>
            </div>
            <ReferenceFeatureSplit image={{ src: images.relaxDmx, alt: "Relaxpool i Säffle simhall med styrd färgbelysning", width: 900, height: 600 }} kicker="RGB och DMX" title="Färgbelysningen förändrar hela relaxmiljön" text="De DMX-styrda, vattenkylda armaturerna är en del av relaxavdelningens RGB-lösning." reverse />
            <ReferenceMediaGrid items={[
              { src: images.relax, title: "Relaxavdelningen i den färdiga miljön", text: "Ljud och belysning integreras utan att tekniken behöver dominera rummet.", alt: "Relaxavdelning med pool i Säffle simhall", width: 900, height: 600 },
              { src: images.childrenPool, title: "Barnpoolen är en egen ljudmiljö", text: "Barnpoolen är en av verksamhetsytorna där AVAB installerade ljudsystem.", alt: "Barnpool i Säffle simhall", width: 900, height: 600 },
              { src: images.childrenCave, title: "Lekmiljö med grotta", text: "Barnpoolens olika delar visar varför ljudet behöver fungera över mer än en enkel öppen bassängyta.", alt: "Grotta i barnpoolen i Säffle simhall", width: 900, height: 600 },
            ]} columns={3} ratio="land" split={false} />
            <ReferenceMediaGrid items={[
              { src: images.sauna, title: "Bastu i relaxavdelningen", text: "Relaxdelen består av flera sammanhängande miljöer med en lugnare karaktär än tävlingsbassängen.", alt: "Bastu i Säffle simhall", width: 900, height: 600 },
            ]} columns={1} ratio="land" />
          </div></section>

          <section class="case-section" id="helheten" data-case-section><div class="avab-container case-section__inner">
            <div class="case-copy"><span class="case-kicker">05 · Helheten</span><h2>Vad blir resultatet när flera AV-funktioner behandlas som ett system?</h2>
              <p class="case-answer"><strong>Personalen får en gemensam styrlogik samtidigt som ljud, mikrofoner, hörslingor, belysning och presentationsteknik kan anpassas efter olika delar av anläggningen.</strong></p>
              <p>Tävlingsbassängen behöver lång mikrofontäckning. Relaxen behöver styrt ljus. Konferensrum och läktare behöver hörslinga. Kiosk/café behöver ljud. Multihallen har sin egen högtalare och projektor. Funktionerna är olika, men användaren ska inte behöva uppleva dem som separata tekniköar.</p>
            </div>
            <ReferenceMediaGrid items={[
              { src: images.multihallSpeaker, title: "Högtalare i multihallen", text: "Multihallen är ytterligare en miljö där tekniken behöver integreras i verksamhetsytan.", alt: "Installerad högtalare i multihallen i Säffle simhall", width: 900, height: 601 },
              { src: images.multihallProjector, title: "Projektor i multihallen", text: "Projektorn kompletterar multihallens tekniska lösning och visar bredden i projektet.", alt: "Projektor i multihallen i Säffle simhall", width: 900, height: 600 },
            ]} columns={2} ratio="land" split={false} />
          </div></section>
        </div>
      </section>

      {data.relatedReferences && <RelatedReferences related={data.relatedReferences} />}
      <ReferenceFaq id="vanliga-fragor" eyebrow="Vanliga frågor om projektet" title="Säffle simhall – ljud, styrning, hörslingor och RGB-belysning" lead="Snabba svar om AVAB:s leverans och lösningen i Säffle simhall." items={faqItems.map(({ q, a }) => ({ question: q, answer: a }))} />
      {renderPageCta && cta && <PageCTA eyebrow={cta.eyebrow} title={cta.title!} text={cta.text} primaryLabel={cta.primaryLabel!} primaryHref={cta.primaryHref!} secondaryLabel={cta.secondaryLabel} secondaryHref={cta.secondaryHref} points={cta.points} flush />}
      {renderLegacyCta && cta && cta.variant === "legacy" && <ReferenceLegacyCta cta={cta} />}
    </main>
    <SiteFooter />
    <style>
      .saffle-case { padding: 0; background: var(--avab-white); border-top: 1px solid var(--avab-border); border-bottom: 1px solid var(--avab-border); }
      .case-intro-wrap { background: var(--avab-white); }
      .case-content, .case-section__inner { min-width: 0; }
      .case-intro { max-width: 850px; margin-bottom: 0; padding: var(--avab-section-space) 0; }
      .case-intro h2 { max-width: 22ch; margin: 0 0 16px; }
      .case-intro p { max-width: 78ch; margin: 0; color: var(--avab-dark-muted); }
      .case-section { scroll-margin-top: 76px; margin: 0; padding: var(--avab-section-space) 0; border-bottom: 0; background: var(--avab-white); }
      .case-section:nth-child(even) { background: var(--avab-light); }
      .case-copy { max-width: 850px; margin-bottom: var(--avab-content-gap); }
      .case-copy h2 { max-width: 24ch; margin: 0 0 16px; }
      .case-copy p { max-width: 78ch; }
