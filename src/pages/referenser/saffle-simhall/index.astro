---
import SiteFooter from "../../../components/SiteFooter.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import "../../../styles/avab.css";

const siteUrl = "https://avab.eu";
const canonicalUrl = `${siteUrl}/referenser/saffle-simhall/`;

const heroImage = {
  src: `${siteUrl}/wp-content/uploads/2023/02/1920x1080-Saffle-simhall-50m-hogt-palm-vatten-parkering-2-1536x864.webp`,
  alt: "Säffle simhalls 50-metersbassäng med AVAB:s ljudinstallation",
  width: 1536,
  height: 864,
};

const gallery = [
  {
    src: `${siteUrl}/wp-content/uploads/2023/02/1920x1080-Saffle-simhall-50m-hogt-palm-vatten-parkering-2-1024x576.webp`,
    alt: "50-metersbassängen i Säffle simhall med högtalare längs bassängen",
    caption:
      "Ljudet längs 50-metersbassängen projekterades för tydlig information och jämn täckning i en akustiskt krävande miljö.",
    width: 1024,
    height: 576,
  },
  {
    src: `${siteUrl}/wp-content/uploads/2023/02/1920x1080-Saffle-simhall-reception-1024x576.webp`,
    alt: "Receptionen i Säffle simhall",
    caption:
      "I receptionen samlas viktiga driftfunktioner i ett gemensamt och lättillgängligt gränssnitt.",
    width: 1024,
    height: 576,
  },
  {
    src: `${siteUrl}/wp-content/uploads/2023/02/1920x1080-Saffle-simhall-relax-1024x576.webp`,
    alt: "Relaxavdelningen i Säffle simhall med färgsatt belysning",
    caption:
      "Relaxavdelningen har en egen ljudmiljö och DMX-styrd belysning anpassad för verksamheten.",
    width: 1024,
    height: 576,
  },
  {
    src: `${siteUrl}/wp-content/uploads/2023/02/1920x1080-Saffle-simhall-barnpool-1024x576.webp`,
    alt: "Barnpoolen i Säffle simhall med styrd miljöbelysning",
    caption:
      "Barnpoolen är en separat zon där ljud och miljöbelysning kan anpassas utan att påverka övriga delar av anläggningen.",
    width: 1024,
    height: 576,
  },
];

const scope = [
  "AV-projektering och systemdesign",
  "Ljudspridning, taluppfattbarhet och zonindelning",
  "Kabel- och systemritningar",
  "Leverans och installation av ljudsystem",
  "Trådlösa mikrofoner och antennlösning",
  "Hörslingor vid läktare och konferensytor",
  "Crestronprogrammering och systemintegration",
  "Styrning av KNX- och DMX-funktioner",
  "Provning, driftsättning och dokumentation",
];

const scale = [
  { value: "7", label: "huvudsakliga ljudområden" },
  { value: "50+", label: "högtalare i anläggningen" },
  { value: "2", label: "mikrofonantenner" },
  { value: "2", label: "läktarområden med hörslinga" },
  { value: "1", label: "gemensamt Crestrongränssnitt" },
];

const relevance = [
  "Publik anläggning med många användargrupper och flera samtidiga verksamheter.",
  "Fuktig och korrosiv miljö med höga krav på material, infästningar och livslängd.",
  "Ljud, hörslingor och kabelvägar som behövde projekteras innan konstruktionerna stängdes.",
  "Integration mellan AV, KNX, DMX och anslutna driftfunktioner.",
  "Samordning med bygg-, el- och automationsentreprenörer under flera projektskeden.",
  "Krav på enkel användning för personal utan specialistkunskap inom AV-teknik.",
];

const relatedReferences = [
  {
    href: "/referenser/sorby-sporthall-kumla/",
    title: "Sörby idrottshall, Kumla",
    text: "Crestron, Dante, mikrofoner och LED-vägg i en hall som fungerar både delad och som helsal.",
    image: "/assets/sporthall-interior-linjer.webp",
    alt: "Sörby idrottshall i Kumla",
  },
  {
    href: "/referenser/sannerudshallen-kil/",
    title: "Sannerudshallen, Kil",
    text: "Omprojekterat ishallsljud med riktade högtalare och separat styrning.",
    image: "/assets/ishall-hogtalare-ovan-is.webp",
    alt: "Sannerudshallen i Kil",
  },
  {
    href: "/referenser/minnebergsskolan-arvika/",
    title: "Minnebergsskolan, Arvika",
    text: "Aula, undervisningsmiljöer, mikrofoner, hörslingor, Crestron, DMX och Dante.",
    image: "/assets/modern-trafasad-innergard.webp",
    alt: "Minnebergsskolan i Arvika",
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${canonicalUrl}#article`,
      headline: "Säffle simhall – samlad styrning för ljud, ljus och tillgänglighet",
      description:
        "Referens om AVAB:s projektering, installation och driftsättning av Crestronstyrning, zonindelat ljud, mikrofoner, hörslingor, projektor och miljöbelysning i Säffle simhall.",
      datePublished: "2026-06-23",
      dateModified: "2026-08-03",
      inLanguage: "sv-SE",
      image: gallery.map((image) => image.src),
      author: {
        "@type": "Organization",
        name: "AVAB",
        url: `${siteUrl}/`,
      },
      publisher: {
        "@type": "Organization",
        name: "AVAB",
        url: `${siteUrl}/`,
      },
      mainEntityOfPage: {
        "@id": `${canonicalUrl}#webpage`,
      },
      about: [
        { "@type": "Thing", name: "AV-teknik i simhall" },
        { "@type": "Thing", name: "Crestron styrsystem" },
        { "@type": "Thing", name: "Zonindelat ljudsystem" },
        { "@type": "Thing", name: "Hörslinga" },
      ],
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: "Säffle simhall – Crestron, ljud och hörslinga | Referens | AVAB",
      description:
        "Så projekterade och installerade AVAB en samlad lösning för ljud, styrning, hörslingor och miljöbelysning i Säffle simhall.",
      inLanguage: "sv-SE",
      isPartOf: {
        "@type": "WebSite",
        name: "AVAB",
        url: `${siteUrl}/`,
      },
      breadcrumb: {
        "@id": `${canonicalUrl}#breadcrumb`,
      },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Start",
          item: `${siteUrl}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Referenser",
          item: `${siteUrl}/referenser/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Säffle simhall",
          item: canonicalUrl,
        },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Säffle simhall – Crestron, ljud och hörslinga | Referens | AVAB</title>
    <meta
      name="description"
      content="Så projekterade och installerade AVAB Crestronstyrning, zonindelat ljud, mikrofoner, hörslingor och miljöbelysning i Säffle simhall."
    />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="AVAB" />
    <meta name="theme-color" content="#282E29" />

    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="article" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:site_name" content="AVAB" />
    <meta
      property="og:title"
      content="Säffle simhall – samlad styrning för ljud, ljus och tillgänglighet"
    />
    <meta
      property="og:description"
      content="AVAB ansvarade för projektering, installation och driftsättning av en samlad AV-lösning i Säffle simhall."
    />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={heroImage.src} />
    <meta property="og:image:width" content={String(heroImage.width)} />
    <meta property="og:image:height" content={String(heroImage.height)} />
    <meta property="og:image:alt" content={heroImage.alt} />
    <meta property="article:published_time" content="2026-06-23" />
    <meta property="article:modified_time" content="2026-08-03" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Säffle simhall – Crestron, ljud och hörslinga | AVAB"
    />
    <meta
      name="twitter:description"
      content="En inköparorienterad referens om AVAB:s ansvar, omfattning, genomförande och resultat i Säffle simhall."
    />
    <meta name="twitter:image" content={heroImage.src} />
    <meta name="twitter:image:alt" content={heroImage.alt} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://avab.eu" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      rel="preload"
      as="image"
      fetchpriority="high"
      href={heroImage.src}
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    ></script>

    <style>
      :root {
        --reference-ink: #1f2521;
        --reference-muted: #59615b;
        --reference-line: rgba(40, 46, 42, 0.14);
        --reference-soft: #f6f7f5;
        --reference-green-soft: rgba(143, 192, 37, 0.12);
      }

      .reference-page {
        background: var(--avab-white);
      }

      .reference-page p {
        max-width: 72ch;
      }

      .reference-breadcrumbs {
        border-bottom: 1px solid var(--reference-line);
        background: var(--avab-white);
      }

      .reference-breadcrumbs ol {
        min-height: 52px;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        list-style: none;
        font-size: 0.84rem;
        color: var(--reference-muted);
      }

      .reference-breadcrumbs li:not(:last-child)::after {
        content: "/";
        margin-left: 8px;
        color: rgba(40, 46, 42, 0.35);
      }

      .reference-breadcrumbs a:hover {
        color: var(--avab-green);
      }

      .reference-hero {
        padding: clamp(48px, 7vw, 88px) 0;
        border-bottom: 1px solid var(--reference-line);
        background:
          radial-gradient(circle at 10% 20%, var(--reference-green-soft), transparent 28%),
          var(--avab-white);
      }

      .reference-hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(420px, 1.1fr);
        gap: clamp(36px, 6vw, 88px);
        align-items: center;
      }

      .reference-kicker {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
        color: var(--avab-dark-muted);
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .reference-kicker::before {
        content: "";
        width: 34px;
        height: 3px;
        border-radius: 999px;
        background: var(--avab-green);
      }

      .reference-hero h1 {
        max-width: 12ch;
        margin: 0 0 20px;
        color: var(--reference-ink);
        font-size: clamp(2.8rem, 5.8vw, 5.6rem);
        font-weight: 800;
        line-height: 0.98;
        letter-spacing: -0.055em;
      }

      .reference-hero-subtitle {
        max-width: 19ch;
        margin-bottom: 20px;
        color: var(--reference-ink);
        font-size: clamp(1.25rem, 2vw, 1.75rem);
        font-weight: 700;
        line-height: 1.35;
      }

      .reference-hero-lead {
        max-width: 57ch;
        margin-bottom: 30px;
        color: var(--reference-muted);
        font-size: 1.08rem;
      }

      .reference-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
      }

      .reference-image {
        position: relative;
        overflow: hidden;
        border-radius: clamp(18px, 3vw, 34px);
        background: var(--avab-grey);
        box-shadow: 0 28px 70px rgba(40, 46, 42, 0.16);
      }

      .reference-image::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        border: 1px solid rgba(255, 255, 255, 0.35);
        border-radius: inherit;
      }

      .reference-image img {
        width: 100%;
        min-height: 500px;
        object-fit: cover;
      }

      .reference-image-badge {
        position: absolute;
        left: 22px;
        bottom: 22px;
        max-width: calc(100% - 44px);
        padding: 12px 16px;
        border: 1px solid rgba(255, 255, 255, 0.55);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.88);
        backdrop-filter: blur(12px);
        color: var(--reference-ink);
        font-size: 0.82rem;
        font-weight: 800;
      }

      .reference-facts {
        border-bottom: 1px solid var(--reference-line);
        background: var(--reference-soft);
      }

      .reference-facts-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
      }

      .reference-fact {
        min-width: 0;
        padding: 24px 22px;
        border-right: 1px solid var(--reference-line);
      }

      .reference-fact:first-child {
        border-left: 1px solid var(--reference-line);
      }

      .reference-fact span {
        display: block;
        margin-bottom: 7px;
        color: var(--reference-muted);
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.07em;
        text-transform: uppercase;
      }

      .reference-fact strong {
        display: block;
        color: var(--reference-ink);
        font-size: 0.98rem;
        line-height: 1.38;
      }

      .reference-section {
        padding: clamp(64px, 8vw, 108px) 0;
        border-bottom: 1px solid var(--reference-line);
      }

      .reference-section--soft {
        background: var(--reference-soft);
      }

      .reference-section-heading {
        max-width: 760px;
        margin-bottom: 42px;
      }

      .reference-section-heading h2 {
        margin-bottom: 16px;
        font-size: clamp(2rem, 4vw, 3.35rem);
        letter-spacing: -0.035em;
      }

      .reference-section-heading p {
        margin-bottom: 0;
        color: var(--reference-muted);
      }

      .reference-summary-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        border-top: 1px solid var(--reference-line);
        border-bottom: 1px solid var(--reference-line);
      }

      .reference-summary {
        padding: 34px 34px 34px 0;
      }

      .reference-summary + .reference-summary {
        padding-left: 34px;
        border-left: 1px solid var(--reference-line);
      }

      .reference-summary-number {
        display: block;
        margin-bottom: 22px;
        color: var(--avab-green);
        font-size: 0.76rem;
        font-weight: 900;
        letter-spacing: 0.08em;
      }

      .reference-summary h3 {
        margin-bottom: 14px;
        font-size: clamp(1.35rem, 2vw, 1.8rem);
      }

      .reference-summary p {
        margin: 0;
        color: var(--reference-muted);
        font-size: 1rem;
      }

      .reference-content-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 340px;
        gap: clamp(48px, 7vw, 96px);
        align-items: start;
      }

      .reference-article {
        min-width: 0;
      }

      .reference-block + .reference-block {
        margin-top: 72px;
        padding-top: 72px;
        border-top: 1px solid var(--reference-line);
      }

      .reference-block h2 {
        max-width: 18ch;
        margin-bottom: 18px;
        font-size: clamp(1.8rem, 3vw, 2.75rem);
        letter-spacing: -0.025em;
      }

      .reference-block h3 {
        margin: 30px 0 12px;
        font-size: 1.25rem;
      }

      .reference-block p {
        color: var(--reference-muted);
      }

      .scope-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0 28px;
        margin-top: 26px;
        padding-inline: clamp(18px, 3vw, 28px);
        list-style: none;
        border-top: 1px solid var(--reference-line);
      }

      .scope-list li {
        position: relative;
        padding: 17px 0 17px 28px;
        border-bottom: 1px solid var(--reference-line);
        color: var(--reference-ink);
        font-weight: 700;
      }

      .scope-list li::before {
        content: "✓";
        position: absolute;
        left: 0;
        color: var(--avab-green);
        font-weight: 900;
      }

      .project-boundary {
        margin-top: 30px;
        padding: 24px;
        border-left: 5px solid var(--avab-green);
        border-radius: 0 var(--avab-radius-sm) var(--avab-radius-sm) 0;
        background: var(--reference-soft);
      }

      .project-boundary strong {
        display: block;
        margin-bottom: 8px;
        color: var(--reference-ink);
      }

      .project-boundary p {
        margin: 0;
        font-size: 0.98rem;
      }

      .process-list {
        display: grid;
        gap: 0;
        margin-top: 30px;
        list-style: none;
        border-top: 1px solid var(--reference-line);
      }

      .process-list li {
        display: grid;
        grid-template-columns: 48px minmax(0, 1fr);
        gap: 22px;
        padding: 24px 0;
        border-bottom: 1px solid var(--reference-line);
      }

      .process-number {
        width: 42px;
        height: 42px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: var(--reference-green-soft);
        color: var(--reference-ink);
        font-weight: 900;
      }

      .process-list h3 {
        margin: 0 0 7px;
        font-size: 1.15rem;
      }

      .process-list p {
        margin: 0;
        font-size: 0.98rem;
      }

      .reference-sidebar {
        position: sticky;
        top: calc(var(--avab-nav-height) + 24px);
        padding: 28px;
        border: 1px solid var(--reference-line);
        border-radius: var(--avab-radius-sm);
        background: var(--avab-white);
        box-shadow: var(--avab-shadow-sm);
      }

      .reference-sidebar h2 {
        margin-bottom: 24px;
        font-size: 1.25rem;
      }

      .sidebar-facts {
        margin: 0;
      }

      .sidebar-facts div {
        padding: 15px 0;
        border-top: 1px solid var(--reference-line);
      }

      .sidebar-facts dt {
        margin-bottom: 4px;
        color: var(--reference-muted);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .sidebar-facts dd {
        margin: 0;
        color: var(--reference-ink);
        font-weight: 700;
      }

      .sidebar-action {
        width: 100%;
        margin-top: 24px;
      }

      .scale-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 14px;
        margin-top: 38px;
      }

      .scale-item {
        min-height: 150px;
        padding: 24px 20px;
        border: 1px solid var(--reference-line);
        border-radius: var(--avab-radius-sm);
        background: var(--avab-white);
      }

      .scale-item strong {
        display: block;
        margin-bottom: 10px;
        color: var(--reference-ink);
        font-size: clamp(1.7rem, 3vw, 2.65rem);
        line-height: 1;
      }

      .scale-item span {
        color: var(--reference-muted);
        font-size: 0.9rem;
        line-height: 1.35;
      }

      .reference-quote {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 250px;
        gap: 48px;
        align-items: end;
        padding: clamp(34px, 5vw, 58px);
        border-radius: var(--avab-radius);
        background: var(--avab-dark);
        color: var(--avab-white);
      }

      .reference-quote blockquote {
        margin: 0;
      }

      .reference-quote blockquote p {
        max-width: 38ch;
        margin: 0;
        color: var(--avab-white);
        font-size: clamp(1.25rem, 2.3vw, 1.75rem);
        font-weight: 600;
        line-height: 1.55;
      }

      .reference-quote footer {
        color: rgba(255, 255, 255, 0.72);
        font-size: 0.93rem;
      }

      .reference-quote footer strong {
        display: block;
        margin-bottom: 4px;
        color: var(--avab-white);
        font-size: 1.05rem;
      }

      .gallery-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 28px;
      }

      .gallery-grid figure {
        margin: 0;
      }

      .gallery-image {
        overflow: hidden;
        border-radius: var(--avab-radius-sm);
        background: var(--avab-grey);
      }

      .gallery-image img {
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .gallery-image:hover img {
        transform: scale(1.025);
      }

      .gallery-grid figcaption {
        padding: 14px 2px 0;
        color: var(--reference-muted);
        font-size: 0.92rem;
      }

      .technical-details {
        border-top: 1px solid var(--reference-line);
        border-bottom: 1px solid var(--reference-line);
      }

      .technical-details summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding: 24px 0;
        color: var(--reference-ink);
        font-size: 1.08rem;
        font-weight: 800;
        cursor: pointer;
        list-style: none;
      }

      .technical-details summary::-webkit-details-marker {
        display: none;
      }

      .technical-details summary::after {
        content: "+";
        color: var(--avab-green);
        font-size: 1.6rem;
        font-weight: 500;
      }

      .technical-details[open] summary::after {
        content: "–";
      }

      .technical-content {
        padding: 0 0 30px;
      }

      .technical-content ul {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px 32px;
        padding-left: 20px;
      }

      .technical-content li {
        color: var(--reference-muted);
      }

      .relevance-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px 40px;
        margin-top: 32px;
      }

      .relevance-item {
        position: relative;
        padding: 18px 0 18px 34px;
        border-top: 1px solid var(--reference-line);
        color: var(--reference-ink);
        font-weight: 700;
      }

      .relevance-item::before {
        content: "";
        position: absolute;
        left: 0;
        top: 23px;
        width: 12px;
        height: 12px;
        border: 3px solid var(--avab-green);
        border-radius: 50%;
      }

      .related-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 24px;
      }

      .related-card {
        overflow: hidden;
        border: 1px solid var(--reference-line);
        border-radius: var(--avab-radius-sm);
        background: var(--avab-white);
        box-shadow: var(--avab-shadow-sm);
        transition:
          transform 0.28s ease,
          box-shadow 0.28s ease;
      }

      .related-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--avab-shadow-lg);
      }

      .related-card img {
        width: 100%;
        aspect-ratio: 16 / 10;
        object-fit: cover;
      }

      .related-card-content {
        padding: 24px;
      }

      .related-card h3 {
        margin-bottom: 10px;
        font-size: 1.24rem;
      }

      .related-card p {
        margin-bottom: 20px;
        color: var(--reference-muted);
        font-size: 0.94rem;
      }

      .related-card span {
        color: var(--reference-ink);
        font-size: 0.9rem;
        font-weight: 800;
      }

      .related-card span::after {
        content: " →";
        color: var(--avab-green);
      }

      .reference-cta {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 48px;
        align-items: center;
        padding: clamp(36px, 6vw, 64px);
        border-radius: var(--avab-radius);
        background: var(--avab-dark);
      }

      .reference-cta h2 {
        max-width: 17ch;
        margin-bottom: 14px;
        color: var(--avab-white);
      }

      .reference-cta p {
        margin: 0;
        color: rgba(255, 255, 255, 0.76);
      }

      .reference-cta-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 12px;
      }

      @media (max-width: 1100px) {
        .reference-hero-grid {
          grid-template-columns: 1fr 1fr;
          gap: 42px;
        }

        .reference-facts-grid {
          grid-template-columns: repeat(3, 1fr);
        }

        .reference-fact:nth-child(4) {
          border-left: 1px solid var(--reference-line);
        }

        .reference-fact:nth-child(n + 4) {
          border-top: 1px solid var(--reference-line);
        }

        .scale-grid {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      @media (max-width: 900px) {
        .reference-hero-grid,
        .reference-content-grid,
        .reference-quote,
        .reference-cta {
          grid-template-columns: 1fr;
        }

        .reference-hero h1 {
          max-width: 14ch;
        }

        .reference-image img {
          min-height: 380px;
        }

        .reference-summary-grid,
        .related-grid {
          grid-template-columns: 1fr;
        }

        .reference-summary,
        .reference-summary + .reference-summary {
          padding: 28px 0;
          border-left: 0;
        }

        .reference-summary + .reference-summary {
          border-top: 1px solid var(--reference-line);
        }

        .reference-sidebar {
          position: static;
        }

        .reference-cta-actions {
          justify-content: flex-start;
        }
      }

      @media (max-width: 680px) {
        .reference-hero {
          padding-top: 38px;
        }

        .reference-hero h1 {
          font-size: clamp(2.55rem, 13vw, 4rem);
        }

        .reference-image img {
          min-height: 290px;
        }

        .reference-facts-grid,
        .scope-list,
        .scale-grid,
        .gallery-grid,
        .technical-content ul,
        .relevance-grid {
          grid-template-columns: 1fr;
        }

        .reference-fact,
        .reference-fact:first-child,
        .reference-fact:nth-child(4) {
          border-left: 1px solid var(--reference-line);
          border-right: 1px solid var(--reference-line);
          border-top: 1px solid var(--reference-line);
        }

        .reference-fact:first-child {
          border-top: 0;
        }

        .scope-list li {
          padding-right: 4px;
        }

        .reference-block + .reference-block {
          margin-top: 52px;
          padding-top: 52px;
        }

        .reference-quote {
          gap: 28px;
        }
      }
    </style>
  </head>

  <body class="reference-page">
    <SiteHeader />

    <nav class="reference-breadcrumbs" aria-label="Brödsmulor">
      <div class="avab-container">
        <ol>
          <li><a href="/">Start</a></li>
          <li><a href="/referenser/">Referenser</a></li>
          <li><span aria-current="page">Säffle simhall</span></li>
        </ol>
      </div>
    </nav>

    <main id="main">
      <header class="reference-hero">
        <div class="avab-container reference-hero-grid">
          <div>
            <span class="reference-kicker">Referens · Simhall</span>
            <h1>Säffle simhall</h1>
            <p class="reference-hero-subtitle">
              Samlad styrning för ljud, ljus och tillgänglighet
            </p>
            <p class="reference-hero-lead">
              AVAB ansvarade för projektering, installation och driftsättning av
              en integrerad AV-lösning där ljudzoner, mikrofoner, hörslingor,
              projektor och miljöbelysning hanteras från ett gemensamt
              Crestrongränssnitt.
            </p>

            <div class="reference-actions">
              <a class="button button-primary" href="#omfattning">
                Se AVAB:s omfattning
              </a>
              <a
                class="button button-secondary"
                href="/kontakt/#kontaktformular"
                data-contact-intent="project"
              >
                Kontakta AVAB
              </a>
            </div>
          </div>

          <figure class="reference-image">
            <img
              src={heroImage.src}
              alt={heroImage.alt}
              width={heroImage.width}
              height={heroImage.height}
              fetchpriority="high"
              decoding="async"
            />
            <figcaption class="reference-image-badge">
              50-metersbassäng · Säffle · Färdigställd 2019
            </figcaption>
          </figure>
        </div>
      </header>

      <section class="reference-facts" aria-label="Referensen i ett nötskal">
        <div class="avab-container reference-facts-grid">
          <div class="reference-fact">
            <span>Beställare</span>
            <strong>Assemblin El AB</strong>
          </div>
          <div class="reference-fact">
            <span>Slutkund</span>
            <strong>Säfflebostäder AB</strong>
          </div>
          <div class="reference-fact">
            <span>Plats</span>
            <strong>Säffle, Värmland</strong>
          </div>
          <div class="reference-fact">
            <span>Färdigställt</span>
            <strong>2019</strong>
          </div>
          <div class="reference-fact">
            <span>AVAB:s roll</span>
            <strong>Projektering, installation och driftsättning</strong>
          </div>
        </div>
      </section>

      <section class="reference-section" aria-labelledby="uppdraget">
        <div class="avab-container">
          <div class="reference-section-heading">
            <span class="reference-kicker">Uppdraget på 30 sekunder</span>
            <h2 id="uppdraget">Det här behövde kunden kunna bedöma och använda</h2>
          </div>

          <div class="reference-summary-grid">
            <article class="reference-summary">
              <span class="reference-summary-number">01 · Behov</span>
              <h3>Kundens behov</h3>
              <p>
                En stor publik anläggning behövde tydligt ljud, tillgängliga
                utrop och enkel styrning trots flera bassänger, läktare,
                träningsytor och separata verksamheter.
              </p>
            </article>

            <article class="reference-summary">
              <span class="reference-summary-number">02 · Ansvar</span>
              <h3>AVAB:s ansvar</h3>
              <p>
                AVAB projekterade och installerade ljud, mikrofoner,
                hörslingor, projektor och styrsystem samt samordnade
                lösningen med bygg, el och automation.
              </p>
            </article>

            <article class="reference-summary">
              <span class="reference-summary-number">03 · Resultat</span>
              <h3>Resultatet</h3>
              <p>
                Personalen fick ett gemensamt gränssnitt för ljud, KNX,
                DMX och anslutna driftfunktioner, medan varje verksamhetsyta
                behöll rätt ljud och rätt nivå.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="reference-section reference-section--soft" id="omfattning">
        <div class="avab-container reference-content-grid">
          <article class="reference-article">
            <section class="reference-block">
              <span class="reference-kicker">Tydligt ansvar</span>
              <h2>Det här ingick i AVAB:s uppdrag</h2>
              <p>
                Referensen ska göra ansvarsfördelningen tydlig. AVAB:s
                leverans omfattade hela kedjan från projektering och
                systemdesign till installation, programmering och
                driftsättning av AV-tekniken.
              </p>

              <ul class="scope-list">
                {scope.map((item) => <li>{item}</li>)}
              </ul>

              <aside class="project-boundary">
                <strong>Ansvarsgräns och samordning</strong>
                <p>
                  AVAB ansvarade för AV-systemen och deras integration.
                  Bygg-, el-, KNX- och övriga installationsarbeten utfördes
                  i samverkan med respektive entreprenör och beställare.
                </p>
              </aside>
            </section>

            <section class="reference-block">
              <span class="reference-kicker">Projektförutsättning</span>
              <h2>Avgörande beslut behövde tas innan betong och golv stängdes</h2>
              <p>
                Kabelvägar, högtalarinfästningar och hörslingor behövde
                projekteras tidigt. När sådana installationer ska gjutas
                in eller byggas över blir sena ändringar både dyrare och
                svårare att genomföra.
              </p>
              <p>
                AVAB samordnade därför placeringar, kabeldragning,
                slingområden och gränssnitt med övriga discipliner långt
                innan all synlig teknik kunde monteras.
              </p>

              <aside class="project-boundary">
                <strong>Kritisk risk som hanterades</strong>
                <p>
                  AV-tekniken behövde komma in tidigt i projekteringen för
                  att undvika sena ingrepp i färdig betong, golv, läktare
                  och tak.
                </p>
              </aside>
            </section>

            <section class="reference-block">
              <span class="reference-kicker">Genomförande</span>
              <h2>Tre faser från ritning till fungerande anläggning</h2>

              <ol class="process-list">
                <li>
                  <span class="process-number">1</span>
                  <div>
                    <h3>Projektering och samordning</h3>
                    <p>
                      Ljudspridning, zoner, hörslingor, kabelvägar,
                      infästningar och integrationspunkter planerades
                      tillsammans med övriga teknikområden.
                    </p>
                  </div>
                </li>
                <li>
                  <span class="process-number">2</span>
                  <div>
                    <h3>Installation och programmering</h3>
                    <p>
                      Högtalare, mikrofoner, antenner, hörslingor,
                      projektor och styrsystem installerades i takt med
                      byggprojektets olika skeden.
                    </p>
                  </div>
                </li>
                <li>
                  <span class="process-number">3</span>
                  <div>
                    <h3>Provning och överlämning</h3>
                    <p>
                      Signalvägar, zoner, mikrofoner, styrkommandon och
                      anslutna funktioner provades, dokumenterades och
                      driftsattes inför överlämningen.
                    </p>
                  </div>
                </li>
              </ol>
            </section>
          </article>

          <aside class="reference-sidebar" aria-label="Projektfakta">
            <h2>Projektfakta</h2>
            <dl class="sidebar-facts">
              <div>
                <dt>Miljö</dt>
                <dd>Simhall och publik anläggning</dd>
              </div>
              <div>
                <dt>Beställare</dt>
                <dd>Assemblin El AB</dd>
              </div>
              <div>
                <dt>Slutkund</dt>
                <dd>Säfflebostäder AB</dd>
              </div>
              <div>
                <dt>Fastighetsdrift</dt>
                <dd>Säffle kommun</dd>
              </div>
              <div>
                <dt>Projektfas</dt>
                <dd>Projektering till driftsättning</dd>
              </div>
              <div>
                <dt>Centralt system</dt>
                <dd>Crestron</dd>
              </div>
              <div>
                <dt>Status</dt>
                <dd>Färdigställd och i drift</dd>
              </div>
            </dl>

            <a
              class="button button-primary sidebar-action"
              href="/kontakt/#kontaktformular"
              data-contact-intent="project"
            >
              Diskutera ett liknande projekt
            </a>
          </aside>
        </div>
      </section>

      <section class="reference-section" aria-labelledby="skala">
        <div class="avab-container">
          <div class="reference-section-heading">
            <span class="reference-kicker">Projektets omfattning</span>
            <h2 id="skala">Konkreta skalindikatorer</h2>
            <p>
              Siffrorna hjälper en inköpare att jämföra referensen med
              omfattningen i ett kommande projekt.
            </p>
          </div>

          <div class="scale-grid">
            {scale.map((item) => (
              <div class="scale-item">
                <strong>{item.value}</strong>
                <span>{item.label}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="reference-section reference-section--soft" aria-labelledby="resultat">
        <div class="avab-container">
          <div class="reference-section-heading">
            <span class="reference-kicker">Resultat och verifiering</span>
            <h2 id="resultat">Stor teknisk omfattning, enkel användning</h2>
            <p>
              Lösningen samlar flera tekniska system utan att personalen
              behöver arbeta direkt i ljudprocessorer, ljusstyrning eller
              bakomliggande signalvägar.
            </p>
          </div>

          <div class="reference-summary-grid">
            <article class="reference-summary">
              <span class="reference-summary-number">Verifierat</span>
              <h3>Gemensam styrning</h3>
              <p>
                Ljudzoner, mikrofoner, KNX-funktioner och DMX-styrd
                miljöbelysning hanteras från ett gemensamt Crestronsystem.
              </p>
            </article>

            <article class="reference-summary">
              <span class="reference-summary-number">Verifierat</span>
              <h3>Tillgängliga utrop</h3>
              <p>
                Hörslingor installerades för läktarområden och
                konferensytor så att information kan nå hörapparat- och
                CI-användare.
              </p>
            </article>

            <article class="reference-summary">
              <span class="reference-summary-number">Bedömd nytta</span>
              <h3>Färre manuella moment</h3>
              <p>
                Central styrning minskar behovet av att starta och stänga
                flera delsystem manuellt på olika platser i anläggningen.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="reference-section">
        <div class="avab-container">
          <div class="reference-quote">
            <blockquote>
              <p>
                ”Anläggningen har genomförts med omsorg och kvalitet.
                Kommunikationen och lösningsorienteringen har varit mycket
                professionell. Tidplanen har varit tuff i projektet, som
                AVAB svarat upp till fullo mot.”
              </p>
            </blockquote>
            <footer>
              <strong>Anders Björkman</strong>
              Projektledare, Assemblin
            </footer>
          </div>
        </div>
      </section>

      <section class="reference-section reference-section--soft" aria-labelledby="bilder">
        <div class="avab-container">
          <div class="reference-section-heading">
            <span class="reference-kicker">Bildberättelse</span>
            <h2 id="bilder">Miljö, användning och teknisk funktion</h2>
            <p>
              Bilderna visar både anläggningens skala och hur separata
              verksamhetsytor kräver olika ljud- och ljusmiljöer.
            </p>
          </div>

          <div class="gallery-grid">
            {gallery.map((image) => (
              <figure>
                <div class="gallery-image">
                  <img
                    src={image.src}
                    alt={image.alt}
                    width={image.width}
                    height={image.height}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <figcaption>{image.caption}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>

      <section class="reference-section">
        <div class="avab-container reference-content-grid">
          <article class="reference-article">
            <div class="reference-section-heading">
              <span class="reference-kicker">Teknisk fördjupning</span>
              <h2>Tekniken finns tillgänglig utan att dominera sidan</h2>
              <p>
                Inköpare och projektörer kan fördjupa sig vid behov, medan
                övriga läsare snabbt kan gå vidare.
              </p>
            </div>

            <details class="technical-details">
              <summary>Visa teknisk sammanfattning</summary>
              <div class="technical-content">
                <ul>
                  <li>Överordnat Crestronsystem</li>
                  <li>Zonindelat ljudsystem</li>
                  <li>Trådlösa handmikrofoner och headset</li>
                  <li>Två rundtagande mikrofonantenner</li>
                  <li>Hörslingor vid läktare och konferensytor</li>
                  <li>Projektor för multihall och träningsinnehåll</li>
                  <li>KNX-integration för belysningsfunktioner</li>
                  <li>DMX-styrd miljö- och poolbelysning</li>
                  <li>Separata nivåer och källor per ljudzon</li>
                  <li>Dokumentation och funktionsprovning</li>
                </ul>
              </div>
            </details>
          </article>

          <aside class="reference-sidebar">
            <h2>Relaterade kompetenser</h2>
            <dl class="sidebar-facts">
              <div>
                <dt>Tjänst</dt>
                <dd><a class="text-link" href="/tjanster/projektering/">AV-projektering</a></dd>
              </div>
              <div>
                <dt>Tjänst</dt>
                <dd><a class="text-link" href="/tjanster/styrsystem-integration/">Styrsystem och integration</a></dd>
              </div>
              <div>
                <dt>Tjänst</dt>
                <dd><a class="text-link" href="/tjanster/horslinga/">Hörslinga och tillgänglighet</a></dd>
              </div>
              <div>
                <dt>Miljö</dt>
                <dd><a class="text-link" href="/miljo/simhall/">Lösningar för simhall</a></dd>
              </div>
            </dl>
          </aside>
        </div>
      </section>

      <section class="reference-section reference-section--soft" aria-labelledby="relevans">
        <div class="avab-container">
          <div class="reference-section-heading">
            <span class="reference-kicker">Överförbar erfarenhet</span>
            <h2 id="relevans">Därför är referensen relevant för liknande upphandlingar</h2>
            <p>
              Referensen visar inte bara vad som installerades, utan vilka
              typer av krav och projektrisker AVAB har praktisk erfarenhet av.
            </p>
          </div>

          <div class="relevance-grid">
            {relevance.map((item) => <div class="relevance-item">{item}</div>)}
          </div>
        </div>
      </section>

      <section class="reference-section" aria-labelledby="relaterade">
        <div class="avab-container">
          <div class="reference-section-heading">
            <span class="reference-kicker">Relaterade referenser</span>
            <h2 id="relaterade">Fler projekt med liknande krav</h2>
          </div>

          <div class="related-grid">
            {relatedReferences.map((reference) => (
              <a class="related-card" href={reference.href}>
                <img
                  src={reference.image}
                  alt={reference.alt}
                  width="1200"
                  height="800"
                  loading="lazy"
                  decoding="async"
                />
                <div class="related-card-content">
                  <h3>{reference.title}</h3>
                  <p>{reference.text}</p>
                  <span>Se referensen</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="reference-section">
        <div class="avab-container">
          <div class="reference-cta">
            <div>
              <span class="reference-kicker">Planerar ni en liknande anläggning?</span>
              <h2>Ta in AV, styrning och tillgänglighet innan konstruktionerna låses</h2>
              <p>
                Skicka ritningar, FFU eller en kort projektbeskrivning.
                AVAB hjälper er att bedöma behov, omfattning och lämpligt
                nästa steg.
              </p>
            </div>

            <div class="reference-cta-actions">
              <a
                class="button button-light"
                href="/kontakt/#kontaktformular"
                data-contact-intent="project"
              >
                Ladda upp underlag
              </a>
              <a class="button button-secondary" href="/kontakt/">
                Kontakta AVAB
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
