);

if (!reference) {
  throw new Error("Referensen Hundfjällshotellet & Hundfjällscenter saknas i content collection.");
}

const data = reference.data;
const canonicalUrl = absoluteUrl(data.slug);
const customHeroImage = {
  src: "/assets/hundfjall-hotell-invigning.webp",
  alt: "SkiStar Lodge Hundfjället i Sälen, del av AVAB:s referensprojekt tillsammans med Hundfjällscenter",
  width: 1920,
  height: 1080,
};
const heroData = { ...data, heroImage: customHeroImage };
const heroImageUrl = absoluteUrl(customHeroImage.src);
const publishedDate = data.publishedDate.toISOString().slice(0, 10);
const updatedDate = "2026-08-20";
const robots = data.draft || data.seo.noindex
