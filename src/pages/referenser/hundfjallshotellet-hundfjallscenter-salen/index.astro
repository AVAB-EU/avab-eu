const seoTitle = "Hundfjällscenter & SkiStar Lodge Hundfjället – AV-teknik | AVAB";
const seoDescription = "Från en hörslinga till en sammanhängande AV-miljö i två hus: 494 högtalare, 28 ljudzoner, fem konferensrum, spa, restaurang, hotell och Dante mellan Hundfjällscenter och SkiStar Lodge Hundfjället.";
const ogTitle = "Hundfjället – från en hörslinga till 494 högtalare i två sammankopplade hus";

const faqItems = [
  {
    q: "Hur började AVAB:s projekt i Hundfjället?",
    a: "EBAB i Karlstad kontaktade AVAB för att räkna på en hörslinga till ett konferensrum. När vi såg att konferensplanet bestod av fem konferensrum bad vi om att få räkna på hela konferensdelen. Efter ungefär en månad fick vi beställningen på hörslingan och frågan om vi ville räkna på hela Hundfjällscenter. Vi fick ritningarna för tre våningsplan, projekterade huset och fick därefter även frågan om att räkna på hotellet."
  },
  {
    q: "Hur stor blev den samlade AV-installationen?",
    a: "Den färdiga helheten i Hundfjällscenter och SkiStar Lodge Hundfjället omfattar 494 högtalare och 28 ljudzoner, fördelade över bland annat spa, restaurang, bar, lobby, konferens, butik, aktivitet, hissar och andra publika ytor."
  },
  {
    q: "Hur många konferensrum finns i Hundfjällscenter?",
    a: "Konferensplanet innehåller fem konferensrum: ett större konferensrum på cirka 121 kvadratmeter och fyra mindre rum. AVAB levererade bland annat ljud, bild, styrning, mikrofoner och hörslinga utifrån respektive rums behov."
  },
  {
    q: "Hur projekterades hörslingan i det stora konferensrummet?",
    a: "Hörslingan projekterades som en SLS-lösning med master- och slaveslingor. Univox-beräkningen för konferensrum 1-315 omfattade 195,64 meter kopparfolie. Slingan lades på det ofärdiga golvet innan ytskikten byggdes över installationen."
  },
  {
    q: "Vad levererade AVAB i Hundfjällscenter Spa?",
    a: "AVAB gjorde en komplett installation. Tre Audac M2-processorer och en MTX88 fördelades över planen, med MTX88 i spaavdelningen. Där ingick även utropsmikrofon, fuktanpassade specialgaller och högtalare för miljöer där vanlig inomhusutrustning inte är rätt val. Utomhus användes IP-klassade högtalare."
  },
  {
    q: "Hur är Hundfjällscenter och hotellet sammankopplade?",
    a: "Ljud kan skickas digitalt via Dante mellan de två byggnaderna i båda riktningarna. Det gör det möjligt att till exempel ta en trubadur inkopplad vid restaurangen i Hundfjällscenter och spela samma källa i hotellets bar, eller låta en DJ i hotellets reception höras i valda zoner i båda husen."
  },
  {
    q: "Vilken typ av ljudsystem byggdes i SkiStar Lodge Hundfjället?",
    a: "Hotellet byggdes med zonindelat Audac-system för bland annat lobby, bar och lounge, restaurang, Chambre, butik, lek- och aktivitetsytor, hisshall, hiss, garage och våning två. Systemet kunde kombinera gemensam bakgrundsmusik med lokala källor, volympaneler och separata funktioner i olika delar av huset."
  },
  {
    q: "Har AVAB fortsatt serva installationen efter färdigställandet?",
    a: "Ja. När ett slutsteg senare gick sönder uppgraderades den delen av systemet till ett Blaze-slutsteg. Det är ett exempel på hur en stor fast installation behöver kunna servas och utvecklas utan att hela systemet byggs om."
  }
];

