---
import PageCTA from "../../../components/PageCTA.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import "../../../styles/avab.css";

const siteUrl = "https://avab.eu";
const canonicalUrl = `${siteUrl}/referenser/hanza-konferens-tocksfors/`;

const heroImage = {
  src: "/assets/konferensrum-stor-skarm-bord.webp",
  absoluteSrc: `${siteUrl}/assets/konferensrum-stor-skarm-bord.webp`,
  alt: "Konferensrum hos Hanza Mechanics med stor display, bordspanel och headset",
  width: 1200,
  height: 900,
};

const scope = [
  "Två 85-tums Samsung PRO-displayer med UHD/4K och formatet 16:9",
  "Crestron AirMedia 3 för trådlös presentation i båda rummen",
  "Två USB-C-donglar per rum för anslutning av användarens dator",
  "Crestron Flex MTR-system med BYOD i det lilla rummet",
  "HDBaseT och touchpanel på bordet i det lilla rummet",
  "Sennheiser TeamConnect Videobar Medium i det stora rummet",
  "Crestron rumsbokningspaneler utanför totalt fyra konferensrum",
];

const gallery = [
  {
    src: "/assets/konferensrum-stor-skarm-bord.webp",
    alt: "Konferensrum hos Hanza Mechanics med stor display, touchpanel och headset på bordet",
    caption:
      "Bordspanelen och anslutningarna är placerade nära användaren, med en gemensam 85-tums bildyta för presentation och möte.",
    width: 1200,
    height: 900,
  },
  {
    src: "/assets/konferensrum-vaggskarm-ljudlimpa.webp",
    alt: "Konferensrum hos Hanza Mechanics med stor display och videobar ovanför mötesbordet",
    caption:
      "Videobaren samlar kamera, mikrofon och högtalare vid displayen och håller mötesbordet fritt från fast teknik.",
    width: 1200,
    height: 900,
  },
];

const relevance = [
  "Verksamheter med flera konferensrum och behov av tydlig bokningsstatus vid dörren.",
  "Projekt där olika rumsstorlekar behöver olika teknik men en konsekvent användarupplevelse.",
  "Mötesmiljöer som ska stödja både Teams Room och BYOD.",
  "Personal och gäster som ansluter datorer med olika arbetssätt och mötestjänster.",
  "Krav på snabb trådlös presentation med USB-C-donglar.",
  "Större rum där en videobar samlar kamera, mikrofon och högtalare i en enhet.",
];

const relatedReferences = [
  {
    href: "/referenser/minnebergsskolan-arvika/",
    title: "Minnebergsskolan, Arvika",
    text: "Många undervisningsrum, hörsalar och en aula med gemensamma principer för bild, ljud och styrning.",
    image: "/assets/modern-trafasad-innergard.webp",
    alt: "Minnebergsskolans träfasad och innergård i Arvika",
    width: 1200,
    height: 834,
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${canonicalUrl}#article`,
      headline:
        "Hanza Mechanics, Töcksfors – konferensrum som är lätta att boka, starta och koppla upp",
      description:
        "Referens om AVAB:s leverans av mötesteknik till två nya konferensrum och rumsbokningspaneler utanför fyra rum hos Hanza Mechanics i Töcksfors.",
      datePublished: "2026-07-08",
      dateModified: "2026-08-04",
      inLanguage: "sv-SE",
      image: gallery.map((image) => `${siteUrl}${image.src}`),
      author: {
        "@type": "Organization",
        name: "AVAB",
        url: `${siteUrl}/`,
      },
      publisher: {
        "@type": "Organization",
        name: "AVAB",
        url: `${siteUrl}/`,
      },
      mainEntityOfPage: {
        "@id": `${canonicalUrl}#webpage`,
      },
      about: [
        { "@type": "Thing", name: "Konferensteknik" },
        { "@type": "Thing", name: "Trådlös presentation" },
        { "@type": "Thing", name: "BYOD" },
        { "@type": "Thing", name: "Rumsbokning" },
      ],
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: "Hanza Mechanics, Töcksfors – konferensteknik och rumsbokning | Referens | AVAB",
      description:
        "Två nya konferensrum med 85-tums displayer, trådlös presentation, Teams/BYOD, videobar och bokningsstatus utanför fyra rum.",
      inLanguage: "sv-SE",
      isPartOf: {
        "@type": "WebSite",
        name: "AVAB",
        url: `${siteUrl}/`,
      },
      breadcrumb: {
        "@id": `${canonicalUrl}#breadcrumb`,
      },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Start",
          item: `${siteUrl}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Referenser",
          item: `${siteUrl}/referenser/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Hanza Mechanics, Töcksfors",
          item: canonicalUrl,
        },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Hanza Mechanics, Töcksfors – konferensteknik och rumsbokning | Referens | AVAB</title>
    <meta
      name="description"
      content="Se AVAB:s leverans av mötesteknik till två nya konferensrum och rumsbokningspaneler utanför fyra rum hos Hanza Mechanics i Töcksfors."
    />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="AVAB" />
    <meta name="theme-color" content="#282E29" />

    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="article" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:site_name" content="AVAB" />
    <meta
      property="og:title"
      content="Hanza Mechanics, Töcksfors – konferensrum som är lätta att boka, starta och koppla upp"
    />
    <meta
      property="og:description"
      content="Två nya konferensrum med trådlös presentation, Teams/BYOD, videobar och bokningsstatus utanför fyra rum."
    />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={heroImage.absoluteSrc} />
    <meta property="og:image:width" content={String(heroImage.width)} />
    <meta property="og:image:height" content={String(heroImage.height)} />
    <meta property="og:image:alt" content={heroImage.alt} />
    <meta property="article:published_time" content="2026-07-08" />
    <meta property="article:modified_time" content="2026-08-04" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Hanza Mechanics, Töcksfors – konferensteknik och rumsbokning | AVAB"
    />
    <meta
      name="twitter:description"
      content="En inköparorienterad referens om två konferensrum, Teams/BYOD, trådlös presentation och rumsbokning."
    />
    <meta name="twitter:image" content={heroImage.absoluteSrc} />
    <meta name="twitter:image:alt" content={heroImage.alt} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="image" fetchpriority="high" href={heroImage.src} />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    ></script>

    <style>
      :root {
        --reference-ink: #1f2521;
        --reference-muted: #59615b;
        --reference-line: rgba(40, 46, 42, 0.14);
        --reference-soft: #f6f7f5;
        --reference-facts-bg: rgba(182, 182, 182, 0.05);
        --reference-green-soft: rgba(143, 192, 37, 0.12);
      }

      .reference-page {
        background: var(--avab-white);
      }

      .reference-page p {
        max-width: 72ch;
      }

      .reference-breadcrumbs {
        border-bottom: 1px solid var(--reference-line);
        background: var(--avab-white);
      }

      .reference-breadcrumbs ol {
        min-height: 52px;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        list-style: none;
        font-size: 0.84rem;
        color: var(--reference-muted);
      }

      .reference-breadcrumbs li:not(:last-child)::after {
        content: "/";
        margin-left: 8px;
        color: rgba(40, 46, 42, 0.35);
      }

      .reference-breadcrumbs a:hover {
        color: var(--avab-green);
      }

      .reference-hero {
        padding: clamp(48px, 7vw, 88px) 0;
        border-bottom: 1px solid var(--reference-line);
        background:
          radial-gradient(circle at 10% 20%, var(--reference-green-soft), transparent 28%),
          var(--avab-white);
      }

      .reference-hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(420px, 1.1fr);
        gap: clamp(36px, 6vw, 88px);
        align-items: center;
      }

      .reference-kicker {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
        color: var(--avab-dark-muted);
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .reference-kicker::before {
        content: "";
        width: 34px;
        height: 3px;
        flex: 0 0 auto;
        border-radius: 999px;
        background: var(--avab-green);
      }

      .reference-hero h1 {
        max-width: 12ch;
        margin: 0 0 20px;
        color: var(--reference-ink);
        font-size: clamp(2.8rem, 5.8vw, 5.6rem);
        font-weight: 800;
        line-height: 0.98;
        letter-spacing: -0.055em;
        overflow-wrap: anywhere;
      }

      .reference-hero-subtitle {
        max-width: 22ch;
        margin-bottom: 20px;
        color: var(--reference-ink);
        font-size: clamp(1.25rem, 2vw, 1.75rem);
        font-weight: 700;
        line-height: 1.35;
      }

      .reference-hero-lead {
        max-width: 57ch;
        margin-bottom: 30px;
        color: var(--reference-muted);
        font-size: 1.08rem;
      }

      .reference-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
      }

      .reference-image {
        position: relative;
        overflow: hidden;
        background: var(--avab-grey);
        box-shadow: 0 28px 70px rgba(40, 46, 42, 0.16);
      }

      .reference-image::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        border: 1px solid rgba(255, 255, 255, 0.35);
      }

      .reference-image img {
        width: 100%;
        min-height: 500px;
        object-fit: cover;
      }

      .reference-facts {
        border-bottom: 1px solid var(--reference-line);
        background: var(--reference-facts-bg);
      }

      .reference-facts-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
      }

      .reference-fact {
        min-width: 0;
        padding: 24px 22px;
        border-right: 1px solid var(--reference-line);
      }

      .reference-fact:first-child {
        border-left: 1px solid var(--reference-line);
      }

      .reference-fact span {
        display: block;
        margin-bottom: 7px;
        color: var(--reference-muted);
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.07em;
        text-transform: uppercase;
      }

      .reference-fact strong {
        display: block;
        color: var(--reference-ink);
        font-size: 0.98rem;
        line-height: 1.38;
      }

      .reference-section {
        padding: clamp(64px, 8vw, 108px) 0;
        border-bottom: 1px solid var(--reference-line);
      }

      .reference-section--soft {
        background: var(--reference-soft);
      }

      .reference-section-heading {
        max-width: 760px;
        margin-bottom: 42px;
      }

      .reference-section-heading h2,
      .reference-block h2 {
        overflow-wrap: anywhere;
      }

      .reference-section-heading h2 {
        margin-bottom: 16px;
        font-size: clamp(2rem, 4vw, 3.35rem);
        letter-spacing: -0.035em;
      }

      .reference-section-heading p {
        margin-bottom: 0;
        color: var(--reference-muted);
      }

      .reference-summary-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        border-top: 1px solid var(--reference-line);
        border-bottom: 1px solid var(--reference-line);
      }

      .reference-summary {
        padding: 34px 34px 34px 0;
      }

      .reference-summary + .reference-summary {
        padding-left: 34px;
        border-left: 1px solid var(--reference-line);
      }

      .reference-summary-number {
        display: block;
        margin-bottom: 22px;
        color: var(--avab-green);
        font-size: 0.76rem;
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .reference-summary h3 {
        margin-bottom: 14px;
        font-size: clamp(1.35rem, 2vw, 1.8rem);
      }

      .reference-summary p {
        margin: 0;
        color: var(--reference-muted);
        font-size: 1rem;
      }

      .reference-content-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 340px;
        gap: clamp(48px, 7vw, 96px);
        align-items: start;
      }

      .reference-article {
        min-width: 0;
      }

      .reference-block + .reference-block {
        margin-top: 72px;
        padding-top: 72px;
        border-top: 1px solid var(--reference-line);
      }

      .reference-block h2 {
        max-width: 20ch;
        margin-bottom: 18px;
        font-size: clamp(1.8rem, 3vw, 2.75rem);
        letter-spacing: -0.025em;
      }

      .reference-block p {
        color: var(--reference-muted);
      }

      .scope-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0 28px;
        margin-top: 26px;
        padding-inline: clamp(18px, 3vw, 28px);
        list-style: none;
        border-top: 1px solid var(--reference-line);
      }

      .scope-list li {
        position: relative;
        padding: 17px 0 17px 28px;
        border-bottom: 1px solid var(--reference-line);
        color: var(--reference-ink);
        font-weight: 700;
      }

      .scope-list li::before {
        content: "✓";
        position: absolute;
        left: 0;
        color: var(--avab-green);
        font-weight: 900;
      }

      .room-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
        margin-top: 30px;
      }

      .room-card {
        padding: 28px;
        border: 1px solid var(--reference-line);
        border-radius: var(--avab-radius-sm);
        background: var(--avab-white);
      }

      .room-card h3 {
        margin-bottom: 8px;
        font-size: 1.35rem;
      }

      .room-card p {
        margin-bottom: 18px;
        color: var(--reference-muted);
        font-size: 0.96rem;
      }

      .room-card ul {
        display: grid;
        gap: 10px;
        margin: 0;
        padding-left: 20px;
        color: var(--reference-muted);
      }

      .room-card li {
        padding-left: 4px;
      }

      .reference-sidebar {
        position: sticky;
        top: calc(var(--avab-nav-height) + 24px);
        padding: 28px;
        border: 1px solid var(--reference-line);
        border-radius: var(--avab-radius-sm);
        background: var(--avab-white);
        box-shadow: var(--avab-shadow-sm);
      }

      .reference-sidebar h2 {
        margin-bottom: 24px;
        font-size: 1.25rem;
      }

      .sidebar-facts {
        margin: 0;
      }

      .sidebar-facts div {
        padding: 15px 0;
        border-top: 1px solid var(--reference-line);
      }

      .sidebar-facts dt {
        margin-bottom: 4px;
        color: var(--reference-muted);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .sidebar-facts dd {
        margin: 0;
        color: var(--reference-ink);
        font-weight: 700;
      }

      .sidebar-action {
        width: 100%;
        margin-top: 24px;
      }

      .scale-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 14px;
        margin-top: 38px;
      }

      .scale-item {
        min-height: 150px;
        padding: 24px 20px;
        border: 1px solid var(--reference-line);
        border-radius: var(--avab-radius-sm);
        background: var(--avab-white);
      }

      .scale-item strong {
        display: block;
        margin-bottom: 10px;
        color: var(--reference-ink);
        font-size: clamp(1.7rem, 3vw, 2.65rem);
        line-height: 1;
      }

      .scale-item span {
        color: var(--reference-muted);
        font-size: 0.9rem;
        line-height: 1.35;
      }

      .gallery-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 28px;
      }

      .gallery-grid figure {
        margin: 0;
      }

      .gallery-image {
        overflow: hidden;
        border-radius: var(--avab-radius-sm);
        background: var(--avab-grey);
      }

      .gallery-image img {
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .gallery-image:hover img {
        transform: scale(1.025);
      }

      .gallery-grid figcaption {
        padding: 14px 2px 0;
        color: var(--reference-muted);
        font-size: 0.92rem;
      }

      .technical-details {
        border-top: 1px solid var(--reference-line);
        border-bottom: 1px solid var(--reference-line);
      }

      .technical-details summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding: 24px 0;
        color: var(--reference-ink);
        font-size: 1.08rem;
        font-weight: 800;
        cursor: pointer;
        list-style: none;
      }

      .technical-details summary::-webkit-details-marker {
        display: none;
      }

      .technical-details summary::after {
        content: "+";
        color: var(--avab-green);
        font-size: 1.6rem;
        font-weight: 500;
      }

      .technical-details[open] summary::after {
        content: "–";
      }

      .technical-content {
        padding: 0 0 30px;
      }

      .technical-content ul {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px 32px;
        padding-left: 20px;
      }

      .technical-content li {
        color: var(--reference-muted);
      }

      .relevance-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px 40px;
        margin-top: 32px;
      }

      .relevance-item {
        position: relative;
        padding: 18px 0 18px 34px;
        border-top: 1px solid var(--reference-line);
        color: var(--reference-ink);
        font-weight: 700;
      }

      .relevance-item::before {
        content: "";
        position: absolute;
        left: 0;
        top: 23px;
        width: 12px;
        height: 12px;
        border: 3px solid var(--avab-green);
        border-radius: 50%;
      }

      .related-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 380px));
        gap: 24px;
      }

      .related-card {
        overflow: hidden;
        border: 1px solid var(--reference-line);
        border-radius: var(--avab-radius-sm);
        background: var(--avab-white);
        box-shadow: var(--avab-shadow-sm);
        transition:
          transform 0.28s ease,
          box-shadow 0.28s ease;
      }

      .related-card:hover,
      .related-card:focus-visible {
        transform: translateY(-4px);
        box-shadow: var(--avab-shadow-lg);
      }

      .related-card img {
        width: 100%;
        aspect-ratio: 16 / 10;
        object-fit: cover;
      }

      .related-card-content {
        padding: 24px;
      }

      .related-card h3 {
        margin-bottom: 10px;
        font-size: 1.24rem;
      }

      .related-card p {
        margin-bottom: 20px;
        color: var(--reference-muted);
        font-size: 0.94rem;
      }

      .related-card span {
        color: var(--reference-ink);
        font-size: 0.9rem;
        font-weight: 800;
      }

      .related-card span::after {
        content: " →";
        color: var(--avab-green);
      }

      @media (max-width: 1100px) {
        .reference-hero-grid {
          grid-template-columns: 1fr 1fr;
          gap: 42px;
        }

        .reference-facts-grid {
          grid-template-columns: repeat(3, 1fr);
        }

        .reference-fact:nth-child(4) {
          border-left: 1px solid var(--reference-line);
        }

        .reference-fact:nth-child(n + 4) {
          border-top: 1px solid var(--reference-line);
        }

        .scale-grid {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      @media (max-width: 900px) {
        .reference-content-grid {
          grid-template-columns: 1fr;
        }

        .reference-hero-grid {
          grid-template-columns: 1fr;
        }

        .reference-hero h1 {
          max-width: 14ch;
        }

        .reference-image img {
          min-height: 380px;
        }

        .reference-summary-grid {
          grid-template-columns: 1fr;
        }

        .reference-summary,
        .reference-summary + .reference-summary {
          padding: 28px 0;
          border-left: 0;
        }

        .reference-summary + .reference-summary {
          border-top: 1px solid var(--reference-line);
        }

        .reference-sidebar {
          position: static;
        }

      }

      @media (max-width: 680px) {
        .reference-hero {
          padding-top: 38px;
        }

        .reference-hero h1 {
          font-size: clamp(2.45rem, 12vw, 3.7rem);
        }

        .reference-image img {
          min-height: 290px;
        }

        .reference-actions {
          width: 100%;
          flex-direction: column;
        }

        .reference-actions .button {
          width: 100%;
        }

        .reference-facts-grid,
        .scope-list,
        .room-grid,
        .scale-grid,
        .gallery-grid,
        .technical-content ul,
        .relevance-grid {
          grid-template-columns: 1fr;
        }

        .reference-facts .reference-facts-grid {
          width: 100%;
          margin: 0;
        }

        .reference-fact,
        .reference-fact:nth-child(4),
        .reference-fact:nth-child(n + 4) {
          border: 0;
        }

        .reference-block + .reference-block {
          margin-top: 52px;
          padding-top: 52px;
        }

        .related-grid {
          grid-template-columns: 1fr;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .gallery-image img,
        .related-card {
          transition: none;
        }

        .gallery-image:hover img,
        .related-card:hover,
        .related-card:focus-visible {
          transform: none;
        }
      }
    </style>
  </head>

  <body class="reference-page">
    <SiteHeader />

    <nav class="reference-breadcrumbs" aria-label="Brödsmulor">
      <div class="avab-container">
        <ol>
          <li><a href="/">Start</a></li>
          <li><a href="/referenser/">Referenser</a></li>
          <li><span aria-current="page">Hanza Mechanics, Töcksfors</span></li>
        </ol>
      </div>
    </nav>

    <main id="main">
      <header class="reference-hero">
        <div class="avab-container reference-hero-grid">
          <div>
            <span class="reference-kicker">Referens · Kontor och konferens</span>
            <h1>Hanza Mechanics</h1>
            <p class="reference-hero-subtitle">
              Konferensrum som är lätta att boka, starta och koppla upp
            </p>
            <p class="reference-hero-lead">
              AVAB levererade mötesteknik till två nya konferensrum och
              kompletterade totalt fyra rum med paneler som visar bokningsstatus
              vid dörren.
            </p>

            <div class="reference-actions">
              <a class="button button-primary" href="#omfattning">
                Se AVAB:s omfattning
              </a>
              <a
                class="button button-secondary"
                href="/kontakt/#kontaktformular"
                data-contact-intent="project"
              >
                Kontakta AVAB
              </a>
            </div>
          </div>

          <figure class="reference-image">
            <img
              src={heroImage.src}
              alt={heroImage.alt}
              width={heroImage.width}
              height={heroImage.height}
              fetchpriority="high"
              decoding="async"
            />
          </figure>
        </div>
      </header>

      <section class="reference-facts" aria-label="Referensen i ett nötskal">
        <div class="avab-container reference-facts-grid">
          <div class="reference-fact">
            <span>Kund</span>
            <strong>Hanza Mechanics</strong>
          </div>
          <div class="reference-fact">
            <span>Plats</span>
            <strong>Töcksfors</strong>
          </div>
          <div class="reference-fact">
            <span>Omfattning</span>
            <strong>2 nya konferensrum</strong>
          </div>
          <div class="reference-fact">
            <span>Rumsbokning</span>
            <strong>Paneler utanför 4 rum</strong>
          </div>
          <div class="reference-fact">
            <span>AVAB:s leverans</span>
            <strong>Mötesteknik och rumsbokning</strong>
          </div>
        </div>
      </section>

      <section class="reference-section" aria-labelledby="uppdraget">
        <div class="avab-container">
          <div class="reference-section-heading">
            <span class="reference-kicker">Uppdraget på 30 sekunder</span>
            <h2 id="uppdraget">Funktion, ansvar och resultat i korthet</h2>
          </div>

          <div class="reference-summary-grid">
            <article class="reference-summary">
              <h3>Kundens behov</h3>
              <p>
                Snabb presentation, videomöten och BYOD i rum med olika storlek,
                tillsammans med tydlig bokningsstatus utanför konferensrummen.
              </p>
            </article>

            <article class="reference-summary">
              <h3>AVAB:s ansvar</h3>
              <p>
                Leverans av bild, trådlös presentation och mötesteknik i två nya
                rum samt rumsbokningspaneler utanför totalt fyra rum.
              </p>
            </article>

            <article class="reference-summary">
              <h3>Resultatet</h3>
              <p>
                Två funktionsanpassade rum med gemensam bildstorlek, trådlös
                presentation och stöd för Teams/BYOD samt synlig bokningsstatus.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="reference-section reference-section--soft" id="omfattning">
        <div class="avab-container reference-content-grid">
          <article class="reference-article">
            <section class="reference-block">
              <span class="reference-kicker">Leveransomfattning</span>
              <h2>Det här ingick i AVAB:s leverans</h2>
              <p>
                Leveransen kombinerar samma grund för bild och presentation med
                mötesteknik anpassad efter respektive rums storlek och arbetssätt.
              </p>

              <ul class="scope-list">
                {scope.map((item) => <li>{item}</li>)}
              </ul>
            </section>

            <section class="reference-block">
              <span class="reference-kicker">Två rum · Två lösningar</span>
              <h2>Samma grund, olika mötesfunktion</h2>
              <p>
                Båda rummen har 85-tums bild, AirMedia och USB-C-donglar. Den
                övriga mötestekniken skiljer sig för att passa rummens funktion.
              </p>

              <div class="room-grid">
                <article class="room-card">
                  <h3>Lilla rummet</h3>
                  <p>Teams Room och BYOD med styrningen nära användaren.</p>
                  <ul>
                    <li>Crestron Flex MTR-system</li>
                    <li>BYOD och HDBaseT</li>
                    <li>Touchpanel på bordet</li>
                    <li>Crestron AirMedia 3</li>
                    <li>85-tums Samsung PRO-display</li>
                  </ul>
                </article>

                <article class="room-card">
                  <h3>Stora rummet</h3>
                  <p>Videomöte med kamera, mikrofon och högtalare i en enhet.</p>
                  <ul>
                    <li>Sennheiser TeamConnect Videobar Medium</li>
                    <li>Kamera, mikrofon och högtalare</li>
                    <li>BYOD och trådlös presentation</li>
                    <li>Crestron AirMedia 3</li>
                    <li>85-tums Samsung PRO-display</li>
                  </ul>
                </article>
              </div>
            </section>
          </article>

          <aside class="reference-sidebar" aria-label="Projektfakta">
            <h2>Projektfakta</h2>
            <dl class="sidebar-facts">
              <div>
                <dt>Miljö</dt>
                <dd>Kontor och konferens</dd>
              </div>
              <div>
                <dt>Kund</dt>
                <dd>Hanza Mechanics</dd>
              </div>
              <div>
                <dt>Plats</dt>
                <dd>Töcksfors</dd>
              </div>
              <div>
                <dt>Nya rum</dt>
                <dd>Två konferensrum</dd>
              </div>
              <div>
                <dt>Bild</dt>
                <dd>85 tum, UHD/4K, 16:9</dd>
              </div>
              <div>
                <dt>Anslutning</dt>
                <dd>Trådlös presentation och BYOD</dd>
              </div>
            </dl>

            <a
              class="button button-primary sidebar-action"
              href="/miljo/kontor-konferens/"
            >
              Se kontor och konferens
            </a>
          </aside>
        </div>
      </section>

      <section class="reference-section reference-section--soft" aria-labelledby="resultat">
        <div class="avab-container">
          <div class="reference-section-heading">
            <span class="reference-kicker">Resultat</span>
            <h2 id="resultat">Verifierade funktioner i den färdiga lösningen</h2>
            <p>
              Resultatet beskrivs som levererade funktioner. Sidan gör inga
              antaganden om tidsbesparing, produktivitet eller kostnadseffekt.
            </p>
          </div>

          <div class="reference-summary-grid">
            <article class="reference-summary">
              <span class="reference-summary-number">Verifierat</span>
              <h3>Presentation och bild</h3>
              <p>
                Båda nya rummen har 85-tums bild och trådlös presentation via
                Crestron AirMedia 3 med två USB-C-donglar per rum.
              </p>
            </article>

            <article class="reference-summary">
              <span class="reference-summary-number">Verifierat</span>
              <h3>Två mötessätt</h3>
              <p>
                Det lilla rummet har Crestron Flex MTR/BYOD. Det stora har en
                Sennheiser-videobar för kamera, mikrofon och högtalare.
              </p>
            </article>

            <article class="reference-summary">
              <span class="reference-summary-number">Verifierat</span>
              <h3>Status vid dörren</h3>
              <p>
                Crestron-paneler utanför fyra konferensrum visar om respektive
                rum är ledigt eller bokat.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="reference-section" aria-labelledby="bilder">
        <div class="avab-container">
          <div class="reference-section-heading">
            <span class="reference-kicker">Bildberättelse</span>
            <h2 id="bilder">Mötesteknik i de färdiga rummen</h2>
            <p>
              Bilderna visar den gemensamma bildytan och hur styrning respektive
              videobar placerats i mötesmiljön.
            </p>
          </div>

          <div class="gallery-grid">
            {gallery.map((image) => (
              <figure>
                <div class="gallery-image">
                  <img
                    src={image.src}
                    alt={image.alt}
                    width={image.width}
                    height={image.height}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <figcaption>{image.caption}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>

      <section class="reference-section reference-section--soft">
        <div class="avab-container reference-content-grid">
          <article class="reference-article">
            <div class="reference-section-heading">
              <span class="reference-kicker">Teknisk fördjupning</span>
              <h2>Tekniken finns tillgänglig utan att dominera sidan</h2>
              <p>
                Inköpare och projektörer kan öppna sammanfattningen vid behov.
              </p>
            </div>

            <details class="technical-details">
              <summary>Visa teknisk sammanfattning</summary>
              <div class="technical-content">
                <ul>
                  <li>Samsung PRO-display, 85 tum, UHD/4K, 16:9</li>
                  <li>Crestron AirMedia 3</li>
                  <li>Två USB-C-donglar per rum</li>
                  <li>Crestron Flex MTR-system</li>
                  <li>BYOD</li>
                  <li>HDBaseT i lilla rummet</li>
                  <li>Touchpanel på bordet</li>
                  <li>Sennheiser TeamConnect Videobar Medium</li>
                  <li>Crestron rumsbokningspaneler</li>
                </ul>
              </div>
            </details>
          </article>

          <aside class="reference-sidebar">
            <h2>Relaterad kompetens</h2>
            <dl class="sidebar-facts">
              <div>
                <dt>Miljö</dt>
                <dd>
                  <a class="text-link" href="/miljo/kontor-konferens/">
                    Kontor och konferens
                  </a>
                </dd>
              </div>
              <div>
                <dt>Tjänst</dt>
                <dd>
                  <a class="text-link" href="/tjanster/styrsystem-integration/">
                    Styrsystem och integration
                  </a>
                </dd>
              </div>
            </dl>
          </aside>
        </div>
      </section>

      <section class="reference-section" aria-labelledby="relevans">
        <div class="avab-container">
          <div class="reference-section-heading">
            <span class="reference-kicker">Överförbar erfarenhet</span>
            <h2 id="relevans">Därför är referensen relevant för liknande projekt</h2>
            <p>
              Referensen visar hur en gemensam grund kan kombineras med
              rumsspecifik teknik och bokningsstatus för flera mötesrum.
            </p>
          </div>

          <div class="relevance-grid">
            {relevance.map((item) => <div class="relevance-item">{item}</div>)}
          </div>
        </div>
      </section>

      <section class="reference-section reference-section--soft" aria-labelledby="relaterade">
        <div class="avab-container">
          <div class="reference-section-heading">
            <span class="reference-kicker">Relaterade referenser</span>
            <h2 id="relaterade">Fler miljöer med teknik i flera rum</h2>
          </div>

          <div class="related-grid">
            {relatedReferences.map((reference) => (
              <a class="related-card" href={reference.href}>
                <img
                  src={reference.image}
                  alt={reference.alt}
                  width={reference.width}
                  height={reference.height}
                  loading="lazy"
                  decoding="async"
                />
                <div class="related-card-content">
                  <h3>{reference.title}</h3>
                  <p>{reference.text}</p>
                  <span>Se referensen</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <PageCTA
        eyebrow="Konferensrum som fungerar i vardagen"
        title="Planerar ni nya eller uppgraderade mötesrum?"
        text="Vi hjälper er från behovsanalys och projektering till installation, driftsättning och support."
        primaryLabel="Boka kostnadsfri rådgivning"
        primaryHref="/kontakt/"
        secondaryLabel="Läs om konferenslösningar"
        secondaryHref="/miljo/kontor-konferens/"
        points={[
          "Trådlös presentation med tydlig användning",
          "Teams- och BYOD-lösningar anpassade efter rummet",
          "Styrning, installation och support från samma partner",
        ]}
      />
    </main>

    <SiteFooter />
  </body>
</html>
