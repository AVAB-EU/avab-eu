          top: var(--avab-nav-height, 72px);
          z-index: 20;
          padding: 6px 0;
          background: var(--avab-light);
        }

        .case-nav {
          position: static;
          display: flex;
          gap: 5px;
          overflow-x: auto;
          padding: 7px;
          scrollbar-width: none;
        }

        .case-nav::-webkit-scrollbar { display: none; }
        .case-nav-title { display: none; }
        .case-nav a { flex: 0 0 auto; padding: 8px 11px; white-space: nowrap; }
        .case-nav a::before { display: none; }
      }

      @media (max-width: 820px) {
        .case-photo-grid--land.case-photo-grid--cols-3 {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .case-photo-grid--portrait.case-photo-grid--cols-3 {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .case-photo-grid--portrait.case-photo-grid--cols-2 {
          max-width: none;
        }

        .case-split,
        .case-split--reverse {
          grid-template-columns: 1fr;
        }

        .case-split--reverse .case-split__media,
        .case-split--reverse figcaption {
          order: initial;
        }

        .case-split--landscape .case-split__media {
          aspect-ratio: 1.6 / 1;
        }

        .case-split--portrait {
          grid-template-columns: minmax(220px, 0.72fr) minmax(0, 1.28fr);
        }

        .case-split--portrait .case-split__media {
          aspect-ratio: 3 / 4;
        }
      }

      @media (max-width: 620px) {
        .minneberg-case { padding: 52px 0 60px; }
        .case-intro { margin-bottom: 36px; }
        .case-section { padding-bottom: 44px; margin-bottom: 44px; }
        .case-photo-grid--land,
        .case-photo-grid--pano,
        .case-photo-grid--portrait {
          grid-template-columns: minmax(0, 1fr);
          max-width: none;
        }

        .case-photo-grid--tall,
        .case-photo-grid--slim {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          max-width: none;
        }

        .case-photo-grid--pano .case-photo__media {
          aspect-ratio: 16 / 9;
        }

        .case-photo-grid--split.case-photo-grid--portrait .case-photo {
          grid-template-columns: minmax(0, 1fr);
          grid-template-rows: auto 1fr;
        }

        .case-photo-grid--split.case-photo-grid--tall .case-photo {
          grid-template-columns: minmax(0, 42%) minmax(0, 1fr);
        }

        .case-photo-grid--split .case-photo figcaption {
          padding: 16px 17px 18px;
        }

        .case-split--portrait {
          grid-template-columns: 1fr;
          max-width: none;
        }

        .case-split--landscape .case-split__media {
          aspect-ratio: 3 / 2;
        }

        .case-split--portrait .case-split__media {
          aspect-ratio: 3 / 4;
        }

        .case-split figcaption { padding: 20px; }
      }
    </style>
  </body>
</html>
