      .case-photo-grid--pano .case-photo__media { aspect-ratio: 2.17 / 1; }
      .case-photo-grid--land .case-photo__media { aspect-ratio: 1.4 / 1; }
      .case-photo-grid--portrait .case-photo__media { aspect-ratio: 3 / 4; }
      .case-photo-grid--tall .case-photo__media { aspect-ratio: 1 / 2; }
      .case-photo-grid--slim .case-photo__media { aspect-ratio: 0.46 / 1; }

      /* Ensam stående bild ligger bredvid sin text i stället för ensam i raden */
      .case-photo-grid--split .case-photo {
        grid-template-rows: auto;
        align-items: stretch;
      }

      .case-photo-grid--split.case-photo-grid--portrait .case-photo {
        grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
      }

      .case-photo-grid--split.case-photo-grid--tall .case-photo {
        grid-template-columns: minmax(0, 200px) minmax(0, 1fr);
      }

      .case-photo-grid--split.case-photo-grid--tall .case-photo__media {
        aspect-ratio: 0.46 / 1;
      }

      .case-photo-grid--split .case-photo figcaption {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 22px 24px;
      }

      .case-photo figcaption {
        padding: 15px 16px 17px;
        background: var(--avab-white);
      }

      .case-photo h3 {
        margin: 0 0 6px;
        font-size: 1rem;
        line-height: 1.24;
      }

      .case-photo p {
        margin: 0;
        color: var(--avab-dark-muted);
        font-size: 0.9rem;
        line-height: 1.48;
      }

      .case-nav-wrap {
        position: relative;
        align-self: stretch;
      }

      .case-nav {
        position: sticky;
        top: calc(var(--avab-nav-height, 72px) + 22px);
        display: grid;
        gap: 2px;
        padding: 14px;
        background: var(--avab-white);
        border: 1px solid var(--avab-border);
        border-radius: 14px;
        box-shadow: var(--avab-shadow-sm);
      }

      .case-nav-title {
        margin: 0 0 7px;
        padding: 0 8px;
        color: var(--avab-dark-muted);
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .case-nav a {
        position: relative;
        padding: 8px 8px 8px 14px;
        border-radius: 8px;
        color: var(--avab-dark-muted);
        font-size: 0.81rem;
        font-weight: 700;
        line-height: 1.22;
      }

      .case-nav a::before {
        content: "";
        position: absolute;
        left: 5px;
        top: 50%;
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: var(--avab-grey);
        transform: translateY(-50%);
      }

      .case-nav a:hover { color: var(--avab-green); }
      .case-nav a.is-active {
        color: var(--avab-dark);
        background: var(--avab-green-soft);
      }

      .case-nav a.is-active::before {
        height: 16px;
        border-radius: 4px;
        background: var(--avab-green);
      }

      @media (max-width: 1040px) {
        .case-layout {
          display: flex;
          flex-direction: column;
          gap: 24px;
        }

