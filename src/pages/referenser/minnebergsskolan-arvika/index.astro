const reference = (await getCollection("references")).find(
  (entry) => entry.data.slug === "/referenser/minnebergsskolan-arvika/",
);

if (!reference) {
  throw new Error("Referensen Minnebergsskolan, Arvika saknas i content collection.");
}

const data = reference.data;
const canonicalUrl = absoluteUrl(data.slug);
const heroImageUrl = absoluteUrl(data.heroImage.src);
const publishedDate = data.publishedDate.toISOString().slice(0, 10);
const updatedDate = "2026-08-16";
const robots = data.draft || data.seo.noindex
  ? "noindex, nofollow"
