---
import { getCollection } from "astro:content";
import ReferencePage from "../../../layouts/ReferencePage.astro";

const reference = (await getCollection("references")).find(
  (entry) => entry.data.slug === "/referenser/sorby-sporthall-kumla/",
);

if (!reference) {
  throw new Error("Referensen Sörby idrottshall, Kumla saknas i content collection.");
}
---

<ReferencePage reference={reference} />
