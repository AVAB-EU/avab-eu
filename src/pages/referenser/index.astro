---
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import PageCTA from "../../components/PageCTA.astro";
import ReferenceCard from "../../components/ReferenceCard.astro";
import { getCollection } from "astro:content";
import { absoluteUrl, SITE_URL } from "../../config/site";
import {
  references as legacyReferences,
  environments,
  technologies,
  type Reference,
} from "../../data/referenser";
import "../../styles/avab.css";

const contentReferences: Reference[] = (await getCollection("references"))
  .map((entry) => ({
    title: entry.data.archive.title,
    slug: entry.data.slug,
    location: entry.data.location,
    filterLocation: entry.data.filterLocation || entry.data.location,
    image: entry.data.archive.image.src,
    imageAlt: entry.data.archive.image.alt,
    excerpt: entry.data.archive.excerpt,
    environments: entry.data.archive.environments,
    technologies: entry.data.archive.technologies,
    cardTechnologies: entry.data.archive.cardTechnologies,
    featured: entry.data.archive.featured,
  }));

const migratedSlugs = new Set(contentReferences.map((reference) => reference.slug));
const references = [
  ...legacyReferences.filter((reference) => !migratedSlugs.has(reference.slug)),
  ...contentReferences,
];
const locations = [...new Map(
  references.map((reference) => {
    const place = reference.filterLocation || reference.location;
    return [place.toLocaleLowerCase("sv"), place];
  }),
).entries()]
  .map(([id, label]) => ({ id, label }))
  .sort((a, b) => a.label.localeCompare(b.label, "sv"));

// Utvalda projekt till förtroendebandet (fasta siffror som säljer).
const trustItems = [
  { stat: "494 högtalare", label: "Hundfjällshotellet, Sälen" },
  { stat: "28 ljudzoner", label: "Hundfjället, appstyrt" },
  { stat: "900 elever", label: "Minnebergsskolan, Arvika" },
  { stat: "24 ljudzoner", label: "Friskis&Svettis Karlstad" },
  { stat: "18+ år", label: "Kundrelation, Claessons" },
  { stat: "8 zoner", label: "Lundsbergs skola" },
];

// Sortera: utvalda först, därefter i datafilens ordning.
const sorted = [...references].sort((a, b) => Number(b.featured ?? false) - Number(a.featured ?? false));

const total = references.length;

// ItemList för schema.
const itemListElements = sorted.map((ref, i) => ({
  "@type": "ListItem",
  position: i + 1,
  url: absoluteUrl(ref.slug),
  name: ref.title,
}));
---

<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Referenser – AV-projekt inom ljud, bild, ljus och styrning | AVAB</title>
  <meta name="description" content="Ett urval av AVAB:s projekt inom ljud, bild, ljus, styrsystem, hörslingor, mikrofoner och kamera i simhallar, sporthallar, skolor, gym, hotell, restauranger, konferens och offentliga miljöer." />
  <link rel="canonical" href={absoluteUrl("/referenser/")} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta name="author" content="AVAB" />
  <meta name="theme-color" content="#282E29" />

  <meta property="og:title" content="Referenser – AVAB:s AV-projekt" />
  <meta property="og:description" content="Filtrera AVAB:s referenser på miljö och teknik: simhall, sporthall, skola, gym, hotell, konferens, industri och mer." />
  <meta property="og:image" content={absoluteUrl("/assets/fjallanlaggning-vinterkvall.webp")} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="800" />
  <meta property="og:image:alt" content="Ett urval av AVAB:s AV-projekt" />
  <meta property="og:url" content={absoluteUrl("/referenser/")} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="sv_SE" />
  <meta property="og:site_name" content="AVAB" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Referenser – AVAB:s AV-projekt" />
  <meta name="twitter:description" content="Filtrera AVAB:s referenser på miljö och teknik." />
  <meta name="twitter:image" content={absoluteUrl("/assets/fjallanlaggning-vinterkvall.webp")} />
  <meta name="twitter:image:alt" content="Ett urval av AVAB:s AV-projekt" />

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${absoluteUrl("/referenser/")}#webpage`,
    "url": absoluteUrl("/referenser/"),
    "name": "Referenser – AVAB:s AV-projekt",
    "description": "Ett urval av AVAB:s projekt inom ljud, bild, ljus, styrsystem, hörslingor, mikrofoner och kamera.",
    "inLanguage": "sv-SE",
    "isPartOf": { "@type": "WebSite", "name": "AVAB", "url": `${SITE_URL}/` },
    "breadcrumb": { "@id": `${absoluteUrl("/referenser/")}#breadcrumb` },
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": total,
      "itemListElement": itemListElements
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${absoluteUrl("/referenser/")}#breadcrumb`,
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Start", "item": `${SITE_URL}/` },
      { "@type": "ListItem", "position": 2, "name": "Referenser", "item": absoluteUrl("/referenser/") }
    ]
  })} />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    /* ---- Förtroendeband ---- */
    .trust-band { border-top: 1px solid var(--avab-border); border-bottom: 1px solid var(--avab-border); background: var(--avab-white); }
    .trust-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 0; }
    .trust-cell { padding: 26px 22px; text-align: center; border-left: 1px solid var(--avab-border); }
    .trust-cell:first-child { border-left: none; }
    .trust-cell strong { display: block; color: var(--avab-dark); font-size: 1.25rem; line-height: 1.1; margin-bottom: 6px; }
    .trust-cell span { color: var(--avab-dark-muted); font-size: 0.85rem; }

    /* ---- Kompakta referensfilter ---- */
    .filter-panel {
      margin-top: 8px;
      width: 100%;
      min-width: 0;
    }

    .filter-search {
      width: 100%;
      max-width: none;
      padding: 13px 18px;
      border: 1px solid var(--avab-border);
      border-radius: var(--avab-radius-sm);
      background: var(--avab-white);
      font-family: inherit;
      font-size: 1rem;
      color: var(--avab-dark);
      margin-bottom: 22px;
    }
    .filter-search:focus-visible {
      outline: 3px solid var(--avab-green);
      outline-offset: 2px;
      border-color: var(--avab-green);
    }

    .filter-accordions {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-areas:
        "env tech place"
        "options options options";
      gap: 26px;
    }

    .filter-accordion {
      display: contents;
      border: 1px solid var(--avab-border);
      border-radius: var(--avab-radius-sm);
      background: var(--avab-white);
      overflow: clip;
    }

    .filter-accordion-trigger {
      width: 100%;
      min-height: 88px;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas:
        "icon title meta"
        "icon help meta";
      column-gap: 12px;
      row-gap: 3px;
      align-items: center;
      padding: 15px 16px;
      border: 0;
      background: transparent;
      color: var(--avab-dark);
      font: inherit;
      text-align: left;
      cursor: pointer;
    }

    #envFilterTrigger { grid-area: env; }
    #techFilterTrigger { grid-area: tech; }
    #placeFilterTrigger { grid-area: place; }

    .filter-accordion-trigger:hover {
      background: var(--avab-light);
    }

    .filter-accordion-trigger:focus-visible {
      outline: 3px solid var(--avab-green);
      outline-offset: -3px;
    }

    .filter-accordion-icon {
      grid-area: icon;
      display: block;
      width: 22px !important;
      min-width: 22px;
      max-width: 22px;
      height: 22px !important;
      min-height: 22px;
      max-height: 22px;
      color: var(--avab-green);
      flex: none;
    }

    .filter-accordion-copy {
      min-width: 0;
      display: contents;
    }

    .filter-accordion-title {
      grid-area: title;
      font-size: 0.9rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .filter-accordion-help {
      grid-area: help;
      min-width: 0;
      color: var(--avab-dark-muted);
      font-size: 0.88rem;
      line-height: 1.35;
    }

    .filter-accordion-meta {
      grid-area: meta;
      display: inline-flex;
      align-items: center;
      gap: 9px;
      white-space: nowrap;
      color: var(--avab-dark-muted);
      font-size: 0.85rem;
      font-weight: 700;
    }

    .filter-accordion-count[hidden] { display: none; }

    .filter-accordion-chevron {
      width: 9px;
      height: 9px;
      border-right: 2px solid var(--avab-green);
      border-bottom: 2px solid var(--avab-green);
      transform: rotate(45deg) translateY(-2px);
      transition: transform 180ms ease;
    }

    .filter-accordion-trigger[aria-expanded="true"] .filter-accordion-chevron {
      transform: rotate(225deg) translate(-2px, -2px);
    }

    .filter-options {
      grid-area: options;
      min-width: 0;
      padding: 18px;
      border: 1px solid var(--avab-border);
      border-radius: var(--avab-radius-sm);
      background: var(--avab-white);
    }

    .filter-options[hidden] { display: none; }

    .checkbox-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 4px 20px;
    }

    .filter-checkbox-label {
      display: flex;
      align-items: center;
      gap: 10px;
      min-height: 44px;
      padding: 7px 8px;
      border-radius: var(--avab-radius-sm);
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      color: var(--avab-dark);
      transition: background 180ms ease;
    }
    .filter-checkbox-label:hover { background: var(--avab-light); }
    .filter-checkbox-label input {
      width: 19px;
      height: 19px;
      margin: 0;
      accent-color: var(--avab-green);
      flex: 0 0 auto;
    }
    .filter-checkbox-label input:focus-visible {
      outline: 3px solid var(--avab-green);
      outline-offset: 3px;
    }

    .filter-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      flex-wrap: wrap;
      margin-top: 16px;
    }
    .result-count { font-weight: 800; color: var(--avab-dark); }
    .result-count span { color: var(--avab-green); }
    .clear-filters {
      background: none;
      border: none;
      color: var(--avab-dark-muted);
      font-family: inherit;
      font-size: 0.95rem;
      font-weight: 700;
      cursor: pointer;
      text-decoration: underline;
      text-underline-offset: 3px;
      padding: 8px 0;
    }
    .clear-filters:hover { color: var(--avab-green); }
    .clear-filters:focus-visible { outline: 3px solid var(--avab-green); outline-offset: 3px; }

    /* ---- Referensgrid ---- */
    .ref-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; margin-top: 34px; }

    .ref-meta { display: block; margin-bottom: 8px; color: var(--avab-green); font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.03em; }
    .ref-tech-list { margin: 16px 0 0; padding-left: 1.2rem; color: var(--avab-dark-muted); }
    .ref-tech-list li { margin: 3px 0; font-size: 0.88rem; font-weight: 600; }
    .ref-tech-list li::marker { color: var(--avab-green); }
    .no-results {
      display: none;
      margin-top: 34px;
      padding: 48px 32px;
      text-align: center;
      background: var(--avab-white);
      border: 1px solid var(--avab-border);
      border-radius: var(--avab-radius-sm);
      color: var(--avab-dark-muted);
    }
    .no-results strong { display: block; color: var(--avab-dark); font-size: 1.15rem; margin-bottom: 8px; }

    @media (max-width: 1024px) {
      .trust-grid { grid-template-columns: repeat(3, 1fr); }
      .trust-cell:nth-child(4) { border-left: none; }
      .ref-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 768px) {
      .trust-grid { grid-template-columns: repeat(2, 1fr); }
      .trust-cell:nth-child(odd) { border-left: none; }
      .ref-grid { grid-template-columns: 1fr; }
      .filter-accordions {
        display: block;
      }
      .filter-accordion { display: block; }
      .filter-accordion + .filter-accordion { margin-top: 10px; }
      .filter-panel { width: 100%; }
      #envFilterTrigger, #techFilterTrigger, #placeFilterTrigger { display: grid; grid-area: auto; width: 100%; }
      .filter-options { grid-area: auto; width: 100%; padding: 4px 16px 16px; }
      .checkbox-grid { grid-template-columns: minmax(0, 1fr); gap: 2px; }
      .filter-accordion-trigger { min-height: 84px; }
      .filter-accordion-help { font-size: 0.88rem; }
      .filter-options { padding: 4px 16px 16px; }
    }
  </style>
</head>
<body>
  <SiteHeader />

  <nav class="breadcrumbs" aria-label="Brödsmulor">
    <div class="avab-container">
      <ol>
        <li><a href="/">Start</a></li>
        <li><span aria-current="page">Referenser</span></li>
      </ol>
    </div>
  </nav>

  <main id="main">
    <section class="section section--light" style="padding-bottom: 40px;">
      <div class="avab-container">
        <div class="section-heading" style="max-width: 820px;">
          <div>
            <div class="eyebrow">Referenser</div>
            <h1>Projekt vi är stolta över</h1>
            <p class="lead-dark">Ett urval av AVAB:s projekt inom ljud, bild, ljus, styrsystem, hörslingor, mikrofoner, kamera och AV-teknik i simhallar, sporthallar, skolor, gym, hotell, restauranger, konferensanläggningar och offentliga miljöer.</p>
          </div>
        </div>
      </div>
    </section>

    <div class="trust-band">
      <div class="avab-container">
        <div class="trust-grid">
          {trustItems.map((item) => (
            <div class="trust-cell">
              <strong>{item.stat}</strong>
              <span>{item.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
    <section class="section">
      <div class="avab-container">

        <div class="filter-panel">
          <input
            type="search"
            class="filter-search"
            id="refSearch"
            placeholder="Sök på projekt, ort eller teknik…"
            aria-label="Sök bland referenser"
          />

          <div class="filter-accordions">
            <div class="filter-accordion">
              <button
                type="button"
                class="filter-accordion-trigger"
                id="envFilterTrigger"
                aria-expanded="false"
                aria-controls="envFilterOptions"
              >
                <svg class="filter-accordion-icon" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M4 5h16l-6.4 7.2v5.2l-3.2 1.6v-6.8L4 5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                </svg>
                <span class="filter-accordion-copy">
                  <span class="filter-accordion-title">Miljö</span>
                  <span class="filter-accordion-help">Filtrera efter vilken miljö du vill se.</span>
                </span>
                <span class="filter-accordion-meta">
                  <span class="filter-accordion-count" id="envFilterCount" hidden></span>
                  <span class="filter-accordion-chevron" aria-hidden="true"></span>
                </span>
              </button>
              <div class="filter-options" id="envFilterOptions" hidden>
                <div class="checkbox-grid">
                  {environments.map((env) => (
                    <label class="filter-checkbox-label">
                      <input type="checkbox" data-filter-type="env" value={env.id} />
                      <span>{env.label}</span>
                    </label>
                  ))}
                </div>
              </div>
            </div>

            <div class="filter-accordion">
              <button
                type="button"
                class="filter-accordion-trigger"
                id="techFilterTrigger"
                aria-expanded="false"
                aria-controls="techFilterOptions"
              >
                <svg class="filter-accordion-icon" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M4 5h16l-6.4 7.2v5.2l-3.2 1.6v-6.8L4 5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                </svg>
                <span class="filter-accordion-copy">
                  <span class="filter-accordion-title">Teknik</span>
                  <span class="filter-accordion-help">Filtrera efter teknik eller lösning.</span>
                </span>
                <span class="filter-accordion-meta">
                  <span class="filter-accordion-count" id="techFilterCount" hidden></span>
                  <span class="filter-accordion-chevron" aria-hidden="true"></span>
                </span>
              </button>
              <div class="filter-options" id="techFilterOptions" hidden>
                <div class="checkbox-grid">
                  {technologies.map((tech) => (
                    <label class="filter-checkbox-label">
                      <input type="checkbox" data-filter-type="tech" value={tech.id} />
                      <span>{tech.label}</span>
                    </label>
                  ))}
                </div>
              </div>
            </div>

            <div class="filter-accordion">
              <button
                type="button"
                class="filter-accordion-trigger"
                id="placeFilterTrigger"
                aria-expanded="false"
                aria-controls="placeFilterOptions"
              >
                <svg class="filter-accordion-icon" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M4 5h16l-6.4 7.2v5.2l-3.2 1.6v-6.8L4 5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                </svg>
                <span class="filter-accordion-copy">
                  <span class="filter-accordion-title">Ort / plats</span>
                  <span class="filter-accordion-help">Filtrera efter ort eller plats.</span>
                </span>
                <span class="filter-accordion-meta">
                  <span class="filter-accordion-count" id="placeFilterCount" hidden></span>
                  <span class="filter-accordion-chevron" aria-hidden="true"></span>
                </span>
              </button>
              <div class="filter-options" id="placeFilterOptions" hidden>
                <div class="checkbox-grid">
                  {locations.map((location) => (
                    <label class="filter-checkbox-label">
                      <input type="checkbox" data-filter-type="place" value={location.id} />
                      <span>{location.label}</span>
                    </label>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <div class="filter-actions">
            <span class="result-count" id="resultCount">Visar <span>{total}</span> av {total} referenser</span>
            <button type="button" class="clear-filters" id="clearFilters" hidden>Rensa allt</button>
          </div>
        </div>

        <div class="ref-grid" id="refGrid">
          {sorted.map((reference) => (
            <ReferenceCard reference={reference} environments={environments} technologies={technologies} />
          ))}
        </div>

        <div class="no-results" id="noResults">
          <strong>Inga referenser matchar filtren</strong>
          <p>Prova att välja färre filter eller rensa och börja om.</p>
        </div>
      </div>
    </section>

    <PageCTA
      eyebrow="Planerar ni ett liknande projekt?"
      title="Skicka underlaget, så hittar vi rätt nivå tillsammans"
      text="Skicka ritningar, FFU eller en kort beskrivning så hjälper vi er hitta rätt nivå på ljud, bild, ljus, styrning och tillgänglighet, från projektering till driftsatt och dokumenterad anläggning."
      primaryLabel="Ladda upp underlag"
      primaryHref="/kontakt/#kontaktformular"
      secondaryLabel="Läs om projektering"
      secondaryHref="/tjanster/projektering/"
      points={[
        "Ljud, bild, ljus och styrsystem i samma helhet.",
        "Mikrofoner, hörslingor och taluppfattbarhet.",
        "Projektering, installation och driftsättning.",
        "Service och support när verksamheten förändras.",
      ]}
    />
  </main>

  <SiteFooter />

  <script is:inline>
    (function () {
      const grid = document.getElementById("refGrid");
      const cards = Array.from(grid.querySelectorAll(".ref-filter-card"));
      const checkboxes = Array.from(document.querySelectorAll(".filter-checkbox-label input[type='checkbox']"));
      const search = document.getElementById("refSearch");
      const resultCount = document.getElementById("resultCount");
      const clearBtn = document.getElementById("clearFilters");
      const noResults = document.getElementById("noResults");
      const envFilterCount = document.getElementById("envFilterCount");
      const techFilterCount = document.getElementById("techFilterCount");
      const placeFilterCount = document.getElementById("placeFilterCount");
      const total = cards.length;

      const state = { env: new Set(), tech: new Set(), place: new Set(), q: "" };

      function readUrl() {
        const params = new URLSearchParams(window.location.search);
        state.env.clear();
        state.tech.clear();
        state.place.clear();
        (params.get("miljo") || "").split(",").filter(Boolean).forEach((id) => state.env.add(id));
        (params.get("teknik") || "").split(",").filter(Boolean).forEach((id) => state.tech.add(id));
        params.getAll("ort").forEach((location) => state.place.add(location.toLocaleLowerCase("sv")));
        state.q = (params.get("q") || "").toLowerCase();
      }

      function writeUrl() {
        const params = new URLSearchParams();
        if (state.env.size) params.set("miljo", Array.from(state.env).join(","));
        if (state.tech.size) params.set("teknik", Array.from(state.tech).join(","));
        state.place.forEach((location) => params.append("ort", location));
        if (state.q) params.set("q", state.q);
        const qs = params.toString();
        const url = qs ? window.location.pathname + "?" + qs : window.location.pathname;
        window.history.replaceState(null, "", url);
      }

      function matches(card) {
        const envs = (card.dataset.environments || "").split(" ").filter(Boolean);
        const techs = (card.dataset.technologies || "").split(" ").filter(Boolean);
        const place = card.dataset.filterLocation || "";

        // Miljö: matcha NÅGON vald miljö. Teknik: matcha NÅGON vald teknik.
        // Miljö + teknik samtidigt: båda grupperna måste matcha.
        if (state.env.size && !envs.some((e) => state.env.has(e))) return false;
        if (state.tech.size && !techs.some((t) => state.tech.has(t))) return false;
        if (state.place.size && !state.place.has(place)) return false;

        if (state.q) {
          const hay = [card.dataset.title, card.dataset.location, card.dataset.excerpt,
                       envs.join(" "), techs.join(" ")].join(" ");
          if (!hay.includes(state.q)) return false;
        }
        return true;
      }

      function apply() {
        let shown = 0;
        cards.forEach((card) => {
          const ok = matches(card);
          card.style.display = ok ? "" : "none";
          if (ok) shown++;
        });
        resultCount.innerHTML = "Visar <span>" + shown + "</span> av " + total + " referenser";
        noResults.style.display = shown === 0 ? "block" : "none";
        const active = state.env.size || state.tech.size || state.place.size || state.q;
        clearBtn.hidden = !active;

        envFilterCount.textContent = state.env.size ? state.env.size + " val" : "";
        envFilterCount.hidden = state.env.size === 0;
        techFilterCount.textContent = state.tech.size ? state.tech.size + " val" : "";
        techFilterCount.hidden = state.tech.size === 0;
        placeFilterCount.textContent = state.place.size ? state.place.size + " val" : "";
        placeFilterCount.hidden = state.place.size === 0;

        writeUrl();
      }

      function syncCheckboxes() {
        checkboxes.forEach((checkbox) => {
          const set = state[checkbox.dataset.filterType];
          checkbox.checked = set.has(checkbox.value);
        });
        if (state.q) search.value = state.q;
        else search.value = "";
      }

      checkboxes.forEach((checkbox) => {
        checkbox.addEventListener("change", () => {
          const set = state[checkbox.dataset.filterType];
          if (checkbox.checked) set.add(checkbox.value);
          else set.delete(checkbox.value);
          apply();
        });
      });

      search.addEventListener("input", () => { state.q = search.value.trim().toLowerCase(); apply(); });

      clearBtn.addEventListener("click", () => {
        state.env.clear(); state.tech.clear(); state.place.clear(); state.q = "";
        search.value = "";
        checkboxes.forEach((checkbox) => { checkbox.checked = false; });
        apply();
      });

      const filterTriggers = Array.from(document.querySelectorAll(".filter-accordion-trigger"));

      function setFilterOpen(trigger, open) {
        const panel = document.getElementById(trigger.getAttribute("aria-controls"));
        trigger.setAttribute("aria-expanded", open ? "true" : "false");
        panel.hidden = !open;
      }

      filterTriggers.forEach((trigger) => {
        trigger.addEventListener("click", () => {
          const nextOpen = trigger.getAttribute("aria-expanded") !== "true";
          filterTriggers.forEach((other) => setFilterOpen(other, other === trigger && nextOpen));
        });
      });

      window.addEventListener("popstate", () => {
        readUrl();
        syncCheckboxes();
        apply();
      });

      readUrl();
      syncCheckboxes();
      apply();
    })();
  </script>
</body>
</html>
