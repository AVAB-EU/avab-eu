---
import { getCollection } from "astro:content";
import ReferencePage from "../../../layouts/ReferencePage.astro";

const reference = (await getCollection("references")).find(
  (entry) => entry.data.slug === "/referenser/sannerudshallen-kil/",
);

if (!reference) {
  throw new Error("Referensen Sannerudshallen, Kil saknas i content collection.");
}
if (reference.data.draft) {
  return new Response(null, { status: 404 });
}
---

<ReferencePage reference={reference} />
