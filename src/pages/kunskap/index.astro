---
import PageCTA from "../../components/PageCTA.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import "../../styles/avab.css";

const pageTitle = "Kunskap om ljud, bild, ljus och AV-teknik | AVAB";
const pageDescription =
  "Fördjupa dig i AVAB:s kunskap om ljud, bild, ljus, kameraövervakning och smart styrning. Hitta guider och vägledning för AV-teknik som ska fungera i verkligheten.";
const canonicalUrl = "https://avab.eu/kunskap/";

const topics = [
  {
    id: "ljud",
    eyebrow: "Ljud",
    title: "Ljudlig kunskap",
    intro:
      "Fördjupa dig i hur kabelval, taluppfattbarhet och tillgängligt ljud påverkar en anläggning – från de första tekniska valen till en lösning som fungerar i lokalen.",
    cards: [
      {
        type: "Guide",
        title: "Kablar och kontakter för AV-teknik",
        text: "En praktisk genomgång av kabelval för ljud, bild, ljus, nätverk, hörslingor och mikrofoner.",
        href: "/kunskap/kablar-kontakter/",
        image: "/assets/takhogtalare-rad-takinstallation.webp",
        imageAlt: "Rad med takhögtalare i en AV-installation",
      },
      {
        type: "Fördjupning",
        title: "Taluppfattbarhet i publika lokaler",
        text: "Läs om hur AVAB mäter, analyserar och förbättrar tydligt tal i lokaler där akustiken ställer höga krav.",
        href: "/tjanster/taluppfattbarhet/",
        image: "/assets/STI-matning-hero.webp",
        imageAlt: "Mätutrustning för kontroll av taluppfattbarhet",
      },
      {
        type: "Fördjupning",
        title: "Hörslinga och tillgängligt ljud",
        text: "En introduktion till projektering, installation, mätning och certifiering av hörslingor och andra lösningar för tillgängligt ljud.",
        href: "/tjanster/horslinga/",
        image: "/assets/horslinga-installation-golv.webp",
        imageAlt: "Installation av hörslinga i golvkonstruktion",
      },
    ],
  },
  {
    id: "bild",
    eyebrow: "Bild",
    title: "Bildligt talat",
    intro:
      "Skärmar, projektorer och videolösningar behöver fungera tillsammans med rummets ljud, anslutningar och styrning. Här finns vägledning från verkliga AV-miljöer.",
    cards: [
      {
        type: "Guide",
        title: "Signaler, nätverk och bildanslutningar",
        text: "Kabelguiden förklarar bland annat HDMI, nätverkskabel och andra anslutningar som binder samman moderna AV-system.",
        href: "/kunskap/kablar-kontakter/",
        image: "/assets/av-projektering-laptop-ritningar.webp",
        imageAlt: "Laptop och tekniska ritningar för AV-projektering",
      },
      {
        type: "Miljö",
        title: "Bildteknik i kontor och konferensrum",
        text: "Se hur skärmar, kameror, mikrofoner och styrning samspelar i moderna mötesrum och hybridmöten.",
        href: "/miljo/kontor-konferens/",
        image: "/assets/konferensrum-stor-skarm-bord.webp",
        imageAlt: "Konferensrum med stor skärm och mötesbord",
      },
      {
        type: "Tjänst",
        title: "Installation av bild och AV-teknik",
        text: "Läs om installation av projektorer, skärmar, styrsystem och övrig AV-teknik med fokus på montage, kabel och funktion.",
        href: "/tjanster/installation/",
        image: "/assets/installation-hero.webp",
        imageAlt: "Tekniker installerar AV-utrustning",
      },
    ],
  },
  {
    id: "ljus",
    eyebrow: "Ljus",
    title: "Så lysande",
    intro:
      "Ljus är ofta en integrerad del av den tekniska helheten. Det nuvarande innehållet är begränsat, men de här sidorna visar hur ljus, styrning och AV möts i praktiken.",
    cards: [
      {
        type: "Guide",
        title: "DMX, kabel och styrsignal",
        text: "Kabelguiden går igenom vad som skiljer DMX-kabel från vanlig ljudkabel och vad som är viktigt i fasta installationer.",
        href: "/kunskap/kablar-kontakter/",
        image: "/assets/Crestronstyrning enkel grafik.webp",
        imageAlt: "Styrgränssnitt för integrerad AV-teknik",
      },
      {
        type: "Miljö",
        title: "Ljus och styrning i simhall",
        text: "Se hur färgljus, DMX, KNX och central styrning kan ingå i en komplett teknisk lösning för simhallar och badhus.",
        href: "/miljo/simhall/",
        image: "/assets/poolbelysning-fargljus.webp",
        imageAlt: "Färgbelysning i en bassängmiljö",
      },
      {
        type: "Miljö",
        title: "Ljud och ljus för restaurang, bar och klubb",
        text: "Läs om zonstyrt ljud, ljusscenarier, bild och styrsystem i miljöer som behöver kunna växla karaktär.",
        href: "/miljo/restaurang-bar-klubb/",
        image: "/assets/claessons-restaurang.webp",
        imageAlt: "Restaurangmiljö med integrerat ljud och ljus",
      },
    ],
  },
  {
    id: "kameraovervakning",
    eyebrow: "Kameraövervakning",
    title: "Säkerhet med bättre överblick",
    intro:
      "Kameraövervakning börjar med platsens behov. Fördjupa dig i funktioner, integration och hur lösningen kan anpassas för olika verksamheter.",
    cards: [
      {
        type: "Tjänst",
        title: "Kameraövervakning och smart sökning",
        text: "Läs om modern kameraövervakning med projektering, lagring, sökfunktioner och integration för olika verksamheter.",
        href: "/tjanster/kameraovervakning/",
        image: "/assets/overvakningskamera-fasad-hero.webp",
        imageAlt: "Övervakningskamera monterad på en fasad",
      },
      {
        type: "Miljö",
        title: "Teknik för parkering och garage",
        text: "Se hur kameraövervakning kan kombineras med ANPR, intercom, vägvisning och annan teknik i parkeringsmiljöer.",
        href: "/miljo/parkering-garage/",
        image: "/assets/kopcentrum-fasad-kvall.webp",
        imageAlt: "Köpcentrum och parkeringsmiljö i kvällsljus",
      },
      {
        type: "Miljö",
        title: "Kamera och AV-teknik i butik",
        text: "Läs om hur kameraövervakning, digital signage, bakgrundsmusik och central styrning kan samlas i butik och retail.",
        href: "/miljo/butik-retail/",
        image: "/assets/kopcentrum-galleria-kameraövervakning-hero.webp",
        imageAlt: "Kameraövervakning i en kommersiell miljö",
      },
    ],
  },
  {
    id: "smart-styrning",
    eyebrow: "Smart styrning",
    title: "Smart styrd information",
    intro:
      "När flera tekniska system ska användas av samma verksamhet blir ett tydligt gränssnitt och genomtänkt integration avgörande för vardagen.",
    cards: [
      {
        type: "Tjänst",
        title: "Styrsystem och integration",
        text: "Fördjupa dig i hur ljud, bild och ljus kan samlas i tydliga styrsystem som är enklare att använda.",
        href: "/tjanster/styrsystem-integration/",
        image: "/assets/styrpanel-pa-travagg.webp",
        imageAlt: "Styrpanel för ljud, bild och integrerad teknik",
      },
      {
        type: "Fördjupning",
        title: "Rastsignal, scheman och zoner",
        text: "Läs om rastsignalsystem med automatiska signaler, scheman, zoner och talmeddelanden för skolans vardag.",
        href: "/rastsignal/",
        image: "/assets/rastsignal-schoolbell-sb11.webp",
        imageAlt: "Signalapparat för ett modernt rastsignalsystem",
      },
      {
        type: "Miljö",
        title: "Central styrning i simhall",
        text: "Se hur ljudzoner, KNX, DMX, infoskärmar och andra funktioner kan hanteras i en sammanhängande simhallslösning.",
        href: "/miljo/simhall/",
        image: "/assets/styrpanel-ljudzoner.webp",
        imageAlt: "Styrpanel för ljudzoner i en simhall",
      },
    ],
  },
] as const;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: pageTitle,
  description: pageDescription,
  inLanguage: "sv-SE",
  isPartOf: {
    "@type": "WebSite",
    name: "AVAB",
    url: "https://avab.eu/",
  },
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Start",
      item: "https://avab.eu/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Kunskap",
      item: canonicalUrl,
    },
  ],
};
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#282e29" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:site_name" content="AVAB" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://avab.eu/assets/av-projektering-laptop-ritningar.webp" />
    <meta property="og:image:alt" content="Laptop och ritningar för projektering av AV-teknik" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </head>
  <body>
    <SiteHeader />

    <main id="main">
      <section class="knowledge-hero" aria-labelledby="knowledge-title">
        <div class="knowledge-hero__image" aria-hidden="true"></div>
        <div class="avab-container knowledge-hero__inner">
          <div class="knowledge-hero__content">
            <p class="knowledge-kicker">Kunskapsbank</p>
            <h1 id="knowledge-title">Kunskap</h1>
            <p class="knowledge-hero__statement">Du har frågorna, vi har svaren.</p>
            <p class="knowledge-hero__lead">
              Din guide till djupare insikter och förståelse inom ljud, bild,
              ljus, kameraövervakning och smart styrning.
            </p>
          </div>
        </div>
      </section>

      <section class="knowledge-intro" aria-labelledby="knowledge-intro-title">
        <div class="avab-container knowledge-intro__grid">
          <div>
            <p class="knowledge-kicker knowledge-kicker--dark">Teknik som blir begriplig</p>
            <h2 id="knowledge-intro-title">Hitta rätt väg genom AV-tekniken</h2>
          </div>
          <div class="knowledge-intro__copy">
            <p>
              Här samlar vi guider och fördjupning för dig som vill förstå hur
              tekniken hänger ihop innan du väljer, projekterar eller utvecklar
              en anläggning.
            </p>
            <p>
              Börja med ett ämne nedan. Varje kort leder direkt till en befintlig
              guide, tjänst eller miljösida med mer information.
            </p>
          </div>
        </div>

        <nav class="topic-nav avab-container" aria-label="Ämnen i kunskapsbanken">
          {topics.map((topic) => <a href={`#${topic.id}`}>{topic.eyebrow}</a>)}
        </nav>
      </section>

      <div class="knowledge-topics">
        {topics.map((topic, topicIndex) => (
          <section
            id={topic.id}
            class:list={["knowledge-topic", { "knowledge-topic--soft": topicIndex % 2 === 1 }]}
            aria-labelledby={`${topic.id}-title`}
          >
            <div class="avab-container">
              <header class="knowledge-topic__header">
                <p class="knowledge-kicker knowledge-kicker--dark">{topic.eyebrow}</p>
                <h2 id={`${topic.id}-title`}>{topic.title}</h2>
                <p>{topic.intro}</p>
              </header>

              <div class="knowledge-grid">
                {topic.cards.map((card) => (
                  <a class="knowledge-card" href={card.href}>
                    <div class="knowledge-card__media">
                      <img
                        src={card.image}
                        alt={card.imageAlt}
                        width="900"
                        height="600"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                    <div class="knowledge-card__body">
                      <span class="knowledge-card__type">{card.type}</span>
                      <h3>{card.title}</h3>
                      <p>{card.text}</p>
                      <span class="knowledge-card__cta" aria-hidden="true">Läs mer <span>→</span></span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          </section>
        ))}
      </div>

      <PageCTA
        eyebrow="Behöver du hjälp med nästa steg?"
        title="Vi hjälper dig göra kunskapen till en fungerande lösning"
        text="Berätta om lokalen, verksamheten eller den tekniska utmaningen så hjälper vi dig vidare."
        primaryLabel="Kontakta oss"
        primaryHref="/kontakt/"
        flush={true}
      />
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  .knowledge-hero {
    position: relative;
    min-height: clamp(430px, 52vw, 620px);
    display: grid;
    align-items: end;
    overflow: hidden;
    background: var(--avab-dark);
    color: #fff;
  }

  .knowledge-hero__image {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(90deg, rgba(24, 31, 27, 0.94) 0%, rgba(24, 31, 27, 0.78) 46%, rgba(24, 31, 27, 0.52) 100%),
      url("/assets/av-projektering-laptop-ritningar.webp");
    background-position: center;
    background-size: cover;
  }

  .knowledge-hero__inner {
    position: relative;
    z-index: 1;
    padding-top: clamp(88px, 12vw, 148px);
    padding-bottom: clamp(72px, 9vw, 112px);
  }

  .knowledge-hero__content {
    max-width: 760px;
  }

  .knowledge-kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 18px;
    color: var(--avab-green);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .knowledge-kicker::before {
    content: "";
    width: 32px;
    height: 3px;
    flex: 0 0 32px;
    border-radius: 999px;
    background: currentColor;
  }

  .knowledge-kicker--dark {
    color: var(--avab-green-dark);
  }

  .knowledge-hero h1 {
    max-width: 12ch;
    margin: 0;
    color: #fff;
    font-size: clamp(3.5rem, 8vw, 6.5rem);
    line-height: 0.95;
  }

  .knowledge-hero__statement {
    margin: 30px 0 8px;
    color: #fff;
    font-size: clamp(1.35rem, 2.4vw, 2rem);
    font-weight: 700;
    line-height: 1.25;
  }

  .knowledge-hero__lead {
    max-width: 62ch;
    margin: 0;
    color: rgba(255, 255, 255, 0.88);
    font-size: clamp(1rem, 1.6vw, 1.2rem);
  }

  .knowledge-intro {
    padding: var(--avab-section-space) 0 clamp(56px, 7vw, 76px);
    background: #fff;
  }

  .knowledge-intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(40px, 7vw, 96px);
    align-items: start;
  }

  .knowledge-intro h2,
  .knowledge-topic h2 {
    margin: 0;
  }

  .knowledge-intro__copy {
    max-width: 700px;
    color: var(--avab-dark-muted);
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
  }

  .knowledge-intro__copy p:last-child {
    margin-bottom: 0;
  }

  .topic-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: clamp(40px, 6vw, 64px);
  }

  .topic-nav a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 10px 18px;
    border: 1px solid var(--avab-border);
    border-radius: 999px;
    background: var(--avab-light);
    color: var(--avab-dark);
    font-weight: 700;
    text-decoration: none;
    transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease;
  }

  .topic-nav a:hover {
    border-color: var(--avab-green);
    background: var(--avab-green);
    color: var(--avab-dark);
  }

  .knowledge-topic {
    scroll-margin-top: calc(var(--avab-nav-height) + 20px);
    padding: var(--avab-section-space) 0;
    background: #fff;
  }

  .knowledge-topic--soft {
    background: var(--avab-light);
  }

  .knowledge-topic__header {
    display: grid;
    grid-template-columns: minmax(240px, 0.72fr) minmax(0, 1.28fr);
    column-gap: clamp(40px, 7vw, 96px);
    align-items: end;
    margin-bottom: clamp(32px, 5vw, 52px);
  }

  .knowledge-topic__header .knowledge-kicker {
    grid-column: 1 / -1;
  }

  .knowledge-topic__header > p:last-child {
    max-width: 700px;
    margin: 0;
    color: var(--avab-dark-muted);
    font-size: 1.08rem;
  }

  .knowledge-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--avab-card-gap);
  }

  .knowledge-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--avab-border);
    border-radius: var(--avab-radius);
    background: #fff;
    box-shadow: var(--avab-shadow-sm);
    color: var(--avab-dark);
    text-decoration: none;
    transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
  }

  .knowledge-card:hover {
    transform: translateY(-5px);
    border-color: rgba(143, 192, 37, 0.65);
    box-shadow: var(--avab-shadow-lg);
  }

  .knowledge-card:focus-visible {
    outline: var(--avab-focus);
    outline-offset: 4px;
  }

  .knowledge-card__media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--avab-grey);
  }

  .knowledge-card__media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 420ms ease;
  }

  .knowledge-card:hover .knowledge-card__media img {
    transform: scale(1.035);
  }

  .knowledge-card__body {
    min-height: 280px;
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: clamp(22px, 2.4vw, 30px);
  }

  .knowledge-card__type {
    margin-bottom: 12px;
    color: var(--avab-green-dark);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .knowledge-card h3 {
    margin: 0 0 12px;
    font-size: clamp(1.25rem, 1.8vw, 1.55rem);
    line-height: 1.2;
  }

  .knowledge-card p {
    margin: 0 0 24px;
    color: var(--avab-dark-muted);
    font-size: 0.98rem;
  }

  .knowledge-card__cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: auto;
    padding-top: 18px;
    border-top: 1px solid var(--avab-border);
    color: var(--avab-green-dark);
    font-weight: 800;
  }

  .knowledge-card__cta span {
    color: var(--avab-green);
    font-size: 1.25rem;
    transition: transform 180ms ease;
  }

  .knowledge-card:hover .knowledge-card__cta span {
    transform: translateX(4px);
  }

  @media (max-width: 960px) {
    .knowledge-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .knowledge-card:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 768px) {
    .knowledge-hero {
      min-height: 460px;
    }

    .knowledge-hero__image {
      background-image:
        linear-gradient(rgba(24, 31, 27, 0.8), rgba(24, 31, 27, 0.9)),
        url("/assets/av-projektering-laptop-ritningar.webp");
      background-position: 62% center;
    }

    .knowledge-hero__inner {
      padding-top: 88px;
      padding-bottom: 64px;
    }

    .knowledge-hero h1 {
      font-size: clamp(3.25rem, 18vw, 4.5rem);
    }

    .knowledge-intro,
    .knowledge-topic {
      padding-top: var(--avab-section-space-mobile);
      padding-bottom: var(--avab-section-space-mobile);
    }

    .knowledge-intro__grid,
    .knowledge-topic__header {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .topic-nav {
      flex-wrap: nowrap;
      width: 100%;
      overflow-x: auto;
      padding-bottom: 8px;
      scroll-snap-type: x proximity;
      scrollbar-width: thin;
    }

    .topic-nav a {
      flex: 0 0 auto;
      scroll-snap-align: start;
    }

    .knowledge-grid {
      grid-template-columns: 1fr;
    }

    .knowledge-card:last-child:nth-child(odd) {
      grid-column: auto;
    }

    .knowledge-card__body {
      min-height: 0;
      padding: 24px;
    }
  }

  @media (max-width: 430px) {
    .knowledge-hero {
      min-height: 430px;
    }

    .knowledge-hero__statement {
      margin-top: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .topic-nav a,
    .knowledge-card,
    .knowledge-card__media img,
    .knowledge-card__cta span {
      transition-duration: 0.01ms;
    }
  }
</style>
