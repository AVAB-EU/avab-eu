---
import { getCollection } from "astro:content";
import ServiceLandingPage from "../../../layouts/ServiceLandingPage.astro";

const page = (await getCollection("serviceLandingPages")).find(
  (entry) => entry.data.slug === "/tjanster/videomoten-byod/",
);

if (!page) throw new Error("Tjänstesidan för videomöten & BYOM saknas.");
---

<ServiceLandingPage page={page} />
