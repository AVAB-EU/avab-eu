---
import ContentSection from "../../components/ContentSection.astro";
import ExpandableServiceGrid from "../../components/ExpandableServiceGrid.astro";
import PageCTA from "../../components/PageCTA.astro";
import ReferenceCard from "../../components/ReferenceCard.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { environments, references, technologies } from "../../data/referenser";
import { serviceOverviewGroups } from "../../data/services";
import "../../styles/avab.css";
import "../../styles/services-showcase.css";

const deliverySteps = [
  { title: "Projektering", description: "Planering, behovsanalys och rätt teknisk lösning från start.", href: "/tjanster/projektering/" },
  { title: "Installation", description: "Professionell montering och genomförande anpassat efter miljön.", href: "/tjanster/installation/" },
  { title: "Driftsättning", description: "Systemen trimmas, testas och görs redo för verklig användning.", href: "/tjanster/driftsattning/" },
  { title: "Certifiering", description: "Verifiering och dokumentation där lösningen kräver det.", href: "/tjanster/certifiering/" },
  { title: "Överlämning", description: "En tydlig övergång till kundens vardag med genomgång och stöd.", href: "/tjanster/overlamning/" },
  { title: "Garanti & service", description: "Trygg support och långsiktig funktion efter leverans.", href: "/tjanster/garanti-och-service/" },
];

const featuredReferenceSlugs = [
  "/referenser/hundfjallshotellet-hundfjallscenter-salen/",
  "/referenser/minnebergsskolan-arvika/",
  "/referenser/saffle-simhall/",
];
const featuredReferences = featuredReferenceSlugs
  .map((slug) => references.find((reference) => reference.slug === slug))
  .filter((reference): reference is (typeof references)[number] => Boolean(reference));
const pageTitle = "AV-tjänster för ljud, bild, säkerhet och styrning | AVAB";
const pageDescription = "Översikt över AVAB:s tjänster inom ljud, kommunikation, tillgänglighet, säkerhet, bakgrundsmusik och styrsystem.";
const canonical = "https://avab.eu/tjanster/";
const socialImage = "https://avab.eu/assets/tjanster-hero-integrerad-av-teknik.webp";
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Start", item: "https://avab.eu/" },
    { "@type": "ListItem", position: 2, name: "Tjänster", item: canonical },
  ],
};
---

<!DOCTYPE html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#282E29" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="AV-projektering med ritningar och tekniskt underlag" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:site_name" content="AVAB" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </head>
  <body>
    <SiteHeader />
    <main id="main">
      <header class="service-overview-hero">
        <div class="avab-container service-overview-hero__inner">
          <h1>Tjänster</h1>
          <p>Ljud, bild, säkerhet och styrning – från projektering till färdig anläggning.</p>
          <a class="button button-primary" href="/kontakt/">Kontakta oss</a>
        </div>
      </header>

      <ContentSection labelledby="service-directory-title">
        <div class="service-overview-heading">
          <p class="eyebrow">Våra tjänster</p>
          <h2 id="service-directory-title">Hitta rätt lösning</h2>
        </div>
        <ExpandableServiceGrid groups={serviceOverviewGroups} />
      </ContentSection>

      <div class="services-showcase">
        <div class="services-showcase__glow" aria-hidden="true"></div>
      <section class="delivery-showcase" aria-labelledby="delivery-title">
        <div class="avab-container delivery-showcase__inner">
          <div class="delivery-showcase__intro">
            <p class="delivery-showcase__eyebrow">Vår leverans</p>
            <h2 id="delivery-title">Från idé till fungerande anläggning</h2>
            <p>AVAB kan hjälpa genom hela leveransen – från planering och installation till överlämning och långsiktig service.</p>
          </div>
          <ol class="delivery-process">
            {deliverySteps.map((step, index) => (
              <li>
                <a href={step.href}>
                  <span class="delivery-process__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                  <span class="delivery-process__copy">
                    <strong>{step.title}</strong>
                    <span>{step.description}</span>
                  </span>
                  <span class="delivery-process__arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="reference-showcase" aria-labelledby="service-references-title">
        <div class="avab-container reference-showcase__intro">
          <div class="reference-showcase__heading">
            <p class="reference-showcase__eyebrow">Referenser</p>
            <h2 id="service-references-title">Tjänster i verkliga projekt</h2>
            <p>Se hur AVAB:s lösningar används i verkliga projekt – från skolor och simhallar till hotell och andra tekniskt krävande miljöer.</p>
          </div>
          <div class="reference-showcase__actions">
            <a class="reference-showcase__all" href="/referenser/">Se alla referenser <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="reference-showcase__cases">
          <ol class="featured-cases" aria-label="Utvalda referensprojekt">
            {featuredReferences.map((reference, index) => (
              <li class:list={["featured-cases__item", index === 0 && "featured-cases__item--primary"]}>
                <ReferenceCard reference={reference} environments={environments} technologies={technologies} />
              </li>
            ))}
          </ol>
        </div>
      </section>
      </div>

      <PageCTA title="Osäker på vilken lösning ni behöver?" text="Berätta vad ni vill lösa så hjälper vi er vidare." primaryLabel="Kontakta AVAB" primaryHref="/kontakt/" />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .services-showcase {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(circle at 74% 40%, rgba(74, 106, 133, 0.2), transparent 31%),
      linear-gradient(168deg, #2e6b6b 0%, #2b615b 34%, #294c47 61%, #282e29 100%);
  }

  .services-showcase__glow {
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      radial-gradient(ellipse 55% 40% at 82% 24%, rgba(143, 192, 37, 0.17), transparent 72%),
      radial-gradient(ellipse 58% 38% at 26% 78%, rgba(143, 192, 37, 0.1), transparent 76%);
    filter: blur(48px);
    pointer-events: none;
  }

  .delivery-showcase {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: #e6e8e6;
  }

  .delivery-showcase::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    opacity: 0.22;
    background-image: radial-gradient(rgba(238, 241, 239, 0.55) 0.8px, transparent 0.8px);
    background-size: 24px 24px;
    mask-image: linear-gradient(180deg, #000 0%, #000 68%, transparent 100%);
  }

  .delivery-showcase__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(540px, 1.18fr);
    gap: clamp(56px, 7vw, 112px);
    align-items: center;
    padding-top: clamp(88px, 10vw, 144px);
    padding-bottom: clamp(88px, 10vw, 144px);
  }

  .delivery-showcase__intro { max-width: 620px; }

  .delivery-showcase__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 22px;
    color: #8fc025;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .delivery-showcase__eyebrow::before {
    content: "";
    width: 34px;
    height: 2px;
    background: currentColor;
    box-shadow: 0 0 14px rgba(143, 192, 37, 0.75);
  }

  .delivery-showcase h2 {
    max-width: 720px;
    margin: 0 0 28px;
    color: #e6e8e6;
    font-size: clamp(2.7rem, 5vw, 5.35rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .delivery-showcase__intro > p:last-child {
    max-width: 570px;
    margin: 0;
    color: rgba(238, 241, 239, 0.82);
    font-size: clamp(1.05rem, 1.5vw, 1.22rem);
    line-height: 1.75;
  }

  .delivery-process {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .delivery-process::before {
    content: "";
    position: absolute;
    inset: 50% -32px auto;
    z-index: -1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(143, 192, 37, 0.72), rgba(74, 106, 133, 0.65), transparent);
    box-shadow: 0 0 14px rgba(143, 192, 37, 0.35);
  }

  .delivery-process a {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 16px;
    align-items: start;
    min-height: 168px;
    padding: 24px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 20px;
    color: #eef1ef;
    background: linear-gradient(145deg, rgba(40, 46, 41, 0.56), rgba(46, 107, 107, 0.42));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07), 0 18px 45px rgba(20, 37, 34, 0.16);
    backdrop-filter: blur(10px);
    transition: transform 260ms ease, border-color 260ms ease, box-shadow 260ms ease, background-color 260ms ease;
  }

  .delivery-process a::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, #8fc025, #4a6a85 62%, transparent);
    opacity: 0.55;
    transition: opacity 260ms ease, transform 260ms ease;
    transform: scaleX(0.5);
    transform-origin: left;
  }

  .delivery-process a:hover {
    color: #ffffff;
    text-decoration: none !important;
    transform: translateY(-5px);
    border-color: rgba(143, 192, 37, 0.58);
    background: linear-gradient(145deg, rgba(40, 46, 41, 0.72), rgba(74, 106, 133, 0.48));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 22px 52px rgba(17, 34, 31, 0.28), 0 0 26px rgba(143, 192, 37, 0.09);
  }

  .delivery-process a:hover::before,
  .delivery-process a:focus-visible::before { opacity: 1; transform: scaleX(1); }

  .delivery-process a:focus-visible {
    outline: 3px solid #8fc025;
    outline-offset: 4px;
    transform: translateY(-3px);
  }

  .delivery-process__number {
    color: #8fc025;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .delivery-process__copy { display: block; min-width: 0; }
  .delivery-process__copy strong { display: block; margin-bottom: 10px; color: #ffffff; font-size: 1.08rem; line-height: 1.25; }
  .delivery-process__copy > span { display: block; color: rgba(238, 241, 239, 0.72); font-size: 0.88rem; line-height: 1.55; }
  .delivery-process__arrow { align-self: end; color: #8fc025; font-size: 1.25rem; transition: transform 260ms ease; }
  .delivery-process a:hover .delivery-process__arrow,
  .delivery-process a:focus-visible .delivery-process__arrow { transform: translateX(5px); }

  @media (max-width: 1000px) {
    .delivery-showcase__inner { grid-template-columns: 1fr; gap: 52px; }
    .delivery-showcase__intro { max-width: 760px; }
  }

  @media (max-width: 600px) {
    .delivery-showcase::before { mask-image: none; opacity: 0.12; }
    .services-showcase__glow { opacity: 0.72; filter: blur(36px); }
    .delivery-showcase__inner { gap: 38px; padding-top: 64px; padding-bottom: 64px; }
    .delivery-showcase h2 { font-size: clamp(2.5rem, 13vw, 3.65rem); }
    .delivery-process { grid-template-columns: 1fr; gap: 12px; }
    .delivery-process::before { inset: -20px auto -20px 26px; width: 1px; height: auto; background: linear-gradient(180deg, transparent, rgba(143, 192, 37, 0.5), transparent); }
    .delivery-process a { min-height: 0; padding: 22px 20px; border-radius: 17px; }
    .delivery-process__copy > span { font-size: 0.92rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .delivery-process a,
    .delivery-process a::before,
    .delivery-process__arrow { transition-duration: 0.01ms; }
  }

  .reference-showcase {
    position: relative;
    overflow: hidden;
    color: #eef1ef;
  }

  .reference-showcase__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 48px;
    align-items: end;
    padding-top: clamp(78px, 8vw, 118px);
    padding-bottom: 42px;
  }

  .reference-showcase__heading { max-width: 760px; }

  .reference-showcase__eyebrow {
    display: flex;
    align-items: center;
    gap: 11px;
    margin: 0 0 18px;
    color: #8fc025;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .reference-showcase__eyebrow::before {
    content: "";
    width: 30px;
    height: 2px;
    background: currentColor;
    box-shadow: 0 0 12px rgba(143, 192, 37, 0.48);
  }

  .reference-showcase h2 {
    margin: 0 0 18px;
    color: #ffffff;
    font-size: clamp(2.4rem, 4.6vw, 4.65rem);
    line-height: 1.02;
    letter-spacing: -0.048em;
  }

  .reference-showcase__heading > p:last-child {
    max-width: 720px;
    margin: 0;
    color: rgba(238, 241, 239, 0.8);
    font-size: clamp(1rem, 1.4vw, 1.14rem);
    line-height: 1.7;
  }

  .reference-showcase__actions {
    display: flex;
    align-items: flex-end;
  }

  .reference-showcase__all {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 50px;
    padding: 12px 18px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    color: #eef1ef;
    background: rgba(40, 46, 41, 0.28);
    font-weight: 800;
    white-space: nowrap;
    transition: color 220ms ease, border-color 220ms ease, background-color 220ms ease, transform 220ms ease;
  }

  .reference-showcase__all span { color: #8fc025; transition: transform 220ms ease; }
  .reference-showcase__all:hover { color: #ffffff; border-color: #8fc025; background: rgba(40, 46, 41, 0.55); text-decoration: none !important; transform: translateY(-2px); }
  .reference-showcase__all:hover span { transform: translateX(4px); }
  .reference-showcase__all:focus-visible { outline: 3px solid #8fc025; outline-offset: 4px; }

  .reference-showcase__cases {
    width: calc(100% - clamp(32px, 6vw, 96px));
    max-width: 1500px;
    margin-inline: auto;
    padding: 14px 0 clamp(88px, 9vw, 132px);
  }

  .featured-cases {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(18px, 2.4vw, 34px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .featured-cases__item { min-width: 0; }
  .featured-cases__item--primary { grid-column: 1 / -1; }

  .reference-showcase :global(.ref-card) {
    position: relative;
    display: grid;
    min-height: 0;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 26px;
    color: #eef1ef;
    background: rgba(40, 46, 41, 0.92);
    box-shadow: 0 28px 70px rgba(13, 24, 21, 0.28);
    transition: transform 240ms ease, border-color 240ms ease, box-shadow 240ms ease;
  }

  .featured-cases__item--primary :global(.ref-card) {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(320px, 0.55fr);
    min-height: 520px;
  }

  .featured-cases__item:not(.featured-cases__item--primary) :global(.ref-card) { display: flex; }
  .featured-cases__item:not(.featured-cases__item--primary) :global(.ref-content) {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-left: 0;
  }

  .reference-showcase :global(.ref-card)::before {
    content: "";
    position: absolute;
    z-index: 2;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, #2e6b6b, #4a6a85 68%, #8fc025);
    opacity: 0.5;
    transition: opacity 240ms ease;
  }

  .reference-showcase :global(.ref-card:hover),
  .reference-showcase :global(.ref-card:focus-visible) {
    transform: translateY(-3px);
    border-color: rgba(143, 192, 37, 0.48);
    box-shadow: 0 32px 76px rgba(13, 24, 21, 0.38);
  }

  .reference-showcase :global(.ref-card:hover)::before,
  .reference-showcase :global(.ref-card:focus-visible)::before { opacity: 1; }

  .reference-showcase :global(.ref-card:focus-visible) {
    outline: 3px solid #8fc025;
    outline-offset: 4px;
  }

  .reference-showcase :global(.ref-card img) {
    width: 100%;
    height: auto;
    min-height: 0;
    aspect-ratio: 16 / 9;
    border-bottom: 0;
    object-fit: cover;
    transition: transform 420ms cubic-bezier(0.2, 0.7, 0.2, 1), filter 240ms ease;
    filter: saturate(0.92) contrast(1.02);
  }

  .featured-cases__item--primary :global(.ref-card img) { height: 100%; aspect-ratio: auto; }

  .reference-showcase :global(.ref-card:hover img),
  .reference-showcase :global(.ref-card:focus-visible img) { transform: scale(1.025); filter: saturate(1) contrast(1.04); }

  .reference-showcase :global(.ref-content) {
    position: relative;
    z-index: 2;
    min-width: 0;
    box-sizing: border-box;
    justify-content: center;
    padding-block: clamp(30px, 4vw, 46px);
    padding-inline: clamp(28px, 3vw, 44px);
    border-top: 0;
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    background: linear-gradient(155deg, rgba(40, 46, 41, 0.97), rgba(46, 70, 63, 0.96));
  }

  .reference-showcase :global(.ref-meta) {
    margin-bottom: 13px;
    color: #8fc025;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .reference-showcase :global(.ref-content h3) {
    max-width: 100%;
    margin-bottom: 13px;
    color: #ffffff;
    font-size: clamp(1.45rem, 1.75vw, 1.9rem);
    line-height: 1.22;
    overflow-wrap: break-word;
    text-wrap: balance;
    transition: color 220ms ease;
  }

  .reference-showcase :global(.ref-card:hover h3),
  .reference-showcase :global(.ref-card:focus-visible h3) { color: #ffffff; }

  .reference-showcase :global(.ref-content p) {
    margin-bottom: 22px;
    color: rgba(238, 241, 239, 0.76);
    font-size: 0.96rem;
    line-height: 1.62;
  }

  .reference-showcase :global(.ref-pills) { gap: 7px; margin-bottom: 24px; }
  .reference-showcase :global(.ref-pills li:nth-child(n + 4)) { display: none; }

  .reference-showcase :global(.ref-pills li) {
    border: 1px solid rgba(230, 232, 230, 0.16);
    background: rgba(74, 106, 133, 0.18);
    color: #e6e8e6;
    font-size: 0.7rem;
    font-weight: 700;
  }

  .reference-showcase :global(.ref-cta) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: auto;
    padding-top: 18px;
    border-top: 1px solid rgba(230, 232, 230, 0.13);
    color: #8fc025;
    font-weight: 800;
  }

  .reference-showcase :global(.ref-cta)::after {
    content: "→";
    color: #8fc025;
    font-size: 1.12rem;
    transition: transform 220ms ease;
  }

  .reference-showcase :global(.ref-card:hover .ref-cta)::after,
  .reference-showcase :global(.ref-card:focus-visible .ref-cta)::after { transform: translateX(5px); }

  .featured-cases__item--primary :global(.ref-content h3) { font-size: clamp(1.8rem, 2.6vw, 2.65rem); }

  @media (max-width: 1000px) {
    .featured-cases__item--primary :global(.ref-card) { grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr); }
  }

  @media (max-width: 820px) {
    .featured-cases { grid-template-columns: 1fr; }
    .featured-cases__item--primary { grid-column: auto; }
    .featured-cases__item--primary :global(.ref-card),
    .reference-showcase :global(.ref-card) { display: flex; min-height: 0; }
    .featured-cases__item--primary :global(.ref-card img),
    .reference-showcase :global(.ref-card img) { height: auto; min-height: 0; aspect-ratio: 16 / 9; }
    .reference-showcase :global(.ref-content) { border-top: 1px solid rgba(255, 255, 255, 0.1); border-left: 0; }
  }

  @media (max-width: 700px) {
    .reference-showcase__intro { grid-template-columns: 1fr; gap: 28px; align-items: start; padding-top: 64px; padding-bottom: 28px; }
    .reference-showcase__actions { width: 100%; align-items: flex-start; }
    .reference-showcase__cases { width: calc(100% - 32px); padding-top: 8px; padding-bottom: 72px; }
    .featured-cases { gap: 18px; }
    .reference-showcase h2 { font-size: clamp(2.35rem, 11vw, 3.25rem); }
    .reference-showcase__all { min-height: 52px; }
    .reference-showcase :global(.ref-card) { border-radius: 20px; }
    .reference-showcase :global(.ref-content) { padding: 26px 22px 24px; }
    .reference-showcase :global(.ref-content h3) { font-size: 1.45rem; }
  }

