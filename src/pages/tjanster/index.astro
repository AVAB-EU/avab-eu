---
import ContentSection from "../../components/ContentSection.astro";
import PageCTA from "../../components/PageCTA.astro";
import ReferenceCard from "../../components/ReferenceCard.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { environments, references, technologies } from "../../data/referenser";
import "../../styles/avab.css";

const services = [
  { group: "Ljud & kommunikation", title: "Ljudsystem", text: "Ljudlösningar för tydligt tal, musik och utrop i professionella miljöer.", href: "/tjanster/ljudsystem/" },
  { group: "Ljud & kommunikation", title: "Mikrofoner", text: "Rätt mikrofonlösning för möten, undervisning, träning och scen.", href: "/tjanster/mikrofoner/" },
  { group: "Ljud & kommunikation", title: "Taluppfattbarhet", text: "Mätning och projektering som gör tal tydligt där det behöver nå fram.", href: "/tjanster/taluppfattbarhet/" },
  { group: "Tillgänglighet & information", title: "Hörslinga", text: "Tillgängligt och direkt ljud för personer som använder hörapparat.", href: "/tjanster/horslinga/" },
  { group: "Tillgänglighet & information", title: "Rastsignal", text: "Tydliga, zonindelade signaler som skapar struktur i skolans vardag.", href: "/rastsignal/" },
  { group: "Säkerhet", title: "Talat utrymningslarm", text: "Tydliga röstmeddelanden för säker och vägledande utrymning.", href: "/tjanster/talat-utrymningslarm/" },
  { group: "Säkerhet", title: "Kameraövervakning", text: "Kameror, lagring och sökfunktioner anpassade efter platsens behov.", href: "/tjanster/kameraovervakning/" },
  { group: "Upplevelse & kontroll", title: "Bakgrundsmusik", text: "Jämn ljudtäckning och enkel zonstyrning för rätt atmosfär.", href: "/tjanster/bakgrundsmusik/" },
  { group: "Upplevelse & kontroll", title: "Styrsystem & integration", text: "Samlad och användarvänlig styrning av ljud, bild, ljus och säkerhet.", href: "/tjanster/styrsystem-integration/" },
];

const deliverySteps = [
  { title: "Projektering", href: "/tjanster/projektering/" },
  { title: "Installation", href: "/tjanster/installation/" },
  { title: "Driftsättning", href: "/tjanster/driftsattning/" },
  { title: "Certifiering", href: "/tjanster/certifiering/" },
  { title: "Överlämning", href: "/tjanster/overlamning/" },
  { title: "Garanti & service", href: "/tjanster/garanti-och-service/" },
];

const featuredReferences = references.filter((reference) => reference.featured).slice(0, 3);
const pageTitle = "AV-tjänster för ljud, bild, säkerhet och styrning | AVAB";
const pageDescription = "Översikt över AVAB:s tjänster inom ljud, kommunikation, tillgänglighet, säkerhet, bakgrundsmusik och styrsystem.";
const canonical = "https://avab.eu/tjanster/";
const socialImage = "https://avab.eu/assets/tjanster-hero-integrerad-av-teknik.webp";
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Start", item: "https://avab.eu/" },
    { "@type": "ListItem", position: 2, name: "Tjänster", item: canonical },
  ],
};
---

<!DOCTYPE html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#282E29" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="AV-projektering med ritningar och tekniskt underlag" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:site_name" content="AVAB" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </head>
  <body>
    <SiteHeader />
    <main id="main">
      <header class="service-overview-hero">
        <div class="avab-container service-overview-hero__inner">
          <h1>Tjänster</h1>
          <p>Ljud, bild, säkerhet och styrning – från projektering till färdig anläggning.</p>
          <a class="button button-primary" href="/kontakt/">Kontakta oss</a>
        </div>
      </header>

      <ContentSection labelledby="service-directory-title">
        <div class="service-overview-heading">
          <p class="eyebrow">Våra tjänster</p>
          <h2 id="service-directory-title">Hitta rätt lösning</h2>
        </div>
        <div class="service-card-grid">
          {services.map((service) => (
            <a class="service-card" href={service.href}>
              <span class="service-card__body"><span class="service-card__group">{service.group}</span><strong>{service.title}</strong><span>{service.text}</span></span>
              <span class="service-card__cta">Läs mer <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </ContentSection>

      <ContentSection surface="soft" labelledby="delivery-title">
        <div class="delivery-overview">
          <div class="delivery-overview__intro">
            <p class="eyebrow">Vår leverans</p>
            <h2 id="delivery-title">Från idé till fungerande anläggning</h2>
            <p>AVAB kan hjälpa genom hela leveransen – från planering och installation till överlämning och långsiktig service.</p>
          </div>
          <ul class="delivery-links">
            {deliverySteps.map((step) => <li><a href={step.href}>{step.title}<span aria-hidden="true">→</span></a></li>)}
          </ul>
        </div>
      </ContentSection>

      <ContentSection labelledby="service-references-title">
        <div class="service-overview-heading service-overview-heading--split">
          <div><p class="eyebrow">Referenser</p><h2 id="service-references-title">Tjänster i verkliga projekt</h2></div>
          <a class="button button-secondary" href="/referenser/">Se alla referenser</a>
        </div>
        <div class="ref-grid">
          {featuredReferences.map((reference) => <ReferenceCard reference={reference} environments={environments} technologies={technologies} />)}
        </div>
      </ContentSection>

      <PageCTA flush title="Osäker på vilken lösning ni behöver?" text="Berätta vad ni vill lösa så hjälper vi er vidare." primaryLabel="Kontakta AVAB" primaryHref="/kontakt/" />
    </main>
    <SiteFooter />
  </body>
</html>
