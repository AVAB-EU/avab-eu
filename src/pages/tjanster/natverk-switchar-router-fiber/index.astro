---
import { getCollection } from "astro:content";
import ServiceLandingPage from "../../../layouts/ServiceLandingPage.astro";

const page = (await getCollection("serviceLandingPages")).find(
  (entry) => entry.data.slug === "/tjanster/natverk-switchar-router-fiber/",
);

if (!page) throw new Error("Tjänstesidan för nätverk, switchar & fiber saknas.");
---

<ServiceLandingPage page={page} />
