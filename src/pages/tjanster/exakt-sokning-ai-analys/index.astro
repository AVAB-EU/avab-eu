---
import { getCollection } from "astro:content";
import ServiceLandingPage from "../../../layouts/ServiceLandingPage.astro";

const page = (await getCollection("serviceLandingPages")).find(
  (entry) => entry.data.slug === "/tjanster/exakt-sokning-ai-analys/",
);

if (!page) throw new Error("Tjänstesidan för exakt sökning & AI-analys saknas.");
---

<ServiceLandingPage page={page} />
