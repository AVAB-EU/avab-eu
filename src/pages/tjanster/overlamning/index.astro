---
import { AVAB_PHONE } from "../../../config/site";
import SiteFooter from "../../../components/SiteFooter.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import PageCTA from "../../../components/PageCTA.astro";
import "../../../styles/avab.css";

const heroImage = "/assets/Overlamning-saffle-hero.webp";
---

<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Överlämning av AV-system, dokumentation och användarstöd | AVAB</title>
  <meta name="description" content="AVAB hjälper till med överlämning av AV-system med dokumentation, funktionsgenomgång, användarstöd, protokoll och tydliga kontaktvägar för fortsatt drift och service." />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="canonical" href="https://avab.eu/tjanster/overlamning/" />
  <meta name="theme-color" content="#282E29" />
  <link rel="preload" as="image" href={heroImage} fetchpriority="high" />
  <meta property="og:title" content="Överlämning av AV-system, dokumentation och användarstöd | AVAB" />
  <meta property="og:description" content="AVAB hjälper till med överlämning av AV-system med dokumentation, funktionsgenomgång, användarstöd, protokoll och tydliga kontaktvägar för fortsatt drift och service." />
  <meta property="og:url" content="https://avab.eu/tjanster/overlamning/" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="sv_SE" />
  <meta property="og:site_name" content="AVAB" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="Överlämning av AV-system, dokumentation och användarstöd | AVAB" />
  <meta name="twitter:description" content="AVAB hjälper till med överlämning av AV-system med dokumentation, funktionsgenomgång, användarstöd, protokoll och tydliga kontaktvägar för fortsatt drift och service." />
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Överlämning av AV-system med dokumentation och användarstöd",
  "provider": {
    "@type": "Organization",
    "name": "AVAB",
    "url": "https://avab.eu/"
  },
  "areaServed": "Sverige",
  "url": "https://avab.eu/tjanster/overlamning/",
  "description": "AVAB hjälper till med överlämning av AV-system med dokumentation, funktionsgenomgång, användarstöd, protokoll och tydliga kontaktvägar för fortsatt drift och service."
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Start",
      "item": "https://avab.eu/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Överlämning",
      "item": "https://avab.eu/tjanster/overlamning/"
    }
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Vad ingår i en överlämning av AV-system?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Överlämningen anpassas efter projektet och kan omfatta funktionsgenomgång, relevant dokumentation, märkning, protokoll och information om fortsatt support och service."
      }
    },
    {
      "@type": "Question",
      "name": "Får personalen en genomgång av systemet?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. AVAB går igenom hur systemet används i vardagen och vilka funktioner användaren själv ska hantera."
      }
    },
    {
      "@type": "Question",
      "name": "Ingår dokumentation vid överlämning?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Relevant dokumentation bör följa med anläggningen. Omfattningen beror på systemet och projektet men kan omfatta funktion, zoner, utrustning, märkning och protokoll."
      }
    },
    {
      "@type": "Question",
      "name": "Vad händer om något behöver justeras efter överlämningen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Om något behöver justeras eller felsökas efter överlämningen kan AVAB hjälpa vidare med support, service och fortsatt utveckling av systemet."
      }
    },
    {
      "@type": "Question",
      "name": "Kan överlämningen göras tillsammans med driftorganisationen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Det är ofta värdefullt att den som ska ansvara för den dagliga driften deltar i genomgången och får relevant information om systemets funktion."
      }
    }
  ]
}
</script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <SiteHeader />

  <nav class="breadcrumbs" aria-label="Brödsmulor">
    <div class="avab-container">
      <ol>
        <li><a href="/">Start</a></li>
        <li><span aria-current="page">Överlämning</span></li>
      </ol>
    </div>
  </nav>

  <main id="main">
    <section class="hero" style={`--hero-image: url('${heroImage}');`}>
      <div class="avab-container">
        <div class="hero-inner animate-in">
          <div class="eyebrow">Vår leverans · Överlämning</div>
          <h1>Överlämning som gör AV-systemet begripligt efter projektet</h1>
          <p class="lead">När installation, driftsättning och verifiering är klar ska anläggningen lämnas över till dem som faktiskt ska använda och förvalta den. AVAB samlar relevant dokumentation, går igenom funktionerna och skapar en tydlig övergång från projekt till daglig drift.</p>
          <div class="hero-bottom">
            <div class="hero-actions">
              <a class="button button-primary" href={AVAB_PHONE.main.href}>Ring {AVAB_PHONE.main.display}</a>
              <a class="button button-secondary" href="#snabba-svar">Snabba svar</a>
              <a class="button button-quiet" href="#var-leverans">Se hela leveransen</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="fact-band" aria-label="Snabbfakta">
      <div class="fact-grid">
        <div class="fact"><span>Leveranssteg</span><strong>Överlämning till användare och drift</strong></div>
        <div class="fact"><span>Underlag</span><strong>Relevant dokumentation och protokoll</strong></div>
        <div class="fact"><span>Genomgång</span><strong>Funktion, användning och viktiga inställningar</strong></div>
        <div class="fact"><span>Fokus</span><strong>Tydlig övergång från projekt till vardag</strong></div>
        <div class="fact"><span>Mottagare</span><strong>Beställare, verksamhet och drift</strong></div>
        <div class="fact"><span>Efteråt</span><strong>Support, service och fortsatt utveckling</strong></div>
      </div>
    </section>

    <section class="section section--light" id="snabba-svar">
      <div class="avab-container">
        <div class="section-heading">
          <div>
            <div class="eyebrow">Kort svar</div>
            <h2>Det viktigaste om överlämning</h2>
            <p class="lead-dark">Tydliga svar för beställare, fastighetsägare, projektledare, driftorganisation och verksamhetsansvariga.</p>
          </div>
        </div>
        <div class="value-grid">
          <article class="value-card">
            <h3>Vad är en bra överlämning?</h3>
            <p>Den gör det tydligt vad som är installerat, hur systemet används, vilken dokumentation som finns och vem kunden kontaktar när något behöver justeras eller servas.</p>
          </article>
          <article class="value-card">
            <h3>Vilken dokumentation behövs?</h3>
            <p>Det beror på systemet och projektet. Relevant underlag kan omfatta funktion, utrustning, zoner, märkning, protokoll och information som behövs för framtida felsökning och service.</p>
          </article>
          <article class="value-card">
            <h3>Behöver användarna utbildning?</h3>
            <p>De behöver åtminstone förstå de funktioner de ska använda i vardagen. AVAB går igenom systemets viktigaste flöden och visar vad användaren själv kan hantera.</p>
          </article>
          <article class="value-card">
            <h3>Vad händer efter överlämningen?</h3>
            <p>Anläggningen går över i normal drift. Vid behov kan AVAB hjälpa vidare med support, felsökning, garantiärenden, service och framtida förändringar.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- Bildförslag: Egen projektbild kopplad till avsnittet "Från färdig teknik till fungerande vardag". Lägg bilden i /assets/ när ett fast filnamn finns. -->
    <section class="section section--light">
      <div class="avab-container two-col">
        <div>
          <div class="eyebrow">Överlämning</div>
          <h2>Från färdig teknik till fungerande vardag</h2>
          <p>Ett AV-system kan vara korrekt installerat och driftsatt men ändå bli svårt att förvalta om den som tar över inte vet hur det är uppbyggt. Därför behöver projektet avslutas på ett sätt som fungerar även när installatören inte står kvar i rummet.</p>
          <p>AVAB går igenom anläggningens funktion, de viktigaste användarflödena och det underlag som hör till leveransen. Målet är att verksamhet och drift ska förstå systemet tillräckligt väl för att använda det rätt och veta när AVAB behöver kopplas in.</p>
        </div>
        <aside class="card">
          <h3>Det här ingår</h3>
          <ul class="bullet-list">
            <li>Funktionsgenomgång</li>
            <li>Genomgång med användare och drift</li>
            <li>Relevant dokumentation</li>
            <li>Märkning och systemöversikt</li>
            <li>Protokoll där sådana ingår</li>
            <li>Kontaktväg för fortsatt support</li>
          </ul>
        </aside>
      </div>
    </section>

    <!-- Bildförslag: Egen projektbild kopplad till avsnittet "Dokumentation som går att använda senare". Lägg bilden i /assets/ när ett fast filnamn finns. -->
    <section class="section">
      <div class="avab-container two-col">
        <div>
          <div class="eyebrow">Överlämning</div>
          <h2>Dokumentation som går att använda senare</h2>
          <p>Dokumentation har störst värde när den går att använda vid felsökning, service och framtida förändringar. Därför behöver det vara tydligt vad systemet gör, hur viktiga delar hänger ihop och vilka inställningar eller funktioner som är centrala för driften.</p>
          <p>Vid överlämningen samlas relevant material från projektet så att kunden inte behöver börja om när en anläggning ska justeras, byggas ut eller felsökas längre fram.</p>
        </div>
        <aside class="card">
          <h3>Det här ingår</h3>
          <ul class="bullet-list">
            <li>Strukturerat underlag för anläggningen</li>
            <li>Tydlig information om funktion och zoner</li>
            <li>Underlag från mätning och verifiering där relevant</li>
            <li>Information för framtida service</li>
            <li>Genomgång av viktiga användarflöden</li>
            <li>Tydlig övergång till fortsatt drift</li>
          </ul>
        </aside>
      </div>
    </section>

    <section class="section section--light" id="var-leverans">
      <div class="avab-container">
        <div class="section-heading">
          <div>
            <div class="eyebrow">Vår leverans</div>
            <h2>Från tidiga beslut till långsiktig drift</h2>
            <p class="lead-dark">AVAB kan hjälpa till med en enskild del eller följa projektet genom hela kedjan: projektering, installation, driftsättning, certifiering, överlämning och service.</p>
          </div>
        </div>

        <div class="grid-3">
          <a class="card" href="/tjanster/projektering/"><h3>Projektering</h3><p>Behov, ritningar, funktion, systemprincip och tydlig omfattning före installation.</p></a>
          <a class="card" href="/tjanster/installation/"><h3>Installation</h3><p>Montage, kablage, rack, inkoppling och samordning i verkliga projekt.</p></a>
          <a class="card" href="/tjanster/driftsattning/"><h3>Driftsättning</h3><p>Programmering, test, injustering och kontroll av systemets funktion.</p></a>
          <a class="card" href="/tjanster/certifiering/"><h3>Certifiering</h3><p>Mätning, verifiering, protokoll och samordning mot relevanta krav.</p></a>
          <article class="card card--current" aria-current="page"><h3>Överlämning</h3><p>Dokumentation, funktionsgenomgång och en tydlig övergång till användare och drift.</p></article>
          <a class="card" href="/tjanster/garanti-och-service/"><h3>Service &amp; garanti</h3><p>Felsökning, support, garantiärenden, underhåll och fortsatt utveckling.</p></a>
        </div>
      </div>
    </section>

    <section class="section" id="faq">
      <div class="avab-container">
        <div class="faq-heading">
          <div class="eyebrow">Vanliga frågor</div>
          <h2>Frågor om överlämning</h2>
          <p>Korta svar på sådant som ofta behöver klargöras när ett AV-projekt går över i drift.</p>
        </div>
        <div class="compact-faq">
          <details class="faq-item">
            <summary>Vad ingår i en överlämning av AV-system?</summary>
            <p>Överlämningen anpassas efter projektet och kan omfatta funktionsgenomgång, relevant dokumentation, märkning, protokoll och information om fortsatt support och service.</p>
          </details>
          <details class="faq-item">
            <summary>Får personalen en genomgång av systemet?</summary>
            <p>Ja. AVAB går igenom hur systemet används i vardagen och vilka funktioner användaren själv ska hantera.</p>
          </details>
          <details class="faq-item">
            <summary>Ingår dokumentation vid överlämning?</summary>
            <p>Relevant dokumentation bör följa med anläggningen. Omfattningen beror på systemet och projektet men kan omfatta funktion, zoner, utrustning, märkning och protokoll.</p>
          </details>
          <details class="faq-item">
            <summary>Vad händer om något behöver justeras efter överlämningen?</summary>
            <p>Om något behöver justeras eller felsökas efter överlämningen kan AVAB hjälpa vidare med support, service och fortsatt utveckling av systemet.</p>
          </details>
          <details class="faq-item">
            <summary>Kan överlämningen göras tillsammans med driftorganisationen?</summary>
            <p>Ja. Det är ofta värdefullt att den som ska ansvara för den dagliga driften deltar i genomgången och får relevant information om systemets funktion.</p>
          </details>
        </div>
      </div>
    </section>

    <PageCTA
      eyebrow="Nästa steg"
      title="Se till att AV-systemet är tydligt även efter projektet"
      text="AVAB hjälper till att samla överlämningen, gå igenom systemets viktigaste funktioner och ge verksamhet och drift rätt underlag för att ta över anläggningen."
      primaryLabel="Kontakta AVAB"
      primaryHref="/kontakt/"
      secondaryLabel="Ring 054-8202080"
      secondaryHref={AVAB_PHONE.main.href}
      points={[
        "Funktionsgenomgång med användare och drift",
        "Relevant dokumentation och protokoll",
        "Tydlig information för framtida service",
        "Övergång från projekt till normal drift",
      ]}
    />
  </main>

  <SiteFooter />
</body>
</html>
