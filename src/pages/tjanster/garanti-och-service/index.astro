---
import SiteFooter from "../../../components/SiteFooter.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import PageCTA from "../../../components/PageCTA.astro";
import "../../../styles/avab.css";

const heroImage = "/assets/Garanti-och-service-hero.webp";
---

<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Service och garanti för AV-system, ljud och styrning | AVAB</title>
  <meta name="description" content="AVAB erbjuder service, felsökning, support, garantiärenden och underhåll av ljudsystem, styrsystem, konferensteknik, kamera, hörslinga och AV-anläggningar." />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="canonical" href="https://www.avab.eu/tjanster/garanti-och-service/" />
  <meta name="theme-color" content="#282E29" />
  <link rel="preload" as="image" href={heroImage} fetchpriority="high" />
  <meta property="og:title" content="Service och garanti för AV-system, ljud och styrning | AVAB" />
  <meta property="og:description" content="AVAB erbjuder service, felsökning, support, garantiärenden och underhåll av ljudsystem, styrsystem, konferensteknik, kamera, hörslinga och AV-anläggningar." />
  <meta property="og:url" content="https://www.avab.eu/tjanster/garanti-och-service/" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="sv_SE" />
  <meta property="og:site_name" content="AVAB" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="Service och garanti för AV-system, ljud och styrning | AVAB" />
  <meta name="twitter:description" content="AVAB erbjuder service, felsökning, support, garantiärenden och underhåll av ljudsystem, styrsystem, konferensteknik, kamera, hörslinga och AV-anläggningar." />
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Service och garanti som håller AV-systemet igång",
  "provider": {
    "@type": "Organization",
    "name": "AVAB",
    "url": "https://www.avab.eu/"
  },
  "areaServed": "Sverige",
  "url": "https://www.avab.eu/tjanster/garanti-och-service/",
  "description": "AVAB erbjuder service, felsökning, support, garantiärenden och underhåll av ljudsystem, styrsystem, konferensteknik, kamera, hörslinga och AV-anläggningar."
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Start",
      "item": "https://www.avab.eu/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Service & garanti",
      "item": "https://www.avab.eu/tjanster/garanti-och-service/"
    }
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Kan ni serva system ni inte installerat?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ofta ja. Vi behöver först dokumentera vad som finns och hur systemet är uppbyggt."
      }
    },
    {
      "@type": "Question",
      "name": "Kan ni hjälpa akut?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja, i mån av tid. För verksamhetskritiska system är serviceavtal bäst om man vill ha tydligare prioritet."
      }
    },
    {
      "@type": "Question",
      "name": "Kan ni fjärrsupporta AV-system?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja, om systemet är byggt för fjärråtkomst eller kunden kan ge säker tillgång."
      }
    },
    {
      "@type": "Question",
      "name": "Ingår garanti på installation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Garanti beror på produkt, installation, avtal och felets orsak. AVAB hjälper till att reda ut vad som gäller."
      }
    },
    {
      "@type": "Question",
      "name": "Kan ni göra en årlig genomgång?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Vi kan kontrollera funktion, uppdateringar, ljudnivåer, styrning, kamera, hörslinga och dokumentation."
      }
    }
  ]
}
</script>
</head>
<body>
  <SiteHeader />

  <nav class="breadcrumbs" aria-label="Brödsmulor">
    <div class="avab-container">
      <ol>
        <li><a href="/">Start</a></li>
        <li><span aria-current="page">Service &amp; garanti</span></li>
      </ol>
    </div>
  </nav>

  <main id="main">
    <section class="hero" style={`--hero-image: url('${heroImage}');`}>
      <div class="avab-container">
        <div class="hero-inner animate-in">
          <div class="eyebrow">Vår leverans · Service och garanti</div>
          <h1>Service och garanti som håller AV-systemet igång</h1>
          <p class="lead">AV-teknik ska inte sluta vara viktig när installationen är klar. AVAB hjälper med service, felsökning, support, garantiärenden, uppgraderingar och förebyggande underhåll så att ljud, bild, styrning och kamera fortsätter fungera i vardagen.</p>
          <div class="hero-bottom">
            <div class="hero-actions">
              <a class="button button-primary" href="tel:+46548202080">Ring 054-8202080</a>
              <a class="button button-secondary" href="#snabba-svar">Snabba svar</a>
              <a class="button button-quiet" href="#var-leverans">Se hela leveransen</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="fact-band" aria-label="Snabbfakta">
      <div class="fact-grid">
        <div class="fact"><span>Leveranssteg</span><strong>Service och garanti</strong></div>
        <div class="fact"><span>Gäller</span><strong>Nya och befintliga AV-system</strong></div>
        <div class="fact"><span>Teknik</span><strong>Ljud, bild, styrning, kamera och hörslinga</strong></div>
        <div class="fact"><span>Support</span><strong>Fjärr, platsbesök och felsökning</strong></div>
        <div class="fact"><span>Fokus</span><strong>Snabb återgång till drift</strong></div>
        <div class="fact"><span>Förebyggande</span><strong>Genomgång, uppdatering och dokumentation</strong></div>
      </div>
    </section>

    <section class="section section--light" id="snabba-svar">
      <div class="avab-container">
        <div class="section-heading">
          <div>
            <div class="eyebrow">Kort svar</div>
            <h2>Det viktigaste om service &amp; garanti</h2>
            <p class="lead-dark">Tydliga svar för beställare, fastighetsägare, projektledare, elektriker och verksamhetsansvariga.</p>
          </div>
        </div>
        <div class="value-grid value-grid--service-answers">
          <article class="value-card">
            <h3>Vad ingår i AV-service?</h3>
            <p>Felsökning, justering, uppdatering, byte av utrustning, kontroll av kablage och zoner, ljudinjustering och support till personal.</p>
          </article>
          <article class="value-card">
            <h3>Kan AVAB hjälpa med äldre system?</h3>
            <p>Ja. Vi kan felsöka och uppgradera äldre ljudsystem, konferensrum, styrsystem, hörslingor och kamerainstallationer även när allt inte är levererat av AVAB.</p>
          </article>
          <article class="value-card">
            <h3>Vad händer vid ett garantiärende?</h3>
            <p>Vi felsöker, bedömer om felet ligger i produkt, installation, handhavande eller yttre påverkan och hanterar ärendet med leverantören när det är relevant.</p>
          </article>
          <article class="value-card">
            <h3>Varför behövs förebyggande service?</h3>
            <p>Många fel upptäcks först när lokalen ska användas. Förebyggande service minskar risken för driftstopp vid möten, matcher, skolstarter och evenemang.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- Bildförslag: Egen projektbild kopplad till avsnittet "Tekniken ska fungera när lokalen används". Lägg bilden i /assets/ när ett fast filnamn finns. -->
    <section class="section section--light">
      <div class="avab-container two-col">
        <div>
          <div class="eyebrow">Service och garanti</div>
          <h2>Tekniken ska fungera när lokalen används</h2>
          <p>Det är först när lokalen är full av människor som AV-tekniken verkligen prövas. Mikrofonen ska fungera vid mötet, högtalarna ska täcka hela hallen, projektorn ska starta när presentationen börjar och styrpanelen ska vara begriplig även för den som inte använder den varje dag.</p>
          <p>AVAB hjälper till när något har slutat fungera, men också med förebyggande åtgärder innan problemen blir akuta.</p>
        </div>
        <aside class="card">
          <h3>Det här ingår</h3>
          <ul class="bullet-list">
            <li>Felsökning på plats och distans</li>
            <li>Ljud, bild, styrning och kamera</li>
            <li>Kabel, nätverk och signalvägar</li>
            <li>Återställning av inställningar</li>
            <li>Reservdelar och produktbyte</li>
            <li>Uppgradering av äldre system</li>
          </ul>
        </aside>
      </div>
    </section>
    <!-- Bildförslag: Egen projektbild kopplad till avsnittet "Garantiärenden utan gissningar". Lägg bilden i /assets/ när ett fast filnamn finns. -->
    <section class="section">
      <div class="avab-container two-col">
        <div>
          <div class="eyebrow">Service och garanti</div>
          <h2>Garantiärenden utan gissningar</h2>
          <p>När teknik krånglar behöver man veta vad som faktiskt är fel. Är det en trasig produkt, felaktig inkoppling, ändrad nätverksmiljö, handhavande, fukt, värme, åska eller mekanisk påverkan?</p>
          <p>AVAB hjälper kunden att reda ut felet och hantera garantiärendet på rätt sätt. Om produkten omfattas av garanti samordnar vi med leverantör. Om felet ligger utanför garanti föreslår vi åtgärd, utbyte eller uppgradering.</p>
        </div>
        <aside class="card">
          <h3>Det här ingår</h3>
          <ul class="bullet-list">
            <li>Felanalyser innan produktbyte</li>
            <li>Dokumenterad ärendehantering</li>
            <li>Kontakt med leverantör</li>
            <li>Prioriterad driftåterställning</li>
            <li>Plan för ersättningsprodukt</li>
            <li>Förebyggande serviceavtal</li>
          </ul>
        </aside>
      </div>
    </section>

    <section class="section section--light" id="var-leverans">
      <div class="avab-container">
        <div class="section-heading">
          <div>
            <div class="eyebrow">Vår leverans</div>
            <h2>Från tidiga beslut till långsiktig drift</h2>
            <p class="lead-dark">AVAB kan hjälpa till med en enskild del eller följa projektet genom hela kedjan: projektering, installation, driftsättning, certifiering, överlämning och service.</p>
          </div>
        </div>

        <div class="grid-3">
          <a class="card" href="/tjanster/projektering/"><h3>Projektering</h3><p>Behov, ritningar, funktion, systemprincip och tydlig omfattning före installation.</p></a>
          <a class="card" href="/tjanster/installation/"><h3>Installation</h3><p>Montage, kablage, rack, inkoppling och samordning i verkliga projekt.</p></a>
          <a class="card" href="/tjanster/driftsattning/"><h3>Driftsättning</h3><p>Programmering, test, injustering, användarflöde och överlämning.</p></a>
          <a class="card" href="/tjanster/certifiering/"><h3>Certifiering</h3><p>Mätning, verifiering, protokoll och samordning mot relevanta krav.</p></a>
          <a class="card" href="/tjanster/overlamning/"><h3>Överlämning</h3><p>Dokumentation, utbildning och en tydlig väg från färdig anläggning till trygg användning.</p></a>
          <article class="card card--current" aria-current="page"><h3>Service &amp; garanti</h3><p>Felsökning, support, garantiärenden, underhåll och fortsatt utveckling.</p></article>
        </div>
      </div>
    </section>

    <section class="section" id="faq">
      <div class="avab-container">
        <div class="faq-heading">
          <div class="eyebrow">Vanliga frågor</div>
          <h2>Frågor om service &amp; garanti</h2>
          <p>Korta svar på sådant som ofta behöver klargöras före beställning.</p>
        </div>
        <div class="compact-faq">
          <details class="faq-item">
            <summary>Kan ni serva system ni inte installerat?</summary>
            <p>Ofta ja. Vi behöver först dokumentera vad som finns och hur systemet är uppbyggt.</p>
          </details>
          <details class="faq-item">
            <summary>Kan ni hjälpa akut?</summary>
            <p>Ja, i mån av tid. För verksamhetskritiska system är serviceavtal bäst om man vill ha tydligare prioritet.</p>
          </details>
          <details class="faq-item">
            <summary>Kan ni fjärrsupporta AV-system?</summary>
            <p>Ja, om systemet är byggt för fjärråtkomst eller kunden kan ge säker tillgång.</p>
          </details>
          <details class="faq-item">
            <summary>Ingår garanti på installation?</summary>
            <p>Garanti beror på produkt, installation, avtal och felets orsak. AVAB hjälper till att reda ut vad som gäller.</p>
          </details>
          <details class="faq-item">
            <summary>Kan ni göra en årlig genomgång?</summary>
            <p>Ja. Vi kan kontrollera funktion, uppdateringar, ljudnivåer, styrning, kamera, hörslinga och dokumentation.</p>
          </details>
        </div>
      </div>
    </section>

    <PageCTA
      eyebrow="Nästa steg"
      title="Vill ni minska risken för driftstopp?"
      text="Vi kan felsöka ett aktuellt problem, gå igenom en äldre anläggning eller föreslå ett serviceupplägg för lokaler där tekniken alltid måste fungera."
      primaryLabel="Ring 054-8202080"
      primaryHref="tel:+46548202080"
      secondaryLabel="Kontakta AVAB"
      secondaryHref="/kontakt/"
      points={[
        "Felsökning och återställning",
        "Garantiärenden och leverantörskontakt",
        "Förebyggande genomgång",
        "Serviceavtal och planerade uppgraderingar",
      ]}
    />
  </main>

  <SiteFooter />
</body>
</html>
